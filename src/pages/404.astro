---
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
---

<Base title="Halaman tidak ditemukan" description="Halaman tidak ditemukan." noindex>
  <section class="theme-dark relative isolate flex min-h-[100svh] items-center overflow-hidden bg-canvas pt-24">
    <div class="bg-grid mask-fade pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-content grid items-center gap-12 lg:grid-cols-2">
      <div>
        <Eyebrow>Error 404</Eyebrow>
        <h1 class="mt-6 text-hero">Sinyal terputus.</h1>
        <p class="mt-6 max-w-md text-lg text-body">
          Halaman yang Anda cari tidak ditemukan. Mungkin sudah dipindah atau alamatnya salah ketik.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href="/" size="lg" icon="lucide:house">Kembali ke beranda</Button>
          <Button href="/contact" variant="ghost" size="lg">Hubungi kami</Button>
        </div>
      </div>
      <svg viewBox="0 0 500 300" class="w-full" aria-hidden="true">
        <path d="M0 150 H170 L190 130" fill="none" stroke="#FFCE00" stroke-width="4" />
        <path d="M0 150 H170 L190 130" fill="none" stroke="#FFF3B0" stroke-width="4" class="flow-line" style="--flow-speed:3s" />
        <path d="M310 170 L330 150 H500" fill="none" stroke="rgba(255,255,255,.25)" stroke-width="4" />
        <g class="blink">
          <path d="M215 120 l-12 -20 M235 115 l0 -26 M255 120 l12 -20" stroke="#FFCE00" stroke-width="3" />
          <path d="M260 160 l-14 22 h12 l-6 24 l22 -32 h-12 z" fill="#FFCE00" />
        </g>
        <circle cx="190" cy="130" r="6" fill="#FFCE00" />
        <circle cx="310" cy="170" r="6" fill="none" stroke="rgba(255,255,255,.4)" stroke-width="2" />
      </svg>
    </div>
  </section>
</Base>
