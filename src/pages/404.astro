---
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
---

<Base title="Page Not Found" description="The page you are looking for could not be found." noindex>
  <Section bg="deep" size="lg" aria-label="Page not found">
    <p class="label-tech text-muted">404</p>
    <h1 class="mt-3 text-h1 text-white">Page not found</h1>
    <p class="mt-4 max-w-xl text-subtle">
      The page you are looking for may have been moved or never existed.
    </p>
    <Button href="/" size="lg" class="mt-8">Back to Home</Button>
  </Section>
</Base>
