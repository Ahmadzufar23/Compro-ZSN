---
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
---

<Base title="Halaman Tidak Ditemukan" description="Halaman yang Anda cari tidak ditemukan." noindex>
  <Section bg="ink" size="lg" blueprint aria-label="Halaman tidak ditemukan">
    <p class="label-tech text-yellow">404</p>
    <h1 class="mt-3 text-h1 text-white">Halaman Tidak Ditemukan</h1>
    <p class="mt-4 max-w-xl text-white/70">
      Halaman yang Anda cari mungkin sudah dipindahkan atau tidak pernah ada.
    </p>
    <Button href="/" size="lg" class="mt-8">Kembali ke Beranda</Button>
  </Section>
</Base>
