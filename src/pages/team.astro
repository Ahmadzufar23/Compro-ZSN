---
/**
 * Tim: anggota digerbang izinTampil (lihat content.config.ts). Saat
 * koleksi kosong, halaman menampilkan struktur divisi dan perannya.
 * Jumlah anggota tidak pernah ditampilkan.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import CtaFinal from '@/components/home/CtaFinal.astro';

const anggota = (await getCollection('tim')).sort((a, b) => a.data.urutan - b.data.urutan);

const divisi = [
  {
    key: 'manajemen',
    icon: 'lucide:compass',
    label: 'Manajemen',
    tugas: ['Rencana kerja dan estimasi biaya dari hasil survei', 'Penghubung utama klien selama proyek', 'Standar kualitas dan prosedur kerja'],
  },
  {
    key: 'instalasi',
    icon: 'lucide:hard-hat',
    label: 'Tim instalasi',
    tugas: ['Penarikan kabel fiber dan tembaga sesuai rute', 'Pemasangan bracket, rack, dan perangkat', 'Merapikan jalur dan melabeli titik'],
  },
  {
    key: 'teknis',
    icon: 'lucide:cpu',
    label: 'Teknis & konfigurasi',
    tugas: ['Fusion splicing dan terminasi konektor', 'Konfigurasi router, switch, AP, dan NVR', 'Uji OTDR dan pengukuran redaman'],
  },
  {
    key: 'operasional',
    icon: 'lucide:clipboard-list',
    label: 'Operasional & QC',
    tugas: ['Penjadwalan kunjungan dan koordinasi tim', 'Laporan uji dan dokumentasi as-built', 'Pemeriksaan kualitas sebelum serah terima'],
  },
];
---

<Base title="Tim" description="Struktur tim ZSN: manajemen, instalasi, teknis & konfigurasi, serta operasional & QC." noindex>
  <PageHero
    eyebrow="Tim"
    index="ZSN"
    judul='Orang-orang di balik <span class="text-fog">setiap jalur yang menyala.</span>'
    sub="Empat divisi yang bekerja berpasangan di lapangan: satu fokus memasang, satu fokus menguji dan menjaga keselamatan kerja."
    crumbs={[{ label: 'Beranda', href: '/' }, { label: 'Tim' }]}
  />

  <section class="bg-ink pb-24">
    <div class="container-content grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        divisi.map((d, i) => {
          const orang = anggota.filter((a) => a.data.divisi === d.key);
          return (
            <article class="bg-ink p-8" data-reveal style={`--d:${i * 80}ms`}>
              <Icon name={d.icon} class="size-8 text-volt" />
              <h2 class="mt-8 text-h3">{d.label}</h2>
              <ul class="mt-6 space-y-3">
                {d.tugas.map((t) => (
                  <li class="flex gap-3 text-sm text-fog">
                    <Icon name="lucide:zap" class="mt-0.5 size-4 shrink-0 text-volt" />
                    {t}
                  </li>
                ))}
              </ul>
              {orang.length > 0 && (
                <ul class="mt-8 space-y-4 border-t border-line pt-6">
                  {orang.map((o) => (
                    <li class="flex items-center gap-4">
                      <Image src={o.data.foto} alt={`Foto ${o.data.nama}`} width={96} height={96} class="size-12 rounded-full object-cover" />
                      <span>
                        <span class="block font-semibold text-snow">{o.data.nama}</span>
                        <span class="text-sm text-fog">{o.data.jabatan}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          );
        })
      }
    </div>
  </section>

  <CtaFinal judul="Ingin bertemu timnya langsung?" sub="Jadwalkan survei. Tim yang datang ke lokasi adalah tim yang nantinya mengerjakan proyek Anda." />
</Base>
