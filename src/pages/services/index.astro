---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import StackLayers from '@/components/home/StackLayers.astro';
import CtaFinal from '@/components/home/CtaFinal.astro';
import SoftwarePanel from '@/components/service/SoftwarePanel.astro';
import { services } from '@/config/services';

const semua = [...(await getCollection('layanan')), ...(await getCollection('produk'))];
const rows = services.map((s) => ({ ...s, data: semua.find((e) => e.id.endsWith(s.slug))?.data }));
---

<Base
  title="Layanan"
  description="Lima layanan ZSN: fiber optik & FTTH, infrastruktur jaringan, CCTV & keamanan, pemeliharaan & IT support, dan pengembangan perangkat lunak."
>
  <PageHero
    eyebrow="Layanan"
    judul="Lima layanan, satu tim yang mengerjakan."
    sub="Setiap layanan bisa dipesan terpisah. Bila digabung, satu tim yang sama menangani kabel, perangkat, dan software, sehingga koordinasinya lebih sederhana."
    crumbs={[{ label: 'Beranda', href: '/' }, { label: 'Layanan' }]}
  />

  <section class="bg-raised py-16 lg:py-24">
    <div class="container-content space-y-4">
      {
        rows.map((r, i) => (
          <a href={r.href} class="group relative grid overflow-hidden border border-strong bg-canvas transition-shadow hover:shadow-[8px_8px_0_0_var(--color-volt)] lg:grid-cols-12" data-reveal>
            <div class="relative flex flex-col justify-between gap-10 p-7 sm:p-10 lg:col-span-7">
              <div>
                <div class="flex items-center gap-4">
                  <span class="label-tech bg-volt px-2 py-1 text-ink">ZSN/{r.kode}</span>
                  <span class="h-px flex-1 bg-rule" />
                  <span class="label-tech text-soft">{r.lapisan}</span>
                </div>
                <h2 class="mt-8 text-h2">{r.label}</h2>
                <p class="mt-4 max-w-xl text-soft">{r.data?.ringkas}</p>
              </div>
              <div class="flex flex-wrap items-end justify-between gap-6">
                {r.data?.spesifikasi && (
                  <dl class="flex flex-wrap gap-x-8 gap-y-3">
                    {r.data.spesifikasi.slice(0, 3).map((s) => (
                      <div>
                        <dt class="label-tech text-[0.6rem] text-soft">{s.label}</dt>
                        <dd class="mt-1 text-sm font-semibold text-strong">{s.nilai}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                <span class="flex size-14 items-center justify-center bg-strong text-canvas transition-all duration-300 group-hover:rotate-45 group-hover:bg-volt group-hover:text-ink">
                  <Icon name="lucide:arrow-up" class="size-6" />
                </span>
              </div>
            </div>
            <div class="relative min-h-64 bg-ink lg:col-span-5">
              {r.data?.heroImage ? (
                <Image
                  src={r.data.heroImage}
                  alt={r.data.heroAlt ?? ''}
                  width={900}
                  widths={[480, 900]}
                  sizes="(min-width:1024px) 40vw, 100vw"
                  class="absolute inset-0 size-full object-cover transition duration-700 group-hover:scale-105"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              ) : (
                <div class="theme-dark flex h-full items-center p-7 sm:p-10">
                  <div class="w-full"><SoftwarePanel /></div>
                </div>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <StackLayers />
  <CtaFinal judul="Belum yakin butuh layanan yang mana?" sub="Ceritakan masalahnya. Saat survei, kami bantu menerjemahkannya menjadi lingkup kerja." label="Konsultasi Gratis" />
</Base>
