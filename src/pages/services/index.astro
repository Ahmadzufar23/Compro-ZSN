---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import StackLayers from '@/components/home/StackLayers.astro';
import CtaFinal from '@/components/home/CtaFinal.astro';
import SoftwarePanel from '@/components/service/SoftwarePanel.astro';
import { services } from '@/config/services';

const semua = [...(await getCollection('layanan')), ...(await getCollection('produk'))];
const rows = services.map((s) => ({ ...s, data: semua.find((e) => e.id.endsWith(s.slug))?.data }));
---

<Base
  title="Layanan"
  description="Lima lini layanan ZSN: fiber optik & FTTH, infrastruktur jaringan, CCTV & keamanan, pemeliharaan & IT support, dan pengembangan perangkat lunak."
>
  <PageHero
    eyebrow="Layanan"
    index="ZSN"
    judul='Lima lini kerja, <span class="text-fog">dari tanah sampai layar.</span>'
    sub="Setiap layanan bisa dipesan terpisah. Tetapi kekuatan kami ada di gabungannya: satu tim yang memahami kabel, perangkat, dan software sekaligus."
    crumbs={[{ label: 'Beranda', href: '/' }, { label: 'Layanan' }]}
  />

  <section class="bg-ink pb-24">
    <div class="container-content space-y-4">
      {
        rows.map((r, i) => (
          <a
            href={r.href}
            class="group relative grid overflow-hidden border border-line bg-carbon transition-colors hover:border-volt lg:grid-cols-12"
            data-reveal
          >
            <div class="relative flex flex-col justify-between gap-10 p-7 sm:p-10 lg:col-span-7">
              <div>
                <div class="flex items-center gap-4">
                  <span class="label-tech text-volt">ZSN/{r.kode}</span>
                  <span class="h-px flex-1 bg-line" />
                  <span class="label-tech text-fog">{r.lapisan}</span>
                </div>
                <h2 class="mt-8 text-h2">{r.label}</h2>
                <p class="mt-4 max-w-xl text-fog">{r.data?.ringkas}</p>
              </div>
              <div class="flex flex-wrap items-end justify-between gap-6">
                {r.data?.spesifikasi && (
                  <dl class="flex flex-wrap gap-x-8 gap-y-3">
                    {r.data.spesifikasi.slice(0, 3).map((s) => (
                      <div>
                        <dt class="label-tech text-[0.6rem] text-fog">{s.label}</dt>
                        <dd class="mt-1 text-sm font-semibold text-snow">{s.nilai}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                <span class="flex size-14 items-center justify-center bg-volt text-ink transition-transform duration-300 group-hover:rotate-45">
                  <Icon name="lucide:arrow-up" class="size-6" />
                </span>
              </div>
            </div>
            <div class="relative min-h-64 lg:col-span-5">
              {r.data?.heroImage ? (
                <>
                  <Image
                    src={r.data.heroImage}
                    alt={r.data.heroAlt ?? ''}
                    width={900}
                    widths={[480, 900]}
                    sizes="(min-width:1024px) 40vw, 100vw"
                    class="absolute inset-0 size-full object-cover grayscale-[40%] transition duration-700 group-hover:scale-105 group-hover:grayscale-0"
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                  <div class="absolute inset-0 bg-gradient-to-r from-carbon via-carbon/20 to-transparent max-lg:bg-gradient-to-t" />
                </>
              ) : (
                <div class="flex h-full items-center p-7 sm:p-10">
                  <div class="w-full"><SoftwarePanel /></div>
                </div>
              )}
              <span
                class="pointer-events-none absolute bottom-2 right-4 font-display text-8xl font-extrabold leading-none text-transparent"
                style="font-stretch:125%;-webkit-text-stroke:1px rgb(255 206 0 / .5)"
                aria-hidden="true"
              >
                {r.kode}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <StackLayers />
  <CtaFinal judul="Belum yakin butuh layanan yang mana?" sub="Ceritakan masalahnya saja. Kami yang menerjemahkannya jadi lingkup kerja saat survei." label="Konsultasi Gratis" />
</Base>
