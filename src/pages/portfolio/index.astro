---
/**
 * Listing project. Filter kategori butuh state per-request yang tidak
 * tersedia di situs static tanpa JavaScript — jadi alih-alih filter
 * interaktif, project dikelompokkan per kategori dengan heading
 * (izin eksplisit dari spec: "kalau butuh JS, lewati filter").
 *
 * Pengelompokan itu sendiri hanya masuk akal kalau tiap kategori
 * punya cukup isi. Di bawah AMBANG_KELOMPOK_KATEGORI, satu grid
 * gabungan lebih enak dilihat daripada beberapa section yang
 * masing-masing cuma berisi satu-dua kartu.
 */
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import ProjectCard from '@/components/project/ProjectCard.astro';

/**
 * Ambang jumlah total project sebelum listing dipecah per kategori.
 * Di bawah ini (mis. 3 project di 3 kategori berbeda), pengelompokan
 * membuat tiap section terlihat kosong — satu grid gabungan lebih baik.
 */
const AMBANG_KELOMPOK_KATEGORI = 9;

const kategoriInfo: Record<string, { label: string; slug: string }> = {
  fiber: { label: 'Fiber Optic & FTTH', slug: 'fiber-optic' },
  cctv: { label: 'CCTV & Security', slug: 'cctv' },
  network: { label: 'Network Infrastructure', slug: 'network' },
  maintenance: { label: 'Maintenance & IT Support', slug: 'maintenance' },
  software: { label: 'System Development', slug: 'software' },
};

const urutanKategori = ['fiber', 'cctv', 'network', 'maintenance', 'software'] as const;

const semua = await getCollection('project');
semua.sort((a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf());

const kelompokPerKategori = urutanKategori
  .map((kategori) => ({
    info: kategoriInfo[kategori],
    items: semua.filter((p) => p.data.kategori === kategori),
  }))
  .filter((k) => k.items.length > 0);

const tampilkanPerKategori = semua.length >= AMBANG_KELOMPOK_KATEGORI;
---

<Base
  title="Portfolio"
  description="Documentation of fiber optic, CCTV, network, and system installation projects completed by ZSN."
  noindex
>
  <Section bg="canvas" size="sm" aria-label="Portfolio Hero">
    <p class="label-tech text-muted">Portfolio</p>
    <h1 class="mt-3 text-h1">What we've built</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Field documentation of fiber optic, CCTV, network, and
      system projects completed by ZSN.
    </p>
  </Section>

  {
    semua.length === 0 && (
      <Section bg="surface" size="md" aria-label="No projects available">
        <p class="text-muted">Project documentation is being prepared and will be published here soon.</p>
      </Section>
    )
  }

  {
    semua.length > 0 && !tampilkanPerKategori && (
      <Section bg="surface" size="md" aria-label="All projects">
        <p class="label-tech text-muted">List</p>
        <h2 class="mt-3 text-h2">All projects</h2>

        <div class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2">
          {semua.map((project) => (
            <ProjectCard project={project} kategoriLabel={kategoriInfo[project.data.kategori].label} />
          ))}
        </div>

        <p class="mt-8 text-sm text-muted">
          Documentation for other projects is currently being prepared.
        </p>
      </Section>
    )
  }

  {
    tampilkanPerKategori &&
      kelompokPerKategori.map(({ info, items }, i) => (
        <Section bg={i % 2 === 0 ? 'canvas' : 'surface'} size="md" aria-label={`Project ${info.label}`}>
          <p class="label-tech text-muted">Category</p>
          <h2 class="mt-3 text-h2">{info.label}</h2>

          <div class="mt-8 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((project) => (
              <ProjectCard project={project} kategoriLabel={info.label} />
            ))}
          </div>
        </Section>
      ))
  }
</Base>
