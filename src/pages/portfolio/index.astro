---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import ProjectCard from '@/components/project/ProjectCard.astro';
import CtaFinal from '@/components/home/CtaFinal.astro';
import { kategoriLabel } from '@/config/project';

const semua = (await getCollection('project')).sort(
  (a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf()
);
const kategori = [...new Set(semua.map((p) => p.data.kategori))];
const lokasi = [...new Set(semua.map((p) => p.data.lokasi))];

/* Pola ukuran berselang supaya grid tidak seragam */
const span = (i: number) =>
  ['lg:col-span-7 lg:row-span-2', 'lg:col-span-5', 'lg:col-span-5', 'lg:col-span-4', 'lg:col-span-4', 'lg:col-span-4'][i % 6];
---

<Base
  title="Proyek"
  description="Dokumentasi proyek lapangan ZSN: instalasi FTTH, penyambungan fiber optik, CCTV, dan penataan jaringan di Jabodetabek."
>
  <PageHero
    eyebrow="Proyek"
    index="ZSN"
    judul='Dari lapangan, <span class="text-fog">dengan kode proyeknya.</span>'
    sub="Setiap pekerjaan diberi kode proyek dan didokumentasikan. Nama klien hanya ditampilkan bila sudah ada izin tertulis."
    crumbs={[{ label: 'Beranda', href: '/' }, { label: 'Proyek' }]}
  >
    <dl class="mt-12 flex flex-wrap gap-x-12 gap-y-6 border-t border-line pt-8">
      <div>
        <dt class="label-tech text-fog">Proyek terdokumentasi</dt>
        <dd class="mt-2 font-display text-3xl font-extrabold text-snow" style="font-stretch:115%">{semua.length}</dd>
      </div>
      <div>
        <dt class="label-tech text-fog">Kategori</dt>
        <dd class="mt-2 text-snow">{kategori.map((k) => kategoriLabel[k]).join(' · ')}</dd>
      </div>
      <div>
        <dt class="label-tech text-fog">Lokasi</dt>
        <dd class="mt-2 text-snow">{lokasi.map((l) => l.charAt(0) + l.slice(1).toLowerCase()).join(' · ')}</dd>
      </div>
    </dl>
  </PageHero>

  <section class="bg-ink pb-24">
    <div class="container-content grid auto-rows-[20rem] gap-4 sm:grid-cols-2 lg:grid-cols-12 lg:auto-rows-[16rem]">
      {
        semua.map((p, i) => (
          <ProjectCard
            entry={p}
            size={i % 6 === 0 ? 'lg' : 'md'}
            class:list={[i % 6 === 0 && 'sm:col-span-2', span(i)]}
            data-reveal
            style={`--d:${(i % 3) * 80}ms`}
          />
        ))
      }
    </div>
  </section>

  <CtaFinal judul="Proyek Anda berikutnya di sini?" />
</Base>
