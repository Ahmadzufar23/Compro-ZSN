---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import StatBand from '@/components/service/StatBand.astro';
import Gallery from '@/components/service/Gallery.astro';
import { waLink } from '@/config/site';

export async function getStaticPaths() {
  const project = await getCollection('project');
  return project.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const kategoriInfo: Record<string, { label: string; slug: string }> = {
  fiber: { label: 'Fiber Optic & FTTH', slug: 'fiber-optic' },
  cctv: { label: 'CCTV & Security', slug: 'cctv' },
  network: { label: 'Network Infrastructure', slug: 'network' },
  maintenance: { label: 'Maintenance & IT Support', slug: 'maintenance' },
  software: { label: 'System Development', slug: 'software' },
};
const info = kategoriInfo[data.kategori];

const stats = data.stats.map((s) => ({ angka: s.nilai, label: s.label }));
const waHref = waLink(`Hello ZSN, I would like to consult about a project similar to "${data.judul}".`);
---

<Base title={data.judul} description={data.ringkas} noindex>
  <Section bg="canvas" size="lg" aria-label="Project Hero">
    <p class="label-tech text-muted">
      <a href="/portfolio" class="hover:text-ink">Portfolio</a>
      <span class="mx-2 text-subtle">/</span>
      <span class="text-ink">{data.judul}</span>
    </p>

    <div class="mt-6 max-w-2xl">
      <h1 class="text-h1">{data.judul}</h1>
      <p class="label-tech mt-3 text-muted">{data.lokasi}</p>
    </div>

    <div class="relative mt-10 overflow-hidden" style="aspect-ratio: 21/9;">
      <Picture
        src={data.cover}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        alt={data.coverAlt}
        width={1600}
        height={686}
        loading="eager"
        fetchpriority="high"
        pictureAttributes={{ class: 'block size-full' }}
        class="size-full object-cover"
      />
      <span class="label-tech absolute right-4 top-4 bg-deep/80 px-2 py-1 text-white">
        {data.kodeProject}
      </span>
    </div>
  </Section>

  <StatBand stats={stats} />

  <Section bg="canvas" size="md" aria-label="Project story">
    <div class="prose-project mx-auto max-w-[65ch] text-muted">
      <Content />
    </div>
  </Section>

  {data.galeri && <Gallery items={data.galeri} />}

  <Section bg="surface" size="md" aria-label="Related services">
    <p class="label-tech text-muted">Related Services</p>
    <h2 class="mt-3 text-h2">Need similar work done?</h2>
    <p class="mt-3 max-w-prose text-muted">
      This project is part of our {info.label} service.
    </p>
    <Button href={`/services/${info.slug}`} variant="outline-dark" class="mt-6">
      View {info.label} Services
    </Button>
  </Section>

  <Section bg="deep" size="lg" aria-label="Call to action">
    <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-h2 text-white">Want a project like this?</h2>
        <p class="mt-4 text-subtle">
          Tell us about your location and requirements via WhatsApp, and our team will
          respond with a survey plan.
        </p>
      </div>
      <Button href={waHref} size="lg" external class="shrink-0">Consult via WhatsApp</Button>
    </div>
  </Section>
</Base>

<style>
  .prose-project :global(p) {
    margin-top: 1em;
  }
  .prose-project :global(p:first-child) {
    margin-top: 0;
  }
</style>
