---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '@/layouts/Base.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import ProjectCard from '@/components/project/ProjectCard.astro';
import CtaFinal from '@/components/home/CtaFinal.astro';
import { kategoriLabel, kategoriLayanan, projectSlug } from '@/config/project';

export async function getStaticPaths() {
  const project = await getCollection('project');
  return project.map((entry) => ({ params: { slug: projectSlug(entry.id) }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const layanan = kategoriLayanan[d.kategori];
const tanggal = d.tanggal.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
const hasBody = !!entry.body?.trim();

const lain = (await getCollection('project'))
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => Number(b.data.kategori === d.kategori) - Number(a.data.kategori === d.kategori))
  .slice(0, 3);

const meta = [
  { label: 'Kode proyek', nilai: d.kodeProject },
  { label: 'Kategori', nilai: kategoriLabel[d.kategori] },
  { label: 'Lokasi', nilai: d.lokasi.charAt(0) + d.lokasi.slice(1).toLowerCase() },
  { label: 'Waktu', nilai: tanggal },
  ...(d.klienTampil && d.klienNama ? [{ label: 'Klien', nilai: d.klienNama }] : []),
  ...d.stats.map((s) => ({ label: s.label, nilai: s.nilai })),
];
---

<Base title={d.judul} description={d.ringkas}>
  <section class="relative isolate overflow-hidden bg-ink pt-32 lg:pt-40">
    <div class="container-content">
      <nav aria-label="Breadcrumb" class="label-tech mb-8 flex flex-wrap items-center gap-2 text-fog">
        <a href="/" class="hover:text-volt">Beranda</a>
        <span class="text-line-strong">/</span>
        <a href="/portfolio" class="hover:text-volt">Proyek</a>
        <span class="text-line-strong">/</span>
        <span class="text-snow">{d.kodeProject}</span>
      </nav>
      <Eyebrow index={kategoriLabel[d.kategori]}>{d.kodeProject}</Eyebrow>
      <h1 class="mt-6 max-w-5xl text-h1">{d.judul}</h1>
      <p class="mt-6 max-w-2xl text-lg text-mist">{d.ringkas}</p>
    </div>

    <div class="container-content mt-12">
      <figure class="crop-marks relative aspect-[16/9] lg:aspect-[21/9]">
        <Image
          src={d.cover}
          alt={d.coverAlt}
          width={1600}
          widths={[768, 1280, 1600]}
          sizes="(min-width:1320px) 1240px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover"
        />
        <span class="label-tech absolute bottom-4 left-4 bg-ink/85 px-3 py-2 text-volt backdrop-blur">
          {d.kodeProject} · {d.lokasi}
        </span>
      </figure>
    </div>
  </section>

  <section class="bg-ink py-16 lg:py-24">
    <div class="container-content grid gap-12 lg:grid-cols-12">
      <dl class="border-t border-line lg:col-span-4">
        {
          meta.map((m) => (
            <div class="flex justify-between gap-6 border-b border-line py-4">
              <dt class="label-tech text-fog">{m.label}</dt>
              <dd class="text-right text-sm font-semibold text-snow">{m.nilai}</dd>
            </div>
          ))
        }
      </dl>
      <div class="lg:col-span-7 lg:col-start-6">
        {
          hasBody ? (
            <div class="prose-zsn text-lg leading-relaxed text-mist">
              <Content />
            </div>
          ) : (
            <p class="text-lg leading-relaxed text-mist">
              Proyek ini termasuk layanan <strong class="text-snow">{layanan.label}</strong>. Seluruh
              pekerjaan dikerjakan tim lapangan ZSN dan diserahkan bersama dokumentasi hasil kerja.
            </p>
          )
        }
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={layanan.href} variant="ghost" icon="lucide:arrow-right">Layanan {layanan.label}</Button>
        </div>
      </div>
    </div>
  </section>

  {
    d.galeri && (
      <section class="bg-carbon py-16 lg:py-24">
        <div class="container-content grid gap-4 md:grid-cols-2">
          {d.galeri.map((g) => (
            <figure class="crop-marks relative aspect-[4/3]">
              <Image src={g.src} alt={g.alt} width={1000} widths={[500, 1000]} sizes="(min-width:768px) 50vw, 100vw" class="size-full object-cover" loading="lazy" />
              <figcaption class="mt-3 text-sm text-fog">{g.alt}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <section class="border-t border-line bg-carbon py-16 lg:py-24">
    <div class="container-content">
      <div class="flex items-end justify-between gap-6">
        <h2 class="text-h2">Proyek lainnya</h2>
        <a href="/portfolio" class="label-tech inline-flex min-h-11 items-center gap-2 text-volt hover:underline">
          Semua proyek <Icon name="lucide:arrow-right" class="size-4" />
        </a>
      </div>
      <div class="mt-10 grid auto-rows-[18rem] gap-4 md:grid-cols-3">
        {lain.map((p) => <ProjectCard entry={p} />)}
      </div>
    </div>
  </section>

  <CtaFinal judul="Butuh pekerjaan serupa?" pesan={`Halo ZSN, saya ingin berkonsultasi tentang proyek serupa "${d.judul}".`} />
</Base>

<style>
  .prose-zsn :global(p + p) { margin-top: 1em; }
</style>
