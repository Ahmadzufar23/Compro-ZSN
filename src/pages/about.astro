---
/**
 * Tentang. Setiap prinsip kerja di sini bersumber dari konten yang sudah
 * ditulis pemilik (FAQ layanan, daftar "tidak termasuk", catatan tim),
 * bukan klaim baru.
 */
import { Icon } from 'astro-icon/components';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import GlobeMark from '@/components/home/GlobeMark.astro';
import Process from '@/components/home/Process.astro';
import CtaFinal from '@/components/home/CtaFinal.astro';
import { site } from '@/config/site';

const jejak = [
  {
    tahun: '2015',
    judul: 'Mulai di lapangan',
    detail: 'Kegiatan usaha dimulai di bidang instalasi dan perawatan jaringan fiber optik di Jakarta.',
  },
  {
    tahun: '2023',
    judul: 'Berbadan hukum',
    detail: `Resmi berdiri sebagai ${site.namaLegal}, sehingga bisa bekerja sama secara formal dengan perusahaan dan pengelola gedung.`,
  },
  {
    tahun: 'Sekarang',
    judul: 'Lima layanan',
    detail: 'Fiber optik, jaringan perusahaan, CCTV, kontrak pemeliharaan, dan pengembangan software.',
  },
];

const prinsip = [
  { icon: 'lucide:map-pinned', judul: 'Survei dulu, baru harga', detail: 'Penawaran disusun setelah tim melihat lokasi, karena jarak, rute, dan kondisi bangunan menentukan biaya.' },
  { icon: 'lucide:users', judul: 'Bekerja berpasangan', detail: 'Instalasi dikerjakan minimal dua orang: satu fokus memasang, satu fokus pada keselamatan kerja dan pengujian.' },
  { icon: 'lucide:activity', judul: 'Diuji sebelum diserahkan', detail: 'Jalur fiber diukur dengan OTDR, jaringan diuji per titik, CCTV diuji perekamannya. Hasilnya masuk laporan.' },
  { icon: 'lucide:file-check-2', judul: 'Didokumentasikan', detail: 'As-built, diagram topologi, atau dokumentasi titik kamera diserahkan sesuai jenis pekerjaan.' },
  { icon: 'lucide:list-x', judul: 'Batas lingkup tertulis', detail: 'Hal yang tidak termasuk kontrak ditulis sejak awal, terutama untuk kontrak pemeliharaan.' },
  { icon: 'lucide:info', judul: 'Terbuka soal merek', detail: 'Kami menangani berbagai merek perangkat sebagai instalatur independen, tidak terafiliasi resmi dengan produsennya.' },
];

const a = site.alamat;
---

<Base
  title="Tentang Kami"
  description="PT Zufar Solusi Nawasena (ZSN) mulai bekerja di instalasi fiber optik Jakarta sejak 2015 dan berbadan hukum pada 2023. Kini menangani jaringan, CCTV, pemeliharaan, dan software."
>
  <PageHero
    eyebrow="Tentang ZSN"
    judul="Dimulai dari fiber optik di Jakarta, sejak 2015."
    crumbs={[{ label: 'Beranda', href: '/' }, { label: 'Tentang' }]}
  />

  <section class="relative overflow-hidden bg-canvas py-20 lg:py-28">
    <div class="container-content grid items-center gap-16 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="text-xl leading-relaxed text-strong sm:text-2xl" data-reveal>
          {site.namaLegal} adalah penyedia barang dan jasa teknologi untuk perusahaan, dengan fokus
          pada infrastruktur jaringan, sistem keamanan, dan solusi digital.
        </p>
        <p class="mt-6 text-lg" data-reveal>
          Kami tetap mengerjakan pekerjaan lapangan sendiri, sambil mengembangkan software yang
          memanfaatkan infrastruktur yang kami pasang.
        </p>

        <ol class="mt-14 border-l-2 border-strong">
          {
            jejak.map((j, i) => (
              <li class="relative pb-10 pl-10 last:pb-0" data-reveal style={`--d:${i * 100}ms`}>
                <span class="absolute -left-[9px] top-2 size-4 rotate-45 border-2 border-strong bg-volt" aria-hidden="true" />
                <p class="font-display text-4xl font-extrabold text-strong" style="font-stretch:125%">{j.tahun}</p>
                <h2 class="mt-2 text-xl">{j.judul}</h2>
                <p class="mt-2 max-w-md text-soft">{j.detail}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="lg:col-span-6" data-reveal>
        <div class="mx-auto max-w-[500px]">
          <GlobeMark tone="light" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-raised py-24 lg:py-32">
    <div class="container-content">
      <Eyebrow data-reveal>Prinsip kerja</Eyebrow>
      <h2 class="mt-6 max-w-3xl text-h1" data-reveal>Cara kami bekerja di setiap proyek.</h2>
      <div class="mt-14 grid gap-px border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-3">
        {
          prinsip.map((p, i) => (
            <article class="bg-canvas p-8 lg:p-10" data-reveal style={`--d:${(i % 3) * 80}ms`}>
              <span class="icon-tile"><Icon name={p.icon} class="size-6" /></span>
              <h3 class="mt-8 text-h3">{p.judul}</h3>
              <p class="mt-3 text-soft">{p.detail}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Process />

  <section class="bg-canvas py-24 lg:py-32">
    <div class="container-content grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Eyebrow data-reveal>Identitas perusahaan</Eyebrow>
        <h2 class="mt-6 text-h2" data-reveal>Badan hukum resmi dengan kantor di Jakarta Selatan.</h2>
        <p class="mt-6 text-soft" data-reveal>
          Dokumen legalitas tersedia untuk keperluan penawaran, kontrak, dan pendaftaran vendor.
          Silakan minta langsung kepada kami.
        </p>
      </div>
      <dl class="border-t-2 border-strong lg:col-span-6 lg:col-start-7" data-reveal>
        {
          [
            ['Nama perusahaan', site.namaLegal],
            ['Nama dagang', 'ZSN Technology Solution'],
            ['Mulai beroperasi', '2015'],
            ['Berbadan hukum', '2023'],
            ['Kantor', `${a.jalan}, ${a.kelurahan}, ${a.kecamatan}, ${a.kota} ${a.kodePos}`],
            ['Jam operasional', site.jamOperasional],
            ['Wilayah kerja', 'Jabodetabek, luar kota sesuai kesepakatan'],
          ].map(([k, v]) => (
            <div class="grid gap-1 border-b border-rule py-5 sm:grid-cols-3 sm:gap-6">
              <dt class="label-tech pt-1 text-soft">{k}</dt>
              <dd class="text-strong sm:col-span-2">{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaFinal judul="Mari bicarakan kebutuhan Anda." label="Hubungi via WhatsApp" pesan="Halo ZSN, saya ingin mendiskusikan kebutuhan perusahaan kami." />
</Base>
