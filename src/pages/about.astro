---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';

import teamPhoto from '@/assets/project/proj-3.jpg';

const prinsip = [
  {
    judul: 'Professional Team',
    detail: 'Executed by certified technicians with extensive experience, ensuring maximum safety and performance standards.',
  },
  {
    judul: 'As-Built Documentation',
    detail: 'Every project comes with a test report and complete documentation as proof of quality.',
  },
  {
    judul: 'Warranty Backed',
    detail: 'Repairs due to installation errors are handled by us at no additional cost.',
  },
  {
    judul: 'Transparency',
    detail: 'Cost estimates are explained based on real factors in the field, not floating numbers.',
  },
];

const jumlahLayanan = (await getCollection('layanan')).length;

const stats = [
  { angka: 'Since 2023', label: 'Years in Operation' },
  { angka: 'Nationwide', label: 'Service Coverage' },
  { angka: 'Warrantied', label: 'Every Project' },
  { angka: String(jumlahLayanan), label: 'Available Services' },
];
---

<Base
  title="About"
  description="PT Zufar Solusi Nawasena (ZSN): network infrastructure, security, and digital system development for businesses across Indonesia."
>
  <Section bg="canvas" size="lg" aria-label="Company Story">
    <div class="mb-16 md:mb-20">
      <p class="label-tech text-muted">About Us</p>
      <h1 class="mt-3 text-h1">{site.namaLegal}</h1>
    </div>

    <div class="grid gap-12 lg:grid-cols-[55fr_45fr] lg:items-center">
      <div class="max-w-[65ch]">
        <p class="text-xl text-ink font-medium leading-relaxed">
          {site.namaLegal} ({site.nama}) provides network infrastructure,
          security, and digital system development for businesses in various
          cities across Indonesia.
        </p>
        <p class="mt-6 text-muted leading-relaxed text-lg">
          We handle everything from site surveys, fiber optic and CCTV installations,
          enterprise network configurations, to developing systems that
          run our clients' daily operations.
        </p>
      </div>
      
      <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl">
        <Picture
          src={teamPhoto}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          alt="ZSN Team in the field"
          width={800}
          height={600}
          class="w-full h-full object-cover scale-105 hover:scale-110 transition-transform duration-700"
        />
        <div class="absolute inset-0 ring-1 ring-inset ring-black/10 rounded-2xl"></div>
      </div>
    </div>

    <dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-10 border-t border-hairline pt-10 md:grid-cols-4" aria-label="Statistics">
      {
        stats.map(({ angka, label }) => (
          <div class="min-w-0 border-l-2 border-yellow-400 pl-6">
            <dt class="stat-angka font-display break-words text-3xl font-bold text-ink md:text-4xl" data-val={angka}>
              {angka}
            </dt>
            <dd class="label-tech mt-2 text-muted uppercase tracking-widest text-xs">{label}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  {/* Cakupan Layanan - Dark Section */}
  <section class="bg-zinc-950 border-y border-zinc-900 w-full overflow-hidden py-20 lg:py-32 relative">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-zinc-700 via-zinc-950 to-zinc-950"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 flex flex-col items-center text-center">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="w-3 h-3 bg-yellow-400"></div>
        <p class="text-zinc-500 font-mono text-sm tracking-widest uppercase">Coverage Area</p>
        <div class="w-3 h-3 bg-yellow-400"></div>
      </div>
      <h2 class="text-white text-4xl lg:text-6xl font-display font-bold max-w-4xl mx-auto leading-tight">
        Nationwide, unbounded by location.
      </h2>
      <p class="mt-8 max-w-2xl text-zinc-400 text-lg lg:text-xl mx-auto leading-relaxed">
        Our headquarters is located in {site.alamat.kota}, but the ZSN team is ready to fly to various cities in Indonesia to execute projects based on your infrastructure needs.
      </p>
    </div>
  </section>

  {/* Prinsip Kerja - Premium Cards */}
  <Section bg="surface" size="lg" aria-label="How we work">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="text-yellow-500 font-mono text-sm tracking-widest uppercase mb-4">Core Values</p>
      <h2 class="text-ink text-4xl font-display font-bold">Why Clients Choose ZSN</h2>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        prinsip.map((p, i) => (
          <div class="bg-white border border-hairline p-8 shadow-sm hover:shadow-xl transition-all duration-300 rounded-2xl group flex flex-col items-start relative overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-zinc-50 rounded-bl-full -z-10 group-hover:scale-150 transition-transform duration-500"></div>
            
            <div class="w-12 h-12 bg-zinc-900 rounded-xl flex items-center justify-center text-yellow-400 font-display font-bold text-xl mb-8 group-hover:bg-yellow-400 group-hover:text-zinc-900 transition-colors">
              {String(i + 1).padStart(2, '0')}
            </div>
            
            <h3 class="text-xl font-bold text-ink mb-3">{p.judul}</h3>
            <p class="text-sm text-muted leading-relaxed">{p.detail}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section bg="deep" size="lg" aria-label="Call to action">
    <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-h2 text-white">Ready to work together?</h2>
        <p class="mt-4 text-subtle">
          Contact our team to consult your network infrastructure needs.
        </p>
      </div>
      <Button href="/contact" size="lg" class="shrink-0">Contact Us</Button>
    </div>
  </Section>
</Base>

<script>
  import { inView, animate } from "motion";

  const setupStats = () => {
    const section = document.querySelector('[aria-label="Statistics"]');
    const statElements = document.querySelectorAll('.stat-angka');

    if (section && statElements.length > 0) {
      inView(section, () => {
        statElements.forEach(el => {
          const val = el.getAttribute('data-val') || '';
          const numMatch = val.match(/(\d+)/);

          if (numMatch) {
            const targetNum = parseInt(numMatch[1], 10);
            const prefix = val.substring(0, numMatch.index);
            const suffix = val.substring(numMatch.index + numMatch[1].length);

            // Animate from 0, but for years (like 2023) start closer
            let startNum = targetNum > 2000 ? 2000 : 0;

            animate(startNum, targetNum, {
               duration: 2,
               ease: "easeOut",
               onUpdate: (latest) => {
                 el.textContent = `${prefix}${Math.round(latest)}${suffix}`;
               }
            });
          }
        });
      }, { margin: "-50px" });
    }
  };

  document.addEventListener('astro:page-load', setupStats);
</script>
