---
import { Icon } from 'astro-icon/components';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import GlobeMark from '@/components/home/GlobeMark.astro';
import PowerStrip from '@/components/home/PowerStrip.astro';
import Process from '@/components/home/Process.astro';
import CtaFinal from '@/components/home/CtaFinal.astro';
import { site } from '@/config/site';

const jejak = [
  {
    tahun: '2015',
    judul: 'Turun ke lapangan',
    detail: 'Kegiatan usaha dimulai di bidang instalasi dan perawatan jaringan fiber optik di Jakarta. Menarik kabel, menyambung, menguji.',
  },
  {
    tahun: '2023',
    judul: 'Resmi berbadan hukum',
    detail: `Berdiri sebagai ${site.namaLegal}, supaya bisa bekerja sama dengan perusahaan dan pengelola gedung secara formal dan berkontrak.`,
  },
  {
    tahun: 'Kini',
    judul: 'Satu atap, lima lini',
    detail: 'Dari fiber optik meluas ke jaringan perusahaan, CCTV, kontrak pemeliharaan, dan pengembangan software yang berjalan di atas infrastrukturnya.',
  },
];

const prinsip = [
  { icon: 'lucide:map-pinned', judul: 'Survei sebelum harga', detail: 'Kami tidak memberi angka sebelum melihat lokasinya. Penawaran yang akurat butuh data lapangan.' },
  { icon: 'lucide:hard-hat', judul: 'Dikerjakan tim sendiri', detail: 'Pekerjaan inti tidak dilempar ke subkontraktor yang tidak Anda kenal. Penanggung jawabnya jelas.' },
  { icon: 'lucide:activity', judul: 'Diuji, bukan dikira', detail: 'Setiap jalur diukur dengan alat sebelum serah terima. Hasil ukurnya jadi bagian dari dokumen.' },
  { icon: 'lucide:file-check-2', judul: 'Semua tercatat', detail: 'As-built, label port, dan berita acara. Teknisi siapa pun yang datang setelahnya tidak perlu menebak.' },
  { icon: 'lucide:scale', judul: 'Jujur soal batas', detail: 'Apa yang tidak termasuk kontrak ditulis di awal. Kami juga terbuka bahwa kami bukan mitra resmi merek mana pun.' },
  { icon: 'lucide:layers', judul: 'Berpikir sampai lapisan atas', detail: 'Kami memasang jaringan dengan membayangkan sistem yang nanti berjalan di atasnya.' },
];

const a = site.alamat;
---

<Base
  title="Tentang Kami"
  description="PT Zufar Solusi Nawasena (ZSN) mulai bekerja di lapangan fiber optik Jakarta sejak 2015 dan resmi berbadan hukum pada 2023. Kini menangani infrastruktur jaringan, keamanan, dan software dalam satu tim."
>
  <PageHero
    eyebrow="Tentang ZSN"
    index="ZSN"
    judul='Dimulai dari menarik kabel. <span class="text-fog">Tumbuh jadi satu atap untuk infrastruktur digital.</span>'
    crumbs={[{ label: 'Beranda', href: '/' }, { label: 'Tentang' }]}
  />

  <section class="relative overflow-hidden bg-ink pb-24 lg:pb-32">
    <div class="container-content grid items-center gap-16 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="text-xl leading-relaxed text-snow sm:text-2xl" data-reveal>
          {site.namaLegal} adalah penyedia barang dan jasa teknologi yang berfokus pada
          <span class="text-volt">infrastruktur jaringan</span>, <span class="text-volt">sistem keamanan</span>, dan
          <span class="text-volt">solusi digital</span> untuk perusahaan.
        </p>
        <p class="mt-6 text-lg text-fog" data-reveal>
          Kami percaya sistem digital hanya sekuat fondasi fisiknya. Karena itu kami tetap turun
          ke lapangan sendiri, sambil membangun software yang memanfaatkan infrastruktur tersebut.
        </p>

        <ol class="mt-14 border-l border-line">
          {
            jejak.map((j, i) => (
              <li class="relative pb-10 pl-10 last:pb-0" data-reveal style={`--d:${i * 100}ms`}>
                <span class="absolute -left-[7px] top-1.5 size-3.5 rotate-45 bg-volt ring-4 ring-ink" aria-hidden="true" />
                <p class="font-display text-4xl font-extrabold text-snow" style="font-stretch:125%">{j.tahun}</p>
                <h2 class="mt-2 text-xl">{j.judul}</h2>
                <p class="mt-2 max-w-md text-fog">{j.detail}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="lg:col-span-6" data-reveal>
        <div class="mx-auto max-w-[520px]">
          <GlobeMark />
        </div>
      </div>
    </div>
  </section>

  <PowerStrip />

  <section class="bg-carbon py-24 lg:py-32">
    <div class="container-content">
      <Eyebrow index="01" data-reveal>Prinsip kerja</Eyebrow>
      <h2 class="mt-6 max-w-3xl text-h1" data-reveal>Enam kebiasaan yang membuat klien kembali.</h2>
      <div class="mt-14 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">
        {
          prinsip.map((p, i) => (
            <article class="group bg-carbon p-8 transition-colors hover:bg-steel lg:p-10" data-reveal style={`--d:${(i % 3) * 80}ms`}>
              <Icon name={p.icon} class="size-8 text-volt" />
              <h3 class="mt-8 text-h3">{p.judul}</h3>
              <p class="mt-3 text-fog">{p.detail}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Process index="02" />

  <section class="bg-ink py-24 lg:py-32">
    <div class="container-content grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Eyebrow index="03" data-reveal>Identitas perusahaan</Eyebrow>
        <h2 class="mt-6 text-h2" data-reveal>Badan hukum resmi, kantor yang bisa Anda datangi.</h2>
        <p class="mt-6 text-fog" data-reveal>
          Dokumen legalitas perusahaan tersedia untuk keperluan penawaran, kontrak, dan proses vendor
          registration. Mintakan langsung kepada kami.
        </p>
      </div>
      <dl class="border-t border-line lg:col-span-6 lg:col-start-7" data-reveal>
        {
          [
            ['Nama perusahaan', site.namaLegal],
            ['Nama dagang', 'ZSN Technology Solution'],
            ['Mulai beroperasi', '2015'],
            ['Berbadan hukum', '2023'],
            ['Kantor', `${a.jalan}, ${a.kelurahan}, ${a.kecamatan}, ${a.kota} ${a.kodePos}`],
            ['Wilayah kerja', 'Jabodetabek, luar kota sesuai kesepakatan'],
          ].map(([k, v]) => (
            <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-3 sm:gap-6">
              <dt class="label-tech pt-1 text-fog">{k}</dt>
              <dd class="text-snow sm:col-span-2">{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaFinal judul="Mari bicara soal proyek Anda." label="Hubungi via WhatsApp" pesan="Halo ZSN, saya ingin berkenalan dan mendiskusikan kebutuhan perusahaan kami." />
</Base>
