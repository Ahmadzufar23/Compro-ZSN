---
/**
 * Kontak — situs static tanpa backend. Form hanya menyusun pesan
 * WhatsApp di sisi klien. Progressive enhancement: tanpa JS, tombol
 * kirim tetap berfungsi sebagai link WhatsApp dengan pesan generik.
 */
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { site, waLink } from '@/config/site';

const pekerjaanOptions = [
  'Fiber Optic & FTTH',
  'CCTV & Security',
  'Network Infrastructure',
  'Maintenance & IT Support',
  'Pengembangan Sistem',
  'Belum yakin',
];

const bangunanOptions = [
  'Gedung perkantoran',
  'Ruko',
  'Pabrik atau gudang',
  'Perumahan',
  'Kantor',
  'Lainnya',
];

const skalaOptions = [
  '1 lantai atau 1 unit',
  '2 sampai 5 lantai',
  '6 lantai ke atas',
  'Kawasan',
];

const waktuOptions = [
  'Minggu ini',
  'Bulan ini',
  '1 sampai 3 bulan',
  'Masih membandingkan',
];

const waFallback = waLink('Halo ZSN, saya ingin minta survei kebutuhan layanan.');
const waLangsung = waLink('Halo ZSN, saya ingin bertanya soal layanan Anda.');
const fieldClass =
  'mt-2 min-h-11 w-full border border-hairline px-4 py-3 text-ink outline-none focus-visible:border-ink';
---

<Base
  title="Kontak"
  description="Hubungi ZSN untuk konsultasi kebutuhan instalasi fiber optic, CCTV, jaringan, dan sistem."
>
  <Section bg="deep" size="md" aria-label="Hero kontak">
    <p class="label-tech text-muted">Kontak</p>
    <h1 class="mt-3 text-h1 text-white">Hubungi kami</h1>
    <p class="mt-4 max-w-2xl text-subtle">
      Ceritakan kebutuhan lokasi Anda, tim kami akan merespons lewat
      WhatsApp dengan rencana survei.
    </p>
  </Section>

  <Section bg="canvas" size="lg" id="survei" aria-label="Form dan informasi kontak">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <form id="form-kontak" class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="nama" class="label-tech block text-muted">Nama</label>
          <input
            id="nama" name="nama" type="text" required
            class={fieldClass}
            placeholder="Nama Anda"
          />
        </div>

        <div>
          <label for="perusahaan" class="label-tech block text-muted">Perusahaan</label>
          <input
            id="perusahaan" name="perusahaan" type="text"
            class={fieldClass}
            placeholder="Nama perusahaan (opsional)"
          />
        </div>

        <div>
          <label for="pekerjaan" class="label-tech block text-muted">Jenis Pekerjaan</label>
          <select id="pekerjaan" name="pekerjaan" class={fieldClass}>
            {pekerjaanOptions.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>

        <div>
          <label for="lokasi" class="label-tech block text-muted">Lokasi</label>
          <input
            id="lokasi" name="lokasi" type="text" required
            class={fieldClass}
            placeholder="Kota atau alamat"
          />
        </div>

        <div>
          <label for="bangunan" class="label-tech block text-muted">Jenis Bangunan</label>
          <select id="bangunan" name="bangunan" class={fieldClass}>
            {bangunanOptions.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>

        <div>
          <label for="skala" class="label-tech block text-muted">Perkiraan Skala</label>
          <select id="skala" name="skala" class={fieldClass}>
            {skalaOptions.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>

        <div class="sm:col-span-2">
          <label for="waktu" class="label-tech block text-muted">Rencana Pengerjaan</label>
          <select id="waktu" name="waktu" class={fieldClass}>
            {waktuOptions.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>

        <div class="sm:col-span-2">
          <label for="catatan" class="label-tech block text-muted">Catatan</label>
          <textarea
            id="catatan" name="catatan" rows="4"
            class={fieldClass}
            placeholder="Detail tambahan (opsional)"
          ></textarea>
        </div>

        <Button
          id="tombol-kirim"
          href={waFallback}
          data-wa={site.whatsapp}
          size="lg"
          external
          class="mt-2 self-start sm:col-span-2"
        >
          Kirim via WhatsApp
        </Button>
      </form>

      <div class="flex flex-col gap-8">
        <div>
          <p class="label-tech text-muted">Alamat</p>
          <p class="mt-2 text-ink">
            {site.alamat.jalan}<br />
            {site.alamat.kelurahan}, {site.alamat.kecamatan}<br />
            {site.alamat.kota}, {site.alamat.provinsi} {site.alamat.kodePos}
          </p>
        </div>

        <div>
          <p class="label-tech text-muted">Jam Operasional</p>
          <p class="mt-2 text-ink">{site.jamOperasional}</p>
        </div>

        <div>
          <p class="label-tech text-muted">Email</p>
          <p class="mt-2 text-ink">
            <a href={`mailto:${site.email}`} class="hover:text-muted">{site.email}</a>
          </p>
        </div>

        <Button href={waLangsung} variant="outline-dark" external class="self-start">
          Chat via WhatsApp
        </Button>

        <div>
          <p class="label-tech text-muted">Peta Lokasi</p>
          <Button href={site.maps.url} variant="outline-dark" external class="mt-2 self-start">
            Buka di Google Maps
          </Button>
        </div>
      </div>
    </div>
  </Section>
</Base>

<script>
  const form = document.getElementById('form-kontak') as HTMLFormElement | null;
  const tombol = document.getElementById('tombol-kirim') as HTMLAnchorElement | null;
  if (form && tombol) {
    const nomor = tombol.dataset.wa;
    const baris: [string, string][] = [
      ['Nama', 'nama'],
      ['Perusahaan', 'perusahaan'],
      ['Jenis pekerjaan', 'pekerjaan'],
      ['Lokasi', 'lokasi'],
      ['Jenis bangunan', 'bangunan'],
      ['Perkiraan skala', 'skala'],
      ['Rencana pengerjaan', 'waktu'],
      ['Catatan', 'catatan'],
    ];
    const update = () => {
      const data = new FormData(form);
      const isi = baris
        .map(([label, nama]) => {
          const nilai = String(data.get(nama) || '').trim();
          return nilai ? `${label}: ${nilai}` : '';
        })
        .filter(Boolean);
      const teks = ['Halo ZSN, saya ingin minta survei.', '', ...isi].join('\n');
      tombol.href = `https://wa.me/${nomor}?text=${encodeURIComponent(teks)}`;
    };
    form.addEventListener('input', update);
    form.addEventListener('change', update);
  }
</script>
