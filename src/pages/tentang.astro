---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import PlaceholderPhoto from '@/components/ui/PlaceholderPhoto.astro';
import { site } from '@/config/site';

const prinsip = [
  {
    judul: 'Tim Internal',
    detail: 'Instalasi dan konfigurasi dikerjakan tim ZSN sendiri, bukan subkontraktor lepas.',
  },
  {
    judul: 'Dokumentasi Lengkap',
    detail: 'Setiap pekerjaan disertai laporan uji dan dokumentasi as-built sebagai bukti kualitas.',
  },
  {
    judul: 'Bergaransi',
    detail: 'Perbaikan akibat kesalahan instalasi kami tangani tanpa biaya tambahan.',
  },
  {
    judul: 'Transparansi Harga',
    detail: 'Estimasi biaya dijelaskan berdasarkan faktor nyata di lapangan, bukan angka mengambang.',
  },
];

/* Data legalitas (akta, NIB, NPWP) tidak ditampilkan di halaman
   publik mana pun (keputusan pemilik) — lihat CLAUDE.md bagian
   "Klaim yang DILARANG muncul di konten". Nomornya hanya dipakai
   untuk dokumen transaksi (penawaran, invoice, kontrak). */
const kenapaZsn = [
  {
    judul: 'Tim Internal',
    detail: 'Setiap pekerjaan dikerjakan tim ZSN sendiri, bukan subkontraktor lepas.',
  },
  {
    judul: 'Dokumentasi As-Built',
    detail: 'Setiap pekerjaan disertai laporan uji dan dokumentasi as-built sebagai bukti kualitas.',
  },
  {
    judul: 'Bergaransi',
    detail: 'Kesalahan instalasi kami perbaiki tanpa biaya tambahan, sesuai lingkup pekerjaan.',
  },
];

const jumlahLayanan = (await getCollection('layanan')).length;

const stats = [
  { angka: 'Sejak 2023', label: 'Tahun Beroperasi' },
  { angka: 'Nasional', label: 'Cakupan Layanan' },
  { angka: 'Bergaransi', label: 'Setiap Pengerjaan' },
  { angka: String(jumlahLayanan), label: 'Layanan Tersedia' },
];
---

<Base
  title="Tentang"
  description="PT Zufar Solusi Nawasena (ZSN): infrastruktur jaringan, keamanan, dan pengembangan sistem digital untuk bisnis di Indonesia."
>
  <Section bg="canvas" size="lg" aria-label="Hero tentang">
    <p class="label-tech text-muted">Tentang Kami</p>
    <h1 class="mt-3 text-h1">{site.namaLegal}</h1>
  </Section>

  <Section bg="canvas" size="md" aria-label="Cerita perusahaan">
    <div class="grid gap-10 lg:grid-cols-[55fr_45fr] lg:items-start">
      <div class="max-w-[65ch]">
        <p class="text-muted">
          {site.namaLegal} ({site.nama}) mengerjakan infrastruktur jaringan,
          keamanan, dan pengembangan sistem digital untuk bisnis di berbagai
          kota di Indonesia.
        </p>
        <p class="mt-4 text-muted">
          Kami menangani pekerjaan dari survei lokasi, instalasi fiber optic dan
          CCTV, konfigurasi jaringan enterprise, sampai pengembangan sistem yang
          menjalankan operasional klien sehari-hari.
        </p>
      </div>
      <PlaceholderPhoto ratio="4/3" label="Foto Tim ZSN di Lapangan" />
    </div>

    <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-8 border-t border-hairline pt-8 md:grid-cols-4">
      {
        stats.map(({ angka, label }) => (
          <div class="min-w-0 border-l border-hairline pl-4">
            <dt class="font-display break-words text-2xl font-bold text-ink md:text-3xl">
              {angka}
            </dt>
            <dd class="label-tech mt-1 text-muted">{label}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section bg="surface" size="md" aria-label="Kenapa ZSN">
    <p class="label-tech text-muted">Kenapa ZSN</p>
    <h2 class="mt-3 text-h2">Alasan klien mempercayakan pekerjaan</h2>

    <div class="mt-8 grid gap-8 border-t border-hairline pt-8 sm:grid-cols-3">
      {
        kenapaZsn.map((k) => (
          <div class="border-l border-hairline pl-5">
            <h3 class="text-h3">{k.judul}</h3>
            <p class="mt-2 text-sm text-muted">{k.detail}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section bg="canvas" size="sm" aria-label="Cakupan layanan">
    <p class="label-tech text-muted">Cakupan Layanan</p>
    <h2 class="mt-3 text-h2">Nasional, tidak dibatasi wilayah</h2>
    <p class="mt-4 max-w-2xl text-muted">
      Survei dan pengerjaan ZSN tidak dibatasi wilayah tertentu. Kantor kami
      berada di {site.alamat.kota}, dan tim siap menangani project di kota
      lain di Indonesia sesuai kebutuhan klien.
    </p>
  </Section>

  <Section bg="surface" size="md" aria-label="Cara kami bekerja">
    <p class="label-tech text-muted">Prinsip Kerja</p>
    <h2 class="mt-3 text-h2">Cara kami bekerja</h2>

    <div class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        prinsip.map((p) => (
          <div class="border-t border-hairline pt-5">
            <h3 class="text-base font-semibold text-ink">{p.judul}</h3>
            <p class="mt-2 text-sm text-muted">{p.detail}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section bg="deep" size="lg" aria-label="Ajakan bertindak">
    <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-h2 text-white">Siap bekerja sama?</h2>
        <p class="mt-4 text-subtle">
          Hubungi tim kami untuk konsultasi kebutuhan infrastruktur jaringan
          Anda.
        </p>
      </div>
      <Button href="/kontak" size="lg" class="shrink-0">Hubungi Kami</Button>
    </div>
  </Section>
</Base>
