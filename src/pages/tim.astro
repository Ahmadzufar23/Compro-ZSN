---
/**
 * Tim — collection tim digerbang oleh izinTampil (lihat content.config.ts).
 * Saat kosong, halaman tetap tampil rapi lewat struktur divisi + deskripsi
 * peran, bukan grid kosong atau kartu placeholder abu-abu.
 */
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';

const semua = await getCollection('tim');
semua.sort((a, b) => a.data.urutan - b.data.urutan);

const divisiInfo = {
  manajemen: {
    label: 'Manajemen',
    deskripsi: 'Menentukan arah project, hubungan klien, dan standar kerja ZSN.',
  },
  instalasi: {
    label: 'Tim Instalasi',
    deskripsi: 'Pemasangan jaringan fiber optic, CCTV, dan perangkat langsung di lapangan.',
  },
  teknis: {
    label: 'Tim Teknis & Konfigurasi',
    deskripsi: 'Konfigurasi perangkat, pengujian OTDR, dan dokumentasi as-built.',
  },
  operasional: {
    label: 'Tim Operasional & QC',
    deskripsi: 'Quality control, garansi, dan dukungan purna pasang.',
  },
} as const;

const urutanDivisi = ['manajemen', 'instalasi', 'teknis', 'operasional'] as const;

const kelompok = urutanDivisi.map((divisi) => ({
  divisi,
  info: divisiInfo[divisi],
  anggota: semua.filter((a) => a.data.divisi === divisi),
}));
---

<Base
  title="Tim"
  description="Tim internal ZSN yang menangani instalasi, konfigurasi teknis, dan operasional project jaringan di Jabodetabek."
>
  <Section bg="ink" size="lg" blueprint aria-label="Hero tim">
    <p class="label-tech text-yellow">Tim</p>
    <h1 class="mt-3 text-h1 text-white">Orang di Balik Setiap Pemasangan</h1>
    <p class="mt-4 max-w-2xl text-white/70">
      Seluruh pekerjaan ZSN dikerjakan oleh tim internal (bukan subkontraktor
      lepas) yang terbagi menurut peran di setiap tahap project.
    </p>
  </Section>

  {
    kelompok.map(({ divisi, info, anggota }) => (
      <Section bg={divisi === 'instalasi' || divisi === 'operasional' ? 'mist' : 'white'} size="md" aria-label={info.label}>
        <p class="label-tech text-amber-text">{info.label}</p>
        <h2 class="mt-3 text-h2">{info.label}</h2>
        <p class="mt-3 max-w-prose">{info.deskripsi}</p>

        {anggota.length > 0 ? (
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {anggota.map((a) => (
              <article class="rounded-md border border-ink/10 bg-white p-5">
                <div class="overflow-hidden rounded-md" style="aspect-ratio: 1/1;">
                  <Picture
                    src={a.data.foto}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    alt={`${a.data.nama}, ${a.data.jabatan}`}
                    width={400}
                    height={400}
                    loading="lazy"
                    pictureAttributes={{ class: 'block size-full' }}
                    class="size-full object-cover"
                  />
                </div>
                <h3 class="mt-4 text-base font-semibold uppercase tracking-tight text-ink">
                  {a.data.nama}
                </h3>
                <p class="label-tech mt-1 text-slate-muted">{a.data.jabatan}</p>
                {a.data.sertifikasi && (
                  <div class="mt-3 flex flex-wrap gap-2">
                    {a.data.sertifikasi.map((s) => (
                      <span class="label-tech rounded-sm border border-ink/15 px-2 py-1 text-ink">
                        {s}
                      </span>
                    ))}
                  </div>
                )}
              </article>
            ))}
          </div>
        ) : (
          <p class="label-tech mt-6 text-slate-muted">Profil anggota segera hadir.</p>
        )}
      </Section>
    ))
  }
</Base>
