---
/** Label kecil di atas judul section: penanda kotak kuning + teks mono. */
interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: extra = '', ...rest } = Astro.props;
---

<p class:list={['label-tech flex items-center gap-3 text-soft', extra]} {...rest}>
  <span class="size-2 shrink-0 bg-volt" aria-hidden="true"></span>
  <span><slot /></span>
</p>
