---
import { Image } from 'astro:assets';
import proj1 from '@/assets/project/proj-1.jpg';
import proj2 from '@/assets/project/proj-2.jpg';
import proj3 from '@/assets/project/proj-3.jpg';
import proj4 from '@/assets/project/proj-4.png';

const slides = [
  { img: proj1, caption: 'Smart F&B Ordering' },
  { img: proj2, caption: 'HRIS & Payroll Automation' },
  { img: proj4, caption: 'Sistem Manajemen Event' },
];
---

<div class="slider-wrapper group relative w-full h-[350px] lg:h-[500px] overflow-hidden bg-zinc-950">
  {/* Slides Container */}
  <div class="slider-container flex w-full h-full snap-x snap-mandatory overflow-x-auto scroll-smooth scrollbar-hide" style="scrollbar-width: none; -ms-overflow-style: none;">
    {slides.map((slide, i) => (
      <div class="slide min-w-full h-full shrink-0 snap-center relative" data-index={i} data-caption={slide.caption}>
        {/* Coming Soon Placeholder menggantikan Image */}
        <div class="h-full w-full bg-zinc-900/80 flex flex-col items-center justify-center">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-16 text-zinc-700 mb-4 opacity-50">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" />
          </svg>
          <span class="text-zinc-500 font-display font-bold tracking-widest text-lg uppercase">UI Mockup Coming Soon</span>
        </div>
        {/* Gradient Overlay for extra contrast at the bottom */}
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
      </div>
    ))}
  </div>

  {/* Caption Box (Bottom Left Overlay) */}
  <div class="absolute bottom-0 left-0 z-10 max-w-[75%] bg-zinc-900 border-t border-r border-zinc-800 p-6 lg:p-8">
    <p class="slider-caption text-lg lg:text-2xl font-display font-bold text-white leading-tight drop-shadow-md">
      {slides[0].caption}
    </p>
    <div class="mt-4 flex items-center gap-2">
      {slides.map((_, i) => (
        <button 
          class:list={[
            "slider-dot transition-all duration-300",
            i === 0 
              ? "w-3 h-3 bg-yellow [clip-path:polygon(50%_0%,0%_100%,100%_100%)]" 
              : "w-2 h-2 rounded-full bg-zinc-600 hover:bg-zinc-400"
          ]}
          aria-label={`Go to slide ${i + 1}`}
          data-index={i}
        ></button>
      ))}
    </div>
  </div>

  {/* Navigation Arrows (Bottom Right) */}
  <div class="absolute bottom-0 right-0 z-10 flex bg-zinc-900 border-t border-l border-zinc-800">
    <button class="slider-prev p-4 lg:p-6 text-white hover:bg-zinc-800 transition-colors disabled:opacity-30" aria-label="Previous slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
    </button>
    <button class="slider-next p-4 lg:p-6 border-l border-zinc-800 text-white hover:bg-zinc-800 transition-colors disabled:opacity-30" aria-label="Next slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
</div>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function setupSliders() {
    const wrappers = document.querySelectorAll('.slider-wrapper');
    
    wrappers.forEach(wrapper => {
      const container = wrapper.querySelector('.slider-container') as HTMLElement;
      const slides = wrapper.querySelectorAll('.slide');
      const dots = wrapper.querySelectorAll('.slider-dot');
      const captionEl = wrapper.querySelector('.slider-caption') as HTMLElement;
      const btnPrev = wrapper.querySelector('.slider-prev') as HTMLButtonElement;
      const btnNext = wrapper.querySelector('.slider-next') as HTMLButtonElement;
      
      if (!container || slides.length === 0) return;

      let currentIndex = 0;
      const total = slides.length;

      const updateUI = (index: number) => {
        currentIndex = index;
        
        const activeSlide = slides[index] as HTMLElement;
        if (activeSlide && captionEl) {
          captionEl.textContent = activeSlide.dataset.caption || '';
        }

        dots.forEach((dot, i) => {
          if (i === index) {
            dot.className = "slider-dot transition-all duration-300 w-3 h-3 bg-yellow [clip-path:polygon(50%_0%,0%_100%,100%_100%)]";
          } else {
            dot.className = "slider-dot transition-all duration-300 w-2 h-2 rounded-full bg-zinc-600 hover:bg-zinc-400";
          }
        });

        if (btnPrev) btnPrev.disabled = index === 0;
        if (btnNext) btnNext.disabled = index === total - 1;
      };

      const goToSlide = (index: number) => {
        if (index < 0 || index >= total) return;
        const slideWidth = container.clientWidth;
        container.scrollTo({
          left: slideWidth * index,
          behavior: 'smooth'
        });
      };

      if (btnPrev) btnPrev.addEventListener('click', () => goToSlide(currentIndex - 1));
      if (btnNext) btnNext.addEventListener('click', () => goToSlide(currentIndex + 1));

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          const btn = e.currentTarget as HTMLButtonElement;
          const idx = parseInt(btn.dataset.index || '0', 10);
          goToSlide(idx);
        });
      });

      let scrollTimeout: number;
      container.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const scrollLeft = container.scrollLeft;
          const slideWidth = container.clientWidth;
          const newIndex = Math.round(scrollLeft / slideWidth);
          
          if (newIndex !== currentIndex && newIndex >= 0 && newIndex < total) {
            updateUI(newIndex);
          }
        }, 50) as unknown as number;
      });

      // Autoplay functionality
      let autoplayInterval: number;
      const startAutoplay = () => {
        clearInterval(autoplayInterval); // Prevent overlapping intervals
        autoplayInterval = setInterval(() => {
          let nextIndex = currentIndex + 1;
          if (nextIndex >= total) nextIndex = 0; // loop back to first
          goToSlide(nextIndex);
        }, 2000) as unknown as number; // 2 seconds
      };

      const stopAutoplay = () => {
        clearInterval(autoplayInterval);
      };

      // Pause on hover
      wrapper.addEventListener('mouseenter', stopAutoplay);
      wrapper.addEventListener('mouseleave', startAutoplay);
      // Pause on touch
      wrapper.addEventListener('touchstart', stopAutoplay);

      updateUI(0);
      startAutoplay();
    });
  }

  setupSliders();
  document.addEventListener('astro:page-load', setupSliders);
</script>
