---
/**
 * Section — pembungkus ritme vertikal.
 *
 * Semua section halaman memakai ini. Padding tidak pernah ditulis
 * manual di komponen anak, sehingga jarak antar-section konsisten
 * di seluruh situs dan tidak ada CSS yang saling membatalkan.
 *
 * Arah visual: enterprise terang, presisi, tertahan (lihat CLAUDE.md).
 * Hanya SATU section gelap per halaman, yaitu CTA penutup, memakai
 * bg="deep". Section lain berselang-seling canvas/surface.
 *
 * Migrasi dari palet lama (ink/graphite/mist/white) selesai per batch 2
 * — tidak ada lagi alias, dan grid dekoratif di section gelap sudah
 * dihapus permanen.
 */
interface Props {
  bg?: 'canvas' | 'surface' | 'deep';
  size?: 'sm' | 'md' | 'lg';
  /**
   * Untuk dua section yang sengaja ditempel jadi satu blok visual
   * (mis. ServiceGrid -> SoftwareBanner, gap 16px total): section
   * pertama pakai flushBottom, section kedua pakai flushTop.
   */
  flushTop?: boolean;
  flushBottom?: boolean;
  as?: 'section' | 'div' | 'article';
  class?: string;
  id?: string;
  'aria-label'?: string;
}

const {
  bg = 'canvas',
  size = 'md',
  flushTop = false,
  flushBottom = false,
  as: Tag = 'section',
  class: extra = '',
  ...rest
} = Astro.props;

type Bg = NonNullable<Props['bg']>;
type Size = NonNullable<Props['size']>;

const bgClasses: Record<Bg, string> = {
  canvas: 'bg-canvas',
  surface: 'bg-surface',
  deep: 'on-dark bg-deep text-subtle',
};

const topClasses: Record<Size, string> = {
  sm: 'pt-12 md:pt-16',
  md: 'pt-16 md:pt-20',
  lg: 'pt-20 md:pt-30',
};

const bottomClasses: Record<Size, string> = {
  sm: 'pb-12 md:pb-16',
  md: 'pb-16 md:pb-20',
  lg: 'pb-20 md:pb-30',
};

const bgClass = bgClasses[bg];

/* 16px total antara dua section yang ditempel: pt-0 di section bawah + pb-4 di section atas */
const finalTop = flushTop ? 'pt-0' : topClasses[size];
const finalBottom = flushBottom ? 'pb-4' : bottomClasses[size];

---

<Tag class:list={[bgClass, finalTop, finalBottom, extra]} {...rest}>
  <div class="container-content">
    <slot />
  </div>
</Tag>
