---
/**
 * PlaceholderPhoto — blok surface polos dengan garis rambut, dipakai
 * sampai foto asli tersedia di Fase 5. Tanpa border tebal, tanpa radius.
 */
interface Props {
  ratio: string; // '21/9' | '3/4' | '4/3' | '16/9' | '1/1'
  label?: string;
  /** Dipakai di atas section deep: tanpa isian, garis rambut putih tipis. */
  dark?: boolean;
  class?: string;
}

const { ratio, label = 'Foto placeholder', dark = false, class: extra = '' } = Astro.props;

const toneClass = dark ? 'border-white/15' : 'border-hairline bg-surface';
---

<div
  class:list={['relative flex items-center justify-center overflow-hidden border', toneClass, extra]}
  style={`aspect-ratio: ${ratio};`}
>
  <span class="label-tech px-4 text-center text-subtle">
    {label}
  </span>
</div>
