---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  /**
   * volt   : isian kuning, teks tinta. Aksi utama, aman di dua tema.
   * solid  : isian kontras penuh (tinta di terang, putih di gelap).
   * ghost  : garis tipis, mengikuti tema.
   * on-volt: tombol sekunder di atas latar kuning.
   */
  variant?: 'volt' | 'solid' | 'ghost' | 'on-volt';
  size?: 'md' | 'lg';
  external?: boolean;
  icon?: string | false;
  class?: string;
}

const {
  href,
  variant = 'volt',
  size = 'md',
  external = false,
  icon = 'lucide:arrow-up-right',
  class: extra = '',
} = Astro.props;

const variants = {
  volt: 'bg-volt text-ink hover:bg-volt-hot',
  solid: 'bg-strong text-canvas hover:opacity-90',
  ghost: 'text-strong ring-1 ring-inset ring-rule-strong hover:ring-strong',
  'on-volt': 'text-ink ring-1 ring-inset ring-ink/40 hover:ring-ink',
};
const sizes = {
  md: 'min-h-12 px-5 text-sm gap-3',
  lg: 'min-h-14 px-7 text-base gap-4',
};
---

<a
  href={href}
  class:list={[
    'group/btn relative inline-flex items-center justify-center font-semibold tracking-tight transition-[background-color,box-shadow,opacity] duration-200',
    variants[variant],
    (variant === 'volt' || variant === 'solid') && 'cut-z',
    sizes[size],
    extra,
  ]}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <span><slot /></span>
  {
    icon && (
      <Icon
        name={icon}
        class="size-[1.15em] shrink-0 transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5"
        aria-hidden="true"
      />
    )
  }
</a>
