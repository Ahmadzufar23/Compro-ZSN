---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  variant?: 'volt' | 'ghost' | 'ink' | 'paper-ghost';
  size?: 'md' | 'lg';
  external?: boolean;
  icon?: string | false;
  class?: string;
}

const {
  href,
  variant = 'volt',
  size = 'md',
  external = false,
  icon = 'lucide:arrow-up-right',
  class: extra = '',
} = Astro.props;

const variants = {
  volt: 'bg-volt text-ink hover:bg-volt-hot',
  ink: 'bg-ink text-snow hover:bg-carbon',
  ghost: 'text-snow ring-1 ring-inset ring-line-strong hover:ring-volt hover:text-volt',
  'paper-ghost': 'text-ink ring-1 ring-inset ring-ink/25 hover:ring-ink',
};
const sizes = {
  md: 'min-h-12 px-5 text-sm gap-3',
  lg: 'min-h-14 px-7 text-base gap-4',
};
---

<a
  href={href}
  class:list={[
    'group/btn cut-z relative inline-flex items-center justify-center font-semibold tracking-tight transition-colors duration-200',
    variants[variant],
    sizes[size],
    extra,
  ]}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <span><slot /></span>
  {
    icon && (
      <Icon
        name={icon}
        class="size-[1.15em] shrink-0 transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5"
        aria-hidden="true"
      />
    )
  }
</a>
