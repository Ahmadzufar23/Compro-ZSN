---
/**
 * SoftwareBanner — satu-satunya tempat software tampil di homepage
 * (dikeluarkan dari ServiceGrid lewat `tampilDiGrid: false`). Semua
 * teks diambil dari software.mdx, bukan disalin manual ke sini, supaya
 * tidak melenceng dari konten layanan yang sebenarnya.
 */
import { getCollection } from 'astro:content';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import PlaceholderPhoto from '@/components/ui/PlaceholderPhoto.astro';

const software = (await getCollection('layanan')).find((entry) => entry.id === 'software');
---

{
  software && (
    <Section bg="surface" size="lg" class="border-y border-hairline" aria-label="Software">
      <div class="grid gap-10 lg:grid-cols-[55%_45%] lg:items-center">
        <div>
          <p class="label-tech text-muted">Sistem Digital</p>
          <h2 class="mt-3 text-h2">{software.data.judul}</h2>
          <p class="mt-4 text-muted">{software.data.subjudul}</p>

          {software.data.spesifikasi && (
            <dl class="mt-6 divide-y divide-hairline border-t border-hairline">
              {software.data.spesifikasi.map((s) => (
                <div class="flex items-baseline justify-between gap-4 py-2.5 font-mono text-xs">
                  <dt class="text-subtle">{s.label}</dt>
                  <dd class="text-right text-ink">{s.nilai}</dd>
                </div>
              ))}
            </dl>
          )}

          {software.data.paket && (
            <div class="mt-6 flex flex-wrap gap-2">
              {software.data.paket.map((p) => (
                <span class="label-tech border border-hairline px-3 py-1.5 text-muted">
                  {p.nama}
                </span>
              ))}
            </div>
          )}
          <Button href={`/layanan/${software.id}`} size="lg" class="mt-8">
            Lihat Detail Layanan
          </Button>
        </div>
        <PlaceholderPhoto ratio="4/3" label="Mockup dashboard" />
      </div>
    </Section>
  )
}
