---
/**
 * SoftwareBanner — satu-satunya tempat software tampil di homepage
 * (dikeluarkan dari ServiceGrid lewat `tampilDiGrid: false`). Semua
 * teks diambil dari software.mdx, bukan disalin manual ke sini, supaya
 * tidak melenceng dari konten layanan yang sebenarnya.
 */
import { getCollection } from 'astro:content';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import ImageSlider from '@/components/ui/ImageSlider.astro';

const software = (await getCollection('produk')).find((entry) => entry.id === 'software');
---

{
  software && (
    <Section id="products" bg="canvas" size="lg" class="border-y border-hairline relative" aria-label="Software">
      {/* Dekorasi pola halus di latar belakang */}
      <div class="absolute inset-0 z-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>
      
      <div class="relative z-10 grid gap-10 lg:grid-cols-[50%_50%] xl:grid-cols-[55%_45%] lg:items-center">
        {/* Kolom Kiri: Kartu Teks */}
        <div class="bg-surface border border-hairline p-8 md:p-12 shadow-sm ring-1 ring-black/5">
          <p class="label-tech text-muted">Our Digital Products</p>
          <h2 class="mt-3 text-h2">{software.data.judul}</h2>
          <p class="mt-4 text-muted">{software.data.subjudul}</p>

          {software.data.spesifikasi && (
            <dl class="mt-6 divide-y divide-hairline border-t border-hairline">
              {software.data.spesifikasi.map((s) => (
                <div class="flex items-baseline justify-between gap-4 py-2.5 font-mono text-xs">
                  <dt class="text-subtle">{s.label}</dt>
                  <dd class="text-right text-ink">{s.nilai}</dd>
                </div>
              ))}
            </dl>
          )}

          {software.data.paket && (
            <div class="mt-6 flex flex-wrap gap-2">
              {software.data.paket.map((p) => (
                <span class="label-tech border border-hairline px-3 py-1.5 text-muted">
                  {p.nama}
                </span>
              ))}
            </div>
          )}
          <Button href={`/products/${software.id}`} size="lg" class="mt-8">
            View Product Catalog
          </Button>
        </div>
        
        {/* Kolom Kanan: Slider */}
        <div class="w-full">
          <ImageSlider />
        </div>
      </div>
    </Section>
  )
}
