---
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';

/* Nempel ke ServiceGrid dengan gap 16px total:
   ServiceGrid pakai flushBottom, banner ini pakai flushTop. */
const tags = ['Dashboard Monitoring', 'Sistem Inventaris', 'Portal Pelaporan', 'Integrasi CCTV'];
---

<Section bg="ink" size="md" blueprint flushTop aria-label="Software">
  <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl">
      <p class="label-tech text-yellow">Software</p>
      <h2 class="mt-3 text-h2 text-white">Sistem yang Menjalankan Infrastruktur Anda</h2>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          tags.map((t) => (
            <span class="label-tech rounded-md border border-white/25 px-3 py-1.5 text-white/80">{t}</span>
          ))
        }
      </div>
    </div>
    <Button href="/layanan/software" size="lg" class="shrink-0">Lihat Sistem Kami</Button>
  </div>
</Section>
