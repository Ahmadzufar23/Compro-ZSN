---
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import PlaceholderPhoto from '@/components/ui/PlaceholderPhoto.astro';
import { site } from '@/config/site';

/* Tanpa foto individu atau nama personal di homepage — lihat gate tim di content.config.ts */
const divisi = [
  {
    nama: 'Tim Instalasi',
    desc: 'Pemasangan jaringan fiber optic, CCTV, dan perangkat langsung di lapangan.',
  },
  {
    nama: 'Tim Teknis & Konfigurasi',
    desc: 'Konfigurasi perangkat, pengujian OTDR, dan dokumentasi as-built.',
  },
  {
    nama: 'Tim Operasional & QC',
    desc: 'Quality control, garansi, dan dukungan purna pasang.',
  },
];
---

<Section bg="canvas" size="lg" id="tim" aria-label="Tim">
  <p class="label-tech text-muted">Tim</p>
  <h2 class="mt-3 text-h2">Orang di balik setiap pemasangan</h2>

  <div class="mt-10 grid items-stretch gap-8 lg:grid-cols-[55%_45%]">
    <PlaceholderPhoto ratio="16/9" label="Foto tim di lapangan" class="lg:h-full lg:w-full" />

    <div class="divide-y divide-hairline border-t border-hairline lg:border-t-0">
      {
        divisi.map((d) => (
          <div class="py-5 first:pt-0">
            <h3 class="text-h3">{d.nama}</h3>
            <p class="mt-2 text-muted">{d.desc}</p>
          </div>
        ))
      }
    </div>
  </div>

  {site.halamanAktif.tim && (
    <div class="mt-8">
      <Button href="/tim" variant="outline-dark">Lihat Semua Tim</Button>
    </div>
  )}
</Section>
