---
import Section from '@/components/ui/Section.astro';
import PlaceholderPhoto from '@/components/ui/PlaceholderPhoto.astro';

/* Tanpa foto individu atau nama personal di homepage — lihat gate tim di content.config.ts */
const divisi = [
  {
    nama: 'Tim Instalasi',
    desc: 'Pemasangan jaringan fiber optic, CCTV, dan perangkat langsung di lapangan.',
  },
  {
    nama: 'Tim Teknis & Konfigurasi',
    desc: 'Konfigurasi perangkat, pengujian OTDR, dan dokumentasi as-built.',
  },
  {
    nama: 'Tim Operasional & QC',
    desc: 'Quality control, garansi, dan dukungan purna pasang.',
  },
];
---

<Section bg="ink" size="lg" blueprint aria-label="Tim">
  <p class="label-tech text-yellow">Tim</p>
  <h2 class="mt-3 text-h2 text-white">Orang di Balik Setiap Pemasangan</h2>

  <div class="mt-10 grid gap-8 lg:grid-cols-[55%_45%]">
    <PlaceholderPhoto ratio="16/9" label="Foto tim di lapangan" dark />

    <div class="grid gap-4">
      {
        divisi.map((d) => (
          <div class="rounded-md border border-white/15 p-5">
            <h3 class="text-h3 text-white">{d.nama}</h3>
            <p class="mt-2 text-white/70">{d.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</Section>
