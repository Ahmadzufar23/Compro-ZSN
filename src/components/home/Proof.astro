---
/**
 * Proof: dokumen yang diserahkan di akhir proyek.
 * Gambar dokumen adalah ILUSTRASI FORMAT (dinyatakan di halaman), bukan
 * data proyek nyata, jadi tidak ada angka hasil ukur. Kartu dokumentasi
 * foto memakai foto lapangan asli dari koleksi project.
 * TODO pemilik: ganti ilustrasi dengan scan dokumen asli (data klien disamarkan).
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Eyebrow from '@/components/ui/Eyebrow.astro';

/* Foto asli saja: proj-6 adalah gambar buatan AI, tidak dipakai di sini */
const foto = (await getCollection('project'))
  .filter((p) => !p.id.includes('proj-6'))
  .sort((a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf())
  .slice(0, 4);
---

<section class="relative bg-canvas py-24 lg:py-32" aria-labelledby="dokumen-title">
  <div class="container-content">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <Eyebrow data-reveal>Dokumen serah terima</Eyebrow>
        <h2 id="dokumen-title" class="mt-6 text-h1" data-reveal>Yang Anda terima di akhir proyek.</h2>
      </div>
      <p class="max-w-md text-lg lg:col-span-5 lg:justify-self-end" data-reveal>
        Dokumen ini berguna jauh setelah kami pergi: saat ada gangguan, perluasan, atau pergantian
        teknisi.
      </p>
    </div>

    <div class="mt-14 grid gap-5 lg:mt-20 lg:grid-cols-12">
      <!-- 01 Laporan uji -->
      <article class="sheet lg:col-span-7" data-reveal>
        <header class="sheet-head">
          <span class="label-tech">01 · Laporan uji OTDR</span>
          <span class="label-tech text-soft">Pekerjaan fiber</span>
        </header>
        <div class="p-6 sm:p-8">
          <p class="max-w-md text-sm text-soft">
            Grafik redaman sepanjang jalur. Setiap sambungan dan konektor tercatat, jadi kualitas
            jalur bisa diperiksa ulang kapan pun.
          </p>
          <svg viewBox="0 0 640 230" class="mt-6 w-full" aria-hidden="true">
            <g stroke="rgba(10,12,15,.08)">
              {[0, 1, 2, 3, 4].map((i) => <line x1="40" x2="630" y1={20 + i * 48} y2={20 + i * 48} />)}
              {[0, 1, 2, 3, 4, 5, 6].map((i) => <line y1="20" y2="212" x1={40 + i * 98} x2={40 + i * 98} />)}
            </g>
            <text x="0" y="28" class="ax">dB</text>
            <text x="606" y="228" class="ax">km</text>
            <path
              d="M40 30 L60 36 L62 26 L66 48 L180 72 L184 80 L300 102 L304 96 L308 112 L430 134 L434 142 L560 166 L564 150 L570 208 L630 210"
              fill="none"
              stroke="#0A0C0F"
              stroke-width="2.5"
              class="trace"
            />
            {[[184, 80, 'Sambungan'], [308, 112, 'Konektor'], [434, 142, 'Sambungan'], [564, 150, 'Ujung']].map(([x, y, l]) => (
              <g>
                <line x1={x} x2={x} y1={Number(y) - 12} y2={Number(y) - 36} stroke="#0A0C0F" stroke-dasharray="2 3" />
                <rect x={Number(x) - 5} y={Number(y) - 5} width="10" height="10" fill="#FFCE00" stroke="#0A0C0F" />
                <text x={Number(x) - 4} y={Number(y) - 42} class="ev">{l}</text>
              </g>
            ))}
          </svg>
        </div>
      </article>

      <!-- 02 As-built -->
      <article class="sheet lg:col-span-5" data-reveal style="--d:100ms">
        <header class="sheet-head">
          <span class="label-tech">02 · As-built / topologi</span>
          <span class="label-tech text-soft">Semua layanan</span>
        </header>
        <div class="p-6 sm:p-8">
          <p class="text-sm text-soft">
            Gambar jalur dan perangkat yang benar-benar terpasang. Dipakai saat ada perluasan atau
            pelacakan gangguan.
          </p>
          <svg viewBox="0 0 400 220" class="mt-6 w-full" aria-hidden="true">
            <g fill="none" stroke="#0A0C0F" stroke-width="1.5">
              <rect x="10" y="10" width="170" height="110" />
              <rect x="180" y="10" width="120" height="110" />
              <rect x="10" y="120" width="290" height="90" />
              <line x1="110" y1="120" x2="110" y2="210" />
            </g>
            <path d="M30 190 H90 V60 H150 V40 H240 V100 H270" fill="none" stroke="#FFCE00" stroke-width="5" />
            <path d="M30 190 H90 V60 H150 V40 H240 V100 H270" fill="none" stroke="#0A0C0F" stroke-width="1.5" stroke-dasharray="6 4" />
            {[[30, 190], [90, 60], [240, 40], [270, 100]].map(([x, y]) => (
              <rect x={x - 5} y={y - 5} width="10" height="10" fill="#fff" stroke="#0A0C0F" stroke-width="1.5" />
            ))}
            <g>
              <rect x="310" y="140" width="84" height="70" fill="#fff" stroke="#0A0C0F" />
              <line x1="310" y1="160" x2="394" y2="160" stroke="#0A0C0F" />
              <text x="318" y="155" class="tb">ZSN</text>
              <text x="318" y="176" class="tb2">AS-BUILT</text>
              <text x="318" y="190" class="tb2">REV. 01</text>
              <text x="318" y="204" class="tb2">SKALA 1:100</text>
            </g>
          </svg>
        </div>
      </article>

      <!-- 03 Dokumentasi foto (foto asli) -->
      <article class="sheet lg:col-span-5" data-reveal>
        <header class="sheet-head">
          <span class="label-tech">03 · Dokumentasi foto</span>
          <span class="label-tech text-soft">Foto asli lapangan</span>
        </header>
        <div class="grid grid-cols-2 gap-1.5 p-1.5">
          {
            foto.map((p) => (
              <Image
                src={p.data.cover}
                alt={p.data.coverAlt}
                width={360}
                widths={[240, 360]}
                sizes="(min-width:1024px) 18vw, 45vw"
                class="aspect-square w-full object-cover"
                loading="lazy"
              />
            ))
          }
        </div>
      </article>

      <!-- 04 Berita acara -->
      <article class="sheet lg:col-span-7" data-reveal style="--d:100ms">
        <header class="sheet-head">
          <span class="label-tech">04 · Berita acara serah terima</span>
          <span class="label-tech text-soft">Semua layanan</span>
        </header>
        <div class="grid gap-8 p-6 sm:grid-cols-2 sm:items-center sm:p-8">
          <p class="text-sm text-soft">
            Ditandatangani kedua pihak. Mencatat lingkup yang sudah selesai dan ketentuan garansinya,
            supaya jelas apa yang sudah diserahkan.
          </p>
          <div class="relative mx-auto w-full max-w-72 rotate-2 border border-strong bg-canvas p-5 shadow-[6px_6px_0_0_var(--color-volt)] transition-transform duration-500 hover:rotate-0" aria-hidden="true">
            <p class="label-tech text-[0.55rem] text-strong">Berita acara serah terima</p>
            <div class="mt-3 space-y-1.5">
              <div class="h-1.5 w-full bg-strong/15"></div>
              <div class="h-1.5 w-5/6 bg-strong/15"></div>
              <div class="h-1.5 w-4/6 bg-strong/15"></div>
              <div class="h-1.5 w-full bg-strong/15"></div>
            </div>
            <div class="mt-6 grid grid-cols-2 gap-4 text-[0.55rem] text-soft">
              <div><div class="h-6"></div><div class="h-px bg-strong/50"></div><p class="mt-1">Pihak klien</p></div>
              <div><div class="h-6"></div><div class="h-px bg-strong/50"></div><p class="mt-1">ZSN</p></div>
            </div>
          </div>
        </div>
      </article>
    </div>

    <p class="mt-6 text-xs text-soft" data-reveal>
      Gambar dokumen 01, 02, dan 04 adalah ilustrasi format. Foto pada 03 adalah foto asli pekerjaan ZSN.
    </p>
  </div>
</section>

<style>
  .sheet {
    background: var(--color-canvas);
    border: 1px solid var(--color-strong);
    overflow: hidden;
  }
  .sheet-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--color-strong);
    background: var(--color-raised);
    color: var(--color-strong);
  }
  .ax { font: 500 11px var(--font-mono); fill: #5e646e; }
  .ev { font: 500 10px var(--font-mono); fill: #0a0c0f; letter-spacing: 0.06em; text-transform: uppercase; }
  .tb { font: 800 12px var(--font-display); fill: #0a0c0f; }
  .tb2 { font: 500 8px var(--font-mono); fill: #5e646e; letter-spacing: 0.1em; }
  .trace {
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    transition: stroke-dashoffset 2.4s var(--ease-snap) 0.2s;
  }
  :global(.is-in) .trace,
  :global(html:not(.js)) .trace {
    stroke-dashoffset: 0;
  }
</style>
