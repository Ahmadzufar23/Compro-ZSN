---
/**
 * Proof: apa yang benar-benar diterima klien di akhir pekerjaan.
 * Visual dokumen digambar ulang sebagai ilustrasi, bukan data proyek
 * nyata, jadi tidak ada angka hasil ukur yang ditampilkan.
 */
import { Image } from 'astro:assets';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import rackFoto from '@/assets/project/proj-6.jpg';
---

<section class="relative bg-ink py-24 lg:py-32" aria-labelledby="bukti-title">
  <div class="container-content">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <Eyebrow index="05" data-reveal>Yang Anda terima</Eyebrow>
        <h2 id="bukti-title" class="mt-6 text-h1" data-reveal>
          Bukti, <span class="text-fog">bukan janji.</span>
        </h2>
      </div>
      <p class="max-w-md text-lg text-fog lg:col-span-4" data-reveal>
        Pekerjaan jaringan yang baik terlihat dari dokumennya. Ini yang kami serahkan di akhir
        setiap proyek.
      </p>
    </div>

    <div class="mt-14 grid gap-4 lg:mt-20 lg:grid-cols-12">
      <!-- OTDR -->
      <article class="panel group relative overflow-hidden p-6 sm:p-8 lg:col-span-7" data-reveal>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="label-tech text-volt">Dokumen 01</p>
            <h3 class="mt-3 text-h3">Laporan uji OTDR</h3>
            <p class="mt-2 max-w-md text-sm text-fog">
              Grafik redaman sepanjang jalur fiber. Setiap sambungan dan konektor terlihat, jadi
              kualitas jalur bisa diperiksa, bukan dipercaya begitu saja.
            </p>
          </div>
          <span class="label-tech hidden shrink-0 border border-line px-2 py-1 text-[0.6rem] text-fog sm:inline">PDF · per jalur</span>
        </div>
        <svg viewBox="0 0 640 240" class="mt-8 w-full" aria-hidden="true">
          <g stroke="rgba(255,255,255,.07)">
            {[0, 1, 2, 3, 4].map((i) => <line x1="40" x2="630" y1={20 + i * 50} y2={20 + i * 50} />)}
            {[0, 1, 2, 3, 4, 5, 6].map((i) => <line y1="20" y2="220" x1={40 + i * 98} x2={40 + i * 98} />)}
          </g>
          <text x="0" y="28" class="ax">dB</text>
          <text x="600" y="238" class="ax">km</text>
          <path
            d="M40 30 L60 36 L62 26 L66 48 L180 72 L184 80 L300 102 L304 96 L308 112 L430 134 L434 142 L560 166 L564 150 L570 212 L630 214"
            fill="none"
            stroke="#FFCE00"
            stroke-width="2.5"
            class="trace"
          />
          {[[184, 80, 'Splice'], [308, 112, 'Konektor'], [434, 142, 'Splice'], [564, 150, 'Ujung']].map(([x, y, l]) => (
            <g>
              <line x1={x} x2={x} y1={Number(y) - 14} y2={Number(y) - 40} stroke="rgba(255,206,0,.6)" stroke-dasharray="2 3" />
              <text x={Number(x) - 4} y={Number(y) - 46} class="ev">{l}</text>
            </g>
          ))}
        </svg>
      </article>

      <!-- As-built -->
      <article class="panel group relative overflow-hidden p-6 sm:p-8 lg:col-span-5" data-reveal style="--d:100ms">
        <p class="label-tech text-volt">Dokumen 02</p>
        <h3 class="mt-3 text-h3">As-built drawing</h3>
        <p class="mt-2 text-sm text-fog">
          Gambar jalur yang benar-benar terpasang, bukan rencana awal. Penting saat ada perluasan
          atau gangguan di kemudian hari.
        </p>
        <svg viewBox="0 0 400 230" class="mt-8 w-full" aria-hidden="true">
          <rect x="1" y="1" width="398" height="228" fill="none" stroke="rgba(255,255,255,.15)" />
          <g fill="none" stroke="rgba(255,255,255,.28)">
            <rect x="20" y="20" width="160" height="110" />
            <rect x="180" y="20" width="120" height="110" />
            <rect x="20" y="130" width="280" height="80" />
            <line x1="120" y1="130" x2="120" y2="210" />
          </g>
          <path d="M40 190 H100 V60 H160 V40 H250 V100 H280" fill="none" stroke="#FFCE00" stroke-width="2" stroke-dasharray="6 4" />
          {[[40, 190], [100, 60], [250, 40], [280, 100]].map(([x, y]) => (
            <rect x={x - 4} y={y - 4} width="8" height="8" fill="#FFCE00" />
          ))}
          <g>
            <rect x="310" y="150" width="80" height="70" fill="rgba(255,255,255,.03)" stroke="rgba(255,255,255,.2)" />
            <text x="318" y="168" class="tb">ZSN</text>
            <text x="318" y="186" class="tb2">AS-BUILT</text>
            <text x="318" y="200" class="tb2">REV.01</text>
            <text x="318" y="214" class="tb2">SKALA 1:100</text>
          </g>
        </svg>
      </article>

      <!-- Foto rack -->
      <article class="group relative min-h-80 overflow-hidden lg:col-span-5" data-reveal>
        <Image
          src={rackFoto}
          alt="Patch panel di dalam rack dengan kabel berwarna yang tertata dan setiap port diberi label"
          width={800}
          widths={[480, 800]}
          sizes="(min-width:1024px) 40vw, 100vw"
          class="absolute inset-0 size-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent" aria-hidden="true"></div>
        <div class="relative flex h-full min-h-80 flex-col justify-end p-6 sm:p-8">
          <p class="label-tech text-volt">Hasil 03</p>
          <h3 class="mt-3 text-h3">Rack rapi, setiap port berlabel</h3>
          <p class="mt-2 max-w-sm text-sm text-mist">
            Teknisi berikutnya, siapa pun dia, bisa langsung tahu kabel mana menuju ke mana.
          </p>
        </div>
      </article>

      <!-- BAST -->
      <article class="panel relative overflow-hidden p-6 sm:p-8 lg:col-span-7" data-reveal style="--d:100ms">
        <div class="grid gap-8 sm:grid-cols-2 sm:items-center">
          <div>
            <p class="label-tech text-volt">Dokumen 04</p>
            <h3 class="mt-3 text-h3">Berita acara & garansi</h3>
            <p class="mt-2 text-sm text-fog">
              Serah terima resmi yang ditandatangani kedua pihak, lengkap dengan lingkup pekerjaan
              dan ketentuan garansinya. Jelas apa yang sudah selesai dan apa yang dijamin.
            </p>
          </div>
          <div class="doc relative mx-auto w-full max-w-72 rotate-2 bg-paper p-5 text-ink shadow-2xl shadow-black/60 transition-transform duration-500 hover:rotate-0" aria-hidden="true">
            <p class="label-tech text-[0.55rem]">Berita acara serah terima</p>
            <div class="mt-3 space-y-1.5">
              <div class="h-1.5 w-full bg-ink/15"></div>
              <div class="h-1.5 w-5/6 bg-ink/15"></div>
              <div class="h-1.5 w-4/6 bg-ink/15"></div>
              <div class="h-1.5 w-full bg-ink/15"></div>
              <div class="h-1.5 w-3/6 bg-ink/15"></div>
            </div>
            <div class="mt-6 grid grid-cols-2 gap-4">
              <div>
                <svg viewBox="0 0 80 24" class="h-6 w-full" aria-hidden="true"><path d="M2 18 C12 2 18 22 28 10 S44 4 50 16 66 8 78 12" fill="none" stroke="#0A0C0F" stroke-width="1.5" /></svg>
                <div class="h-px bg-ink/40"></div>
                <p class="mt-1 text-[0.55rem]">Klien</p>
              </div>
              <div class="relative">
                <svg viewBox="0 0 80 24" class="h-6 w-full" aria-hidden="true"><path d="M2 14 C14 22 20 2 34 14 S58 20 78 6" fill="none" stroke="#0A0C0F" stroke-width="1.5" /></svg>
                <div class="h-px bg-ink/40"></div>
                <p class="mt-1 text-[0.55rem]">ZSN</p>
                <span class="absolute -right-2 -top-5 flex size-12 -rotate-12 items-center justify-center rounded-full border-2 border-volt-deep text-[0.5rem] font-bold text-volt-deep">ZSN</span>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .ax { font: 500 11px var(--font-mono); fill: var(--color-fog); }
  .ev { font: 500 10px var(--font-mono); fill: var(--color-volt); letter-spacing: 0.08em; text-transform: uppercase; }
  .tb { font: 800 13px var(--font-display); fill: var(--color-volt); }
  .tb2 { font: 500 8px var(--font-mono); fill: var(--color-fog); letter-spacing: 0.1em; }
  .trace {
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    filter: drop-shadow(0 0 6px rgb(255 206 0 / 0.6));
    transition: stroke-dashoffset 2.4s var(--ease-snap) 0.2s;
  }
  :global(.is-in) .trace,
  :global(html:not(.js)) .trace {
    stroke-dashoffset: 0;
  }
</style>
