---
import Button from '@/components/ui/Button.astro';
import { site, waLink } from '@/config/site';

interface Props {
  judul?: string;
  sub?: string;
  pesan?: string;
  label?: string;
}
const {
  judul = 'Punya lokasi yang perlu disurvei?',
  sub = 'Kirim alamat dan gambaran kebutuhan lewat WhatsApp. Kami atur jadwal survei bersama Anda.',
  pesan = 'Halo ZSN, saya ingin meminta survei lokasi.',
  label = 'Jadwalkan Survei',
} = Astro.props;
---

<section class="relative isolate overflow-hidden bg-volt text-ink" aria-labelledby="cta-title">
  <svg viewBox="0 0 200 280" class="pointer-events-none absolute -right-10 -top-16 -z-10 h-[140%] opacity-[0.09] lg:right-10" aria-hidden="true">
    <path d="M130 0 0 160h80l-20 120L200 110h-85z" fill="#0A0C0F" />
  </svg>
  <div class="hazard h-3 w-full" aria-hidden="true"></div>

  <div class="container-content py-20 lg:py-28">
    <p class="label-tech flex items-center gap-3 text-ink" data-reveal>
      <span class="inline-block size-2 bg-ink" aria-hidden="true"></span>
      Langkah berikutnya
    </p>
    <h2 id="cta-title" class="mt-6 max-w-5xl text-mega !text-ink" style="font-stretch:118%;line-height:.94" data-reveal>
      {judul}
    </h2>
    <div class="mt-12 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between" data-reveal>
      <p class="max-w-lg text-lg font-medium text-ink">{sub}</p>
      <div class="flex flex-wrap gap-3">
        <a
          href={waLink(pesan)}
          target="_blank"
          rel="noopener noreferrer"
          class="cut-z inline-flex min-h-14 items-center gap-4 bg-ink px-7 font-semibold text-snow transition-opacity hover:opacity-90"
        >
          {label}
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
        </a>
        <Button href={`mailto:${site.email}`} variant="on-volt" size="lg" icon="lucide:mail">Kirim email</Button>
      </div>
    </div>
  </div>
</section>
