---
/**
 * StackLayers: empat lapisan infrastruktur digambar isometrik dengan gaya
 * gambar teknik (garis tinta di atas kertas), ditembus satu petir dari
 * kabel paling bawah sampai aplikasi paling atas. Arahkan kursor ke
 * daftar di samping untuk menyorot lapisannya.
 */
import Eyebrow from '@/components/ui/Eyebrow.astro';

const layers = [
  { n: 4, kode: 'SW', judul: 'Aplikasi', detail: 'Dashboard pemantauan, sistem inventaris, dan portal pelaporan.', href: '/products/software' },
  { n: 3, kode: 'CV', judul: 'Keamanan', detail: 'Kamera, perekam NVR/DVR, dan akses pantau jarak jauh.', href: '/services/cctv' },
  { n: 2, kode: 'NW', judul: 'Jaringan', detail: 'Rack, switch, router, VLAN, dan access point.', href: '/services/network' },
  { n: 1, kode: 'FO', judul: 'Fisik', detail: 'Kabel fiber optik dan UTP, fusion splicing, terminasi, uji OTDR.', href: '/services/fiber-optic' },
];

const TY: Record<number, number> = { 4: 20, 3: 160, 2: 300, 1: 440 };
const iso = (ty: number) => `matrix(1 .5 -1 .5 300 ${ty})`;
const T = 14; // tebal pelat
const bolt = `300,${TY[1] + 110} 278,480 322,410 280,340 320,270 284,200 300,${TY[4] + 110}`;
const INK = '#0A0C0F';
---

<section class="stack relative overflow-hidden bg-canvas py-24 lg:py-32" aria-labelledby="stack-title">
  <div class="bg-grid mask-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="container-content relative grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div>
      <Eyebrow data-reveal>Cakupan pekerjaan</Eyebrow>
      <h2 id="stack-title" class="mt-6 text-h1" data-reveal>
        Dari kabel sampai <span class="volt-mark">dashboard.</span>
      </h2>
      <p class="mt-6 max-w-lg text-lg" data-reveal>
        Setiap sistem digital bergantung pada kabel dan perangkat di bawahnya. Kami mengerjakan
        keempat lapisan ini, jadi saat ada gangguan Anda cukup menghubungi satu pihak.
      </p>

      <ol class="mt-10 border-t border-strong">
        {
          layers.map((l) => (
            <li data-reveal>
              <a href={l.href} data-l={l.n} class="layer-item group flex gap-5 border-b border-rule py-5 transition-colors">
                <span class="label-tech mt-1.5 w-8 shrink-0 text-soft">L{l.n}</span>
                <span class="flex-1">
                  <span class="flex items-baseline justify-between gap-3">
                    <span class="font-display text-xl font-extrabold text-strong" style="font-stretch:110%">{l.judul}</span>
                    <span class="label-tech text-[0.6rem] text-soft">ZSN/{l.kode}</span>
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-soft">{l.detail}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 text-sm text-soft" data-reveal>
        <a href="/services/maintenance" class="font-semibold text-strong underline decoration-volt decoration-2 underline-offset-4">Pemeliharaan</a>
        menjaga keempat lapisan tetap berjalan setelah serah terima.
      </p>
    </div>

    <div class="relative mx-auto w-full max-w-[540px]" data-reveal>
      <svg viewBox="0 0 600 690" class="w-full" role="img" aria-label="Diagram empat lapisan infrastruktur: fisik, jaringan, keamanan, aplikasi">
        {[80, 300, 520].map((x) => (
          <line x1={x} y1={TY[4] + 110} x2={x} y2={TY[1] + 110} stroke="rgba(10,12,15,.25)" stroke-dasharray="3 6" />
        ))}

        {
          [1, 2, 3, 4].map((n) => {
            const ty = TY[n];
            return (
              <g class={`plate plate-${n}`}>
                <polygon points={`80,${ty + 110} 300,${ty + 220} 300,${ty + 220 + T} 80,${ty + 110 + T}`} class="side-l" />
                <polygon points={`300,${ty + 220} 520,${ty + 110} 520,${ty + 110 + T} 300,${ty + 220 + T}`} class="side-r" />
                <g transform={iso(ty)}>
                  <rect width="220" height="220" class="face" />
                  <rect x="8" y="8" width="204" height="204" fill="none" stroke="rgba(10,12,15,.12)" />

                  {n === 1 && (
                    <g fill="none" stroke-width="2">
                      <path d="M0 60 H70 L90 80 H220" stroke={INK} />
                      <path d="M0 130 H120 L140 150 H220" stroke="rgba(10,12,15,.45)" />
                      <path d="M60 220 V170 L80 150 V0" stroke="rgba(10,12,15,.3)" />
                      <path d="M170 220 V120 L150 100 V0" stroke={INK} />
                      <circle cx="90" cy="80" r="5" fill="#FFCE00" stroke={INK} />
                      <circle cx="140" cy="150" r="5" fill="#fff" stroke={INK} />
                      <circle cx="150" cy="100" r="5" fill="#FFCE00" stroke={INK} />
                    </g>
                  )}
                  {n === 2 && (
                    <g>
                      {[0, 1, 2].map((r) => (
                        <g transform={`translate(${24 + r * 64} 30)`}>
                          <rect width="44" height="150" fill="#fff" stroke={INK} stroke-width="1.5" />
                          {[0, 1, 2, 3, 4, 5, 6].map((p) => (
                            <rect x="8" y={10 + p * 19} width="28" height="9" fill={p === 2 && r === 1 ? '#FFCE00' : 'rgba(10,12,15,.14)'} stroke={p === 2 && r === 1 ? INK : 'none'} />
                          ))}
                        </g>
                      ))}
                      <path d="M46 195 H174" stroke={INK} stroke-width="2" />
                    </g>
                  )}
                  {n === 3 && (
                    <g>
                      {[[40, 40], [180, 50], [60, 170], [170, 175]].map(([x, y], k) => (
                        <g>
                          <path
                            d={`M${x} ${y} L${x + (x < 110 ? 70 : -70)} ${y + (y < 110 ? 30 : -30)} L${x + (x < 110 ? 40 : -40)} ${y + (y < 110 ? 70 : -70)} Z`}
                            fill={k === 1 ? 'rgba(255,206,0,.55)' : 'rgba(10,12,15,.07)'}
                            stroke={k === 1 ? INK : 'rgba(10,12,15,.25)'}
                          />
                          <rect x={x - 7} y={y - 7} width="14" height="14" fill="#fff" stroke={INK} stroke-width="1.5" />
                        </g>
                      ))}
                    </g>
                  )}
                  {n === 4 && (
                    <g stroke={INK} stroke-width="1.5">
                      <rect x="20" y="20" width="80" height="54" fill="#FFCE00" />
                      <rect x="110" y="20" width="90" height="54" fill="#fff" />
                      <rect x="20" y="84" width="180" height="62" fill="#fff" />
                      <polyline points="30,132 60,110 90,120 120,96 150,104 190,92" fill="none" stroke-width="2.5" />
                      <rect x="20" y="156" width="85" height="44" fill="#fff" />
                      <rect x="115" y="156" width="85" height="44" fill="#fff" />
                    </g>
                  )}
                </g>
                <text x="540" y={ty + 118} class="plate-label">L{n}</text>
              </g>
            );
          })
        }

        <!-- petir menembus keempat lapisan: kuning bertepi tinta supaya terbaca di kertas -->
        <polyline points={bolt} fill="none" stroke={INK} stroke-width="7" stroke-linejoin="miter" />
        <polyline points={bolt} fill="none" stroke="#FFCE00" stroke-width="3.5" stroke-linejoin="miter" />
        <polyline points={bolt} fill="none" stroke="#FFF6C8" stroke-width="3.5" class="flow-line" style="--flow-speed:3.5s" />
        {[1, 2, 3].map((n) => <rect x="295" y={TY[n] + 105} width="10" height="10" fill="#FFCE00" stroke={INK} stroke-width="1.5" />)}
        <circle cx="300" cy={TY[4] + 110} r="7" fill="#FFCE00" stroke={INK} stroke-width="2" />
        <circle cx="300" cy={TY[4] + 110} r="7" fill="none" stroke={INK} class="pulse-ring" />
      </svg>
    </div>
  </div>
</section>

<style>
  .face {
    fill: #ffffff;
    stroke: #0a0c0f;
    stroke-width: 1.5;
    transition: fill 0.4s;
  }
  .side-l { fill: #e9e7e0; stroke: #0a0c0f; stroke-width: 1.5; }
  .side-r { fill: #d9d6cc; stroke: #0a0c0f; stroke-width: 1.5; }
  .plate { transition: transform 0.5s var(--ease-snap), opacity 0.4s; }
  .plate-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.15em;
    fill: var(--color-soft);
  }
  .stack:has(.layer-item:hover) .plate { opacity: 0.35; }
  .stack:has([data-l='1']:hover) .plate-1,
  .stack:has([data-l='2']:hover) .plate-2,
  .stack:has([data-l='3']:hover) .plate-3,
  .stack:has([data-l='4']:hover) .plate-4 {
    opacity: 1;
    transform: translateY(-10px);
  }
  .stack:has([data-l='1']:hover) .plate-1 .face,
  .stack:has([data-l='2']:hover) .plate-2 .face,
  .stack:has([data-l='3']:hover) .plate-3 .face,
  .stack:has([data-l='4']:hover) .plate-4 .face {
    fill: #fff6cc;
  }
  .stack:has([data-l='1']:hover) .plate-1 .plate-label,
  .stack:has([data-l='2']:hover) .plate-2 .plate-label,
  .stack:has([data-l='3']:hover) .plate-3 .plate-label,
  .stack:has([data-l='4']:hover) .plate-4 .plate-label { fill: var(--color-strong); font-weight: 600; }
  .layer-item:hover { background: rgb(255 206 0 / 0.12); }
</style>
