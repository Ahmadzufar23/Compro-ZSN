---
/**
 * Coverage: peta skematik Jabodetabek ala peta jalur, bukan peta
 * geografis presisi. Pusat di kantor Jakarta Selatan.
 */
import { Icon } from 'astro-icon/components';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import { site } from '@/config/site';

const HQ = [300, 250];
const kota = [
  { n: 'Jakarta Utara', x: 300, y: 60, path: 'M300 250 V160 L330 130 V60' },
  { n: 'Tangerang', x: 70, y: 210, path: 'M300 250 H200 L160 210 H70' },
  { n: 'Bekasi', x: 530, y: 200, path: 'M300 250 H400 L450 200 H530' },
  { n: 'Depok', x: 270, y: 400, path: 'M300 250 V330 L270 360 V400' },
  { n: 'Bogor', x: 330, y: 520, path: 'M300 250 V330 L340 370 V520' },
  { n: 'Tangerang Selatan', x: 140, y: 360, path: 'M300 250 L240 310 H140 V360' },
];
const a = site.alamat;
---

<section class="relative overflow-hidden bg-ink py-24 lg:py-32" aria-labelledby="wilayah-title">
  <div class="container-content grid items-center gap-14 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <Eyebrow index="07" data-reveal>Wilayah kerja</Eyebrow>
      <h2 id="wilayah-title" class="mt-6 text-h1" data-reveal>
        Berbasis di Jakarta Selatan. <span class="text-fog">Bergerak ke seluruh Jabodetabek.</span>
      </h2>
      <p class="mt-6 text-lg text-fog" data-reveal>
        Tim lapangan kami berangkat dari Kebayoran Lama. Proyek di luar Jabodetabek tetap bisa
        dikerjakan, ceritakan lokasinya dan kita bahas logistiknya bersama.
      </p>

      <dl class="mt-10 space-y-5 border-t border-line pt-8" data-reveal>
        <div class="flex gap-4">
          <dt><Icon name="lucide:map-pin" class="size-5 text-volt" aria-label="Alamat" /></dt>
          <dd class="text-sm text-mist">
            {a.jalan}, {a.kelurahan}, {a.kecamatan}, {a.kota} {a.kodePos}
            <a href={site.maps.url} target="_blank" rel="noopener noreferrer" class="label-tech mt-2 flex min-h-8 items-center gap-1 text-volt hover:underline">
              Buka di Google Maps <Icon name="lucide:arrow-up-right" class="size-3.5" />
            </a>
          </dd>
        </div>
        <div class="flex gap-4">
          <dt><Icon name="lucide:clock" class="size-5 text-volt" aria-label="Jam operasional" /></dt>
          <dd class="text-sm text-mist">Senin sampai Sabtu, 08.00 sampai 17.00 WIB</dd>
        </div>
      </dl>
    </div>

    <div class="relative lg:col-span-7" data-reveal>
      <svg viewBox="0 0 600 580" class="w-full" role="img" aria-label="Peta skematik wilayah kerja ZSN: Jakarta, Tangerang, Bekasi, Depok, Bogor, dan Tangerang Selatan">
        <g stroke="rgba(255,255,255,.05)">
          {Array.from({ length: 13 }, (_, i) => <line x1={i * 50} x2={i * 50} y1="0" y2="580" />)}
          {Array.from({ length: 12 }, (_, i) => <line y1={i * 50} y2={i * 50} x1="0" x2="600" />)}
        </g>
        <circle cx={HQ[0]} cy={HQ[1]} r="210" fill="none" stroke="rgba(255,206,0,.12)" stroke-dasharray="4 8" />
        <circle cx={HQ[0]} cy={HQ[1]} r="120" fill="none" stroke="rgba(255,206,0,.08)" stroke-dasharray="4 8" />

        {kota.map((k) => <path d={k.path} fill="none" stroke="rgba(255,255,255,.18)" stroke-width="6" stroke-linejoin="round" />)}
        {
          kota.map((k, i) => (
            <path
              d={k.path}
              fill="none"
              stroke="#FFCE00"
              stroke-width="3"
              stroke-linejoin="round"
              class="flow-line"
              style={`--flow-speed:${5 + i}s;animation-delay:-${i * 1.3}s`}
            />
          ))
        }
        {
          kota.map((k) => (
            <g>
              <circle cx={k.x} cy={k.y} r="9" fill="#0A0C0F" stroke="#F4F4F2" stroke-width="3" />
              <text
                x={k.x}
                y={k.y + (k.y > 300 ? 30 : -20)}
                text-anchor="middle"
                class="city"
              >
                {k.n}
              </text>
            </g>
          ))
        }
        <g>
          <circle cx={HQ[0]} cy={HQ[1]} r="14" fill="none" stroke="#FFCE00" stroke-width="2" class="pulse-ring" />
          <rect x={HQ[0] - 16} y={HQ[1] - 16} width="32" height="32" fill="#FFCE00" transform={`rotate(45 ${HQ[0]} ${HQ[1]})`} />
          <path d={`M${HQ[0] + 2} ${HQ[1] - 10} l-8 11 h6 l-2 9 l9 -12 h-6 z`} fill="#0A0C0F" />
          <rect x={HQ[0] + 26} y={HQ[1] + 8} width="128" height="40" fill="#0A0C0F" stroke="#FFCE00" />
          <text x={HQ[0] + 36} y={HQ[1] + 25} class="hq">KANTOR ZSN</text>
          <text x={HQ[0] + 36} y={HQ[1] + 40} class="hq2">JAKARTA SELATAN</text>
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .city { font: 500 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; fill: var(--color-mist); }
  .hq { font: 800 13px var(--font-display); fill: var(--color-volt); letter-spacing: 0.04em; }
  .hq2 { font: 500 9px var(--font-mono); fill: var(--color-fog); letter-spacing: 0.14em; }
</style>
