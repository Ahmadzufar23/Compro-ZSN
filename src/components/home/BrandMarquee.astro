---
/**
 * BrandMarquee — animasi CSS murni, 0 KB JavaScript.
 *
 * Sebelumnya dispesifikasikan sebagai React island. Itu keliru:
 * menggeser deretan logo tidak butuh state, event, maupun hydration.
 * Versi ini menghapus ~61 KB runtime React dari homepage.
 *
 * PENTING: heading tidak boleh menyebut "Mitra". ZSN menangani
 * perangkat merek-merek ini, tetapi bukan partner resmi mereka.
 */
const merek = [
  'HIKVISION',
  'DAHUA',
  'MIKROTIK',
  'UBIQUITI',
  'CISCO',
  'TP-LINK',
  'RUIJIE',
  'FORTINET',
  'UNV',
  'EZVIZ',
];

/* Digandakan agar loop terlihat menyambung tanpa jeda */
const track = [...merek, ...merek];
---

<section class="bg-canvas py-16 md:py-20" aria-labelledby="perangkat-judul">
  <div class="container-content text-center">
    <p class="label-tech text-muted">Perangkat</p>
    <h2 id="perangkat-judul" class="mt-3 text-h2">
      Perangkat yang kami tangani
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-muted">
      Kami menangani instalasi dan konfigurasi perangkat dari berbagai merek,
      disesuaikan dengan kebutuhan dan anggaran Anda.
    </p>
  </div>

  <div class="marquee mt-12 border-y border-hairline py-8">
    <ul class="marquee__track" aria-hidden="true">
      {
        track.map((nama) => (
          <li class="font-display text-xl font-bold tracking-wide text-subtle md:text-2xl">
            {nama}
          </li>
        ))
      }
    </ul>

    {/* Daftar sebenarnya untuk pembaca layar — track di atas disembunyikan */}
    <ul class="sr-only">
      {merek.map((nama) => <li>{nama}</li>)}
    </ul>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    /* Fade mask kiri-kanan, menandakan gulungan berlanjut */
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  .marquee__track {
    display: flex;
    width: max-content;
    gap: 4rem;
    padding-inline: 2rem;
    animation: marquee-scroll 45s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* -50% karena daftar digandakan tepat dua kali */
      transform: translateX(-50%);
    }
  }

  /* Shorthand `animation: none` me-reset nama animasi, sehingga
     aturan !important global tidak lagi relevan. Deretan logo
     tetap tampil, hanya berhenti. */
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
      transform: none;
    }
    .marquee {
      overflow-x: auto;
    }
  }
</style>