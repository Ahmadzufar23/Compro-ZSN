---
/**
 * ServiceIcon — simbol teknis per layanan, menggantikan ikon generik
 * (gembok, awan, roda gigi, grafik naik dilarang di spec).
 */
interface Props {
  type: 'konektor' | 'kamera' | 'patch-panel' | 'cable-tester';
  class?: string;
}
const { type, class: extra = 'size-8' } = Astro.props;
---

{
  type === 'konektor' && (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" class={extra} aria-hidden="true">
      <rect x="4" y="13" width="14" height="6" rx="1" />
      <path d="M18 14h4v4h-4M22 15h6M22 17h4" />
      <circle cx="7" cy="16" r="1" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  type === 'kamera' && (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" class={extra} aria-hidden="true">
      <rect x="4" y="11" width="18" height="12" rx="1.5" />
      <path d="M22 15l6-3v10l-6-3" />
      <circle cx="13" cy="17" r="3.2" />
    </svg>
  )
}
{
  type === 'patch-panel' && (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" class={extra} aria-hidden="true">
      <rect x="4" y="9" width="24" height="14" rx="1" />
      <path d="M8 14v4M13 14v4M18 14v4M23 14v4" />
    </svg>
  )
}
{
  type === 'cable-tester' && (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" class={extra} aria-hidden="true">
      <rect x="6" y="6" width="14" height="18" rx="1.5" />
      <path d="M9 11h8M9 15h8M9 19h5" />
      <path d="M20 12h6M20 18h6" />
    </svg>
  )
}
