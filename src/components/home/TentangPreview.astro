---
/**
 * TentangPreview — ringkasan halaman /tentang di beranda, jadi anchor
 * navigasi #tentang punya isi nyata, bukan cuma jalan pintas kosong.
 * Paragraf dan blok "Kenapa ZSN" mengambil pola yang sama dengan
 * src/pages/tentang.astro, disingkat untuk konteks beranda.
 */
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';

/* Data legalitas (akta, NIB, NPWP) tidak ditampilkan di halaman
   publik mana pun (keputusan pemilik) — lihat CLAUDE.md bagian
   "Klaim yang DILARANG muncul di konten". */
const kenapaZsn = [
  { judul: 'Solusi Terintegrasi', detail: 'Keahlian infrastruktur fisik dan pengembangan software berada di bawah satu atap, memastikan eksekusi proyek yang mulus dan terarah.' },
  { judul: 'Standar Industri & Dokumentasi', detail: 'Setiap serah terima pekerjaan dilengkapi dengan As-Built Drawing dan laporan hasil uji teknis yang transparan.' },
  { judul: 'Garansi & Pemeliharaan', detail: 'Jaminan perbaikan dan pendampingan pasca-instalasi (maintenance) untuk memastikan operasional Anda berjalan tanpa henti.' },
];
---

<Section bg="surface" size="md" id="tentang" aria-label="Tentang">
  <p class="label-tech text-muted">TENTANG ZSN</p>
  <h2 class="mt-4 text-h2">Mitra Strategis untuk Infrastruktur & Digitalisasi Bisnis</h2>

  <div class="mt-8 grid gap-10 lg:grid-cols-[1.3fr_0.7fr]">
    <div class="max-w-[60ch]">
      <p class="text-muted">
        PT Zufar Solusi Nawasena (ZSN) adalah penyedia layanan IT terintegrasi yang berfokus pada penguatan infrastruktur jaringan dan pengembangan sistem digital. Kami hadir untuk memastikan bisnis Anda di berbagai kota di Indonesia memiliki pondasi teknologi yang solid.
      </p>
      <p class="mt-4 text-muted">
        Sebagai mitra end-to-end, kami menjembatani kebutuhan perangkat keras dan perangkat lunak Anda. Mulai dari survei teknis, instalasi fiber optic dan CCTV, hingga pengembangan aplikasi operasional custom, kami merancang solusi agar roda bisnis Anda berjalan efisien, aman, dan terhubung tanpa hambatan.
      </p>
      <Button href="/tentang" variant="outline-dark" class="mt-6">
        Selengkapnya tentang ZSN
      </Button>
    </div>

    <div class="grid grid-cols-1 gap-6 border-t border-hairline pt-6 sm:grid-cols-3 lg:grid-cols-1 lg:border-t-0 lg:pt-0">
      {
        kenapaZsn.map((k) => (
          <div class="border-l border-hairline pl-4">
            <h3 class="text-sm font-semibold text-ink">{k.judul}</h3>
            <p class="mt-1 text-sm text-muted">{k.detail}</p>
          </div>
        ))
      }
    </div>
  </div>
</Section>
