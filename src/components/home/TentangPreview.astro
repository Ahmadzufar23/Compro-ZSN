---
/**
 * TentangPreview — ringkasan halaman /tentang di beranda, jadi anchor
 * navigasi #tentang punya isi nyata, bukan cuma jalan pintas kosong.
 * Paragraf dan blok "Kenapa ZSN" mengambil pola yang sama dengan
 * src/pages/tentang.astro, disingkat untuk konteks beranda.
 */
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';

/* Data legalitas (akta, NIB, NPWP) tidak ditampilkan di halaman
   publik mana pun (keputusan pemilik) — lihat CLAUDE.md bagian
   "Klaim yang DILARANG muncul di konten". */
const kenapaZsn = [
  { judul: 'Integrated Solutions', detail: 'Physical infrastructure and software developed under one roof for seamless execution.' },
  { judul: 'Standards & Documentation', detail: 'Transparent handover, complete with As-Built Drawings and technical test reports.' },
  { judul: 'Warranty & Maintenance', detail: 'Post-installation maintenance support to keep your operations running non-stop.' },
];
---

<Section bg="surface" size="md" id="about" aria-label="About">
  <div class="lg:grid lg:grid-cols-12 lg:gap-16 lg:items-start">
    
    <!-- Kolom Kiri: Judul & Paragraf (Lebih tinggi sehingga seimbang) -->
    <div class="lg:col-span-6 xl:col-span-5 mb-12 lg:mb-0 flex flex-col items-start">
      <p class="label-tech text-muted mb-4 uppercase tracking-widest text-xs">About ZSN</p>
      <h2 class="text-h2 md:text-4xl font-semibold leading-tight text-ink mb-6">
        Your Strategic Partner for Infrastructure & Business Digitalization
      </h2>
      <p class="text-muted leading-relaxed mb-8">
        PT Zufar Solusi Nawasena (ZSN) is an end-to-end IT service provider. We bridge the gap between physical infrastructure and digital systems to ensure your business operations run efficiently, securely, and seamlessly connected.
      </p>
      <Button href="/about" variant="outline-dark">
        More about ZSN
      </Button>
    </div>

    <!-- Kolom Kanan: 3 Poin Keunggulan -->
    <div class="lg:col-span-6 xl:col-span-6 xl:col-start-7">
      <div class="grid gap-8 sm:grid-cols-3 lg:grid-cols-1">
        {
          kenapaZsn.map((k, i) => (
            <div 
              class="animate-tentang-item opacity-0 translate-y-6 relative pl-6 before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[2px] before:bg-hairline hover:before:bg-yellow before:transition-colors"
              style={`animation-delay: ${i * 150}ms;`}
            >
              <h3 class="text-base font-semibold text-ink mb-2">{k.judul}</h3>
              <p class="text-sm text-muted leading-relaxed">{k.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
    
  </div>
</Section>

<script>
  import { animate, inView, stagger } from "motion";

  const setupTentangAnimations = () => {
    const section = document.querySelector('#about');
    const items = document.querySelectorAll('.animate-tentang-item');

    if (section && items.length > 0) {
      inView(section, () => {
        animate(
          items,
          { opacity: 1, y: 0, transform: "none" },
          { duration: 0.6, delay: stagger(0.15) }
        );
      }, { margin: "-100px" });
    }
  };

  document.addEventListener('astro:page-load', setupTentangAnimations);
</script>
