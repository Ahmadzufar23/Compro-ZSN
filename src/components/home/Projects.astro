---
import { getCollection } from 'astro:content';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import ProjectCard from '@/components/project/ProjectCard.astro';

const semua = (await getCollection('project')).sort(
  (a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf()
);
const [utama, ...lain] = semua;
const sisi = lain.slice(0, 4);
---

<section class="relative overflow-hidden bg-carbon py-24 lg:py-32" aria-labelledby="proyek-title">
  <div class="container-content">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <Eyebrow index="06" data-reveal>Dari lapangan</Eyebrow>
        <h2 id="proyek-title" class="mt-6 max-w-3xl text-h1" data-reveal>
          Pekerjaan nyata, <span class="text-fog">dengan kode proyeknya.</span>
        </h2>
      </div>
      <div data-reveal>
        <Button href="/portfolio" variant="ghost" icon="lucide:arrow-right">Semua proyek</Button>
      </div>
    </div>

    <div class="mt-14 grid auto-rows-[18rem] gap-4 sm:grid-cols-2 lg:mt-20 lg:grid-cols-12 lg:auto-rows-[15rem]">
      {utama && <ProjectCard entry={utama} size="lg" class="sm:col-span-2 lg:col-span-7 lg:row-span-2" data-reveal />}
      {
        sisi.map((p, i) => (
          <ProjectCard
            entry={p}
            class:list={[
              i === 0 && 'lg:col-span-5',
              i === 1 && 'lg:col-span-5',
              i === 2 && 'lg:col-span-5',
              i === 3 && 'lg:col-span-7',
            ]}
            data-reveal
            style={`--d:${(i + 1) * 80}ms`}
          />
        ))
      }
    </div>
  </div>
</section>
