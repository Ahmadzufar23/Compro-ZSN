---
import { getCollection } from 'astro:content';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import ProjectCard from '@/components/project/ProjectCard.astro';

const semua = (await getCollection('project')).sort(
  (a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf()
);
const [utama, ...lain] = semua;
const sisi = lain.slice(0, 4);
const spans = ['lg:col-span-5', 'lg:col-span-5', 'lg:col-span-5', 'lg:col-span-7'];
---

<section class="relative overflow-hidden bg-raised py-24 lg:py-32" aria-labelledby="proyek-title">
  <div class="container-content">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <Eyebrow data-reveal>Proyek</Eyebrow>
        <h2 id="proyek-title" class="mt-6 max-w-3xl text-h1" data-reveal>Pekerjaan terbaru di lapangan.</h2>
        <p class="mt-5 max-w-xl text-lg" data-reveal>
          Apartemen, gedung, dan kawasan industri di Jakarta, Depok, dan Bekasi. Setiap proyek
          tercatat dengan kode proyeknya.
        </p>
      </div>
      <div data-reveal>
        <Button href="/portfolio" variant="ghost" icon="lucide:arrow-right">Semua proyek</Button>
      </div>
    </div>

    <div class="mt-14 grid auto-rows-[18rem] gap-4 sm:grid-cols-2 lg:mt-20 lg:grid-cols-12 lg:auto-rows-[15rem]">
      {utama && <ProjectCard entry={utama} size="lg" class="sm:col-span-2 lg:col-span-7 lg:row-span-2" data-reveal />}
      {sisi.map((p, i) => <ProjectCard entry={p} class={spans[i]} data-reveal style={`--d:${(i + 1) * 80}ms`} />)}
    </div>
  </div>
</section>
