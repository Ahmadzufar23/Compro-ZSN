---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import { services } from '@/config/services';

const semua = [...(await getCollection('layanan')), ...(await getCollection('produk'))];
const rows = services.map((s) => ({ ...s, data: semua.find((e) => e.id.endsWith(s.slug))?.data }));
---

<section class="relative overflow-hidden bg-raised py-24 lg:py-32" aria-labelledby="layanan-title">
  <div class="container-content">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <Eyebrow data-reveal>Layanan</Eyebrow>
        <h2 id="layanan-title" class="mt-6 max-w-3xl text-h1" data-reveal>
          Lima layanan, bisa dipesan terpisah atau sekaligus.
        </h2>
      </div>
      <div data-reveal>
        <Button href="/services" variant="ghost" icon="lucide:arrow-right">Semua layanan</Button>
      </div>
    </div>

    <ul class="mt-14 border-t border-strong lg:mt-20">
      {
        rows.map((r, i) => (
          <li data-reveal style={`--d:${i * 60}ms`}>
            <a
              href={r.href}
              class="svc-row group relative grid grid-cols-[auto_1fr_auto] items-center gap-x-5 gap-y-3 border-b border-rule py-8 sm:gap-x-8 lg:grid-cols-[7rem_1.1fr_1fr_auto] lg:py-10"
            >
              <span class="absolute inset-y-0 left-0 w-0 bg-volt/15 transition-all duration-500 group-hover:w-full" aria-hidden="true" />

              <span
                class="relative font-display text-4xl font-extrabold text-transparent transition-colors duration-300 group-hover:text-strong lg:text-6xl"
                style="font-stretch:125%;-webkit-text-stroke:1.5px var(--color-strong)"
                aria-hidden="true"
              >
                {r.kode}
              </span>

              <span class="relative">
                <span class="label-tech block text-soft">{r.lapisan}</span>
                <span class="mt-2 block font-display text-xl font-extrabold text-strong sm:text-2xl lg:text-3xl" style="font-stretch:110%">
                  {r.label}
                </span>
                <span class="mt-2 block text-sm text-soft lg:hidden">{r.tagline}</span>
              </span>

              <span class="relative hidden lg:block">
                <span class="block text-sm leading-relaxed text-body">{r.data?.ringkas}</span>
                {r.data?.spesifikasi && (
                  <span class="mt-4 flex flex-wrap gap-2">
                    {r.data.spesifikasi.slice(0, 3).map((sp) => (
                      <span class="label-tech border border-rule bg-canvas px-2.5 py-1.5 text-[0.6rem] text-body">{sp.nilai}</span>
                    ))}
                  </span>
                )}
              </span>

              <span class="relative flex size-12 items-center justify-center bg-strong text-canvas transition-all duration-300 group-hover:rotate-45 group-hover:bg-volt group-hover:text-ink lg:size-14">
                <Icon name="lucide:arrow-up" class="size-5" />
              </span>

              {r.data?.heroImage && (
                <span class="pointer-events-none absolute right-28 top-1/2 z-10 hidden w-60 -translate-y-1/2 rotate-3 opacity-0 shadow-2xl shadow-ink/30 transition-all duration-500 group-hover:-rotate-2 group-hover:opacity-100 xl:block">
                  <Image
                    src={r.data.heroImage}
                    alt=""
                    width={480}
                    widths={[240, 480]}
                    sizes="240px"
                    class="aspect-[4/3] w-full object-cover"
                    loading="lazy"
                  />
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
