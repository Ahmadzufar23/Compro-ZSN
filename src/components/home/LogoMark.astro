---
/**
 * LogoMark — HANYA bagian lingkaran + panah dari zsn-logo.svg, tanpa
 * wordmark. Empat path (lingkaran hitam, dua isian kuning, satu kilau
 * kuning kecil) diekstrak langsung dari src/assets/foto/logo/zsn-logo.svg
 * dan di-crop lewat viewBox yang diukur dari getBBox() gabungan
 * keempatnya (lihat catatan crop di Logo.astro untuk metode yang sama).
 *
 * Dipakai sebagai badge lingkaran putih di tengah headline hero yang
 * terbelah. `rounded-full` di sini adalah lambang bulat (setara avatar),
 * bukan sudut kartu — pengecualian yang sama seperti di CLAUDE.md.
 */
interface Props {
  class?: string;
}
const { class: extra = '' } = Astro.props;
