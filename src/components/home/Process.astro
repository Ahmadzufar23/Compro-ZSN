---
/**
 * Process: lima tahap kerja. Isi tiap tahap diambil dari frontmatter
 * layanan (scope & alurKerja), bukan janji baru.
 */
import Eyebrow from '@/components/ui/Eyebrow.astro';

const steps = [
  {
    judul: 'Survei lokasi',
    detail: 'Tim datang mengukur rute kabel, titik perangkat, dan kondisi bangunan. Survei tidak dikenakan biaya.',
    output: 'Catatan survei',
  },
  {
    judul: 'Desain & penawaran',
    detail: 'Rute kabel, denah titik kamera, atau topologi jaringan disusun. Rencana kerja dan perkiraan durasi disepakati.',
    output: 'Desain & penawaran',
  },
  {
    judul: 'Instalasi',
    detail: 'Penarikan kabel, pemasangan perangkat, dan konfigurasi sesuai desain yang sudah disetujui.',
    output: 'Sistem terpasang',
  },
  {
    judul: 'Pengujian',
    detail: 'Fiber diukur redamannya dengan OTDR, jaringan diuji per titik, CCTV diuji perekaman dan akses jarak jauhnya.',
    output: 'Laporan hasil uji',
  },
  {
    judul: 'Serah terima',
    detail: 'Laporan uji dan dokumentasi diserahkan bersama berita acara. Pekerjaan bergaransi sesuai lingkup kerja.',
    output: 'Berita acara',
  },
];
---

<section class="relative overflow-hidden bg-raised py-24 lg:py-32" aria-labelledby="proses-title">
  <div class="container-content relative">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <Eyebrow data-reveal>Alur kerja</Eyebrow>
        <h2 id="proses-title" class="mt-6 text-h1" data-reveal>Lima tahap, dari survei sampai serah terima.</h2>
      </div>
      <p class="max-w-md text-lg lg:col-span-5 lg:justify-self-end" data-reveal>
        Tahapannya sama untuk fiber, jaringan, maupun CCTV. Yang berbeda hanya alat ukur dan
        dokumen hasilnya.
      </p>
    </div>

    <ol class="relative mt-16 grid border-t-2 border-strong lg:mt-20 lg:grid-cols-5">
      {
        steps.map((s, i) => (
          <li class="group relative flex flex-col border-b border-rule py-8 lg:border-b-0 lg:border-r lg:px-6 lg:py-10 lg:first:pl-0 lg:last:border-r-0" data-reveal style={`--d:${i * 90}ms`}>
            <span class:list={['absolute -top-[7px] size-3 bg-volt ring-2 ring-strong', i === 0 ? 'left-0' : 'left-0 lg:left-6']} aria-hidden="true" />
            <span class="label-tech text-soft">Tahap {i + 1}</span>
            <h3 class="mt-3 text-h3">{s.judul}</h3>
            <p class="mb-8 mt-3 text-sm leading-relaxed text-soft">{s.detail}</p>
            <p class="label-tech mt-auto inline-flex items-center gap-2 text-[0.6rem] text-strong">
              <span class="h-px w-4 bg-strong" aria-hidden="true" />
              {s.output}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
