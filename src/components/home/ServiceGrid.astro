---
/**
 * ServiceGrid — dibaca langsung dari getCollection('layanan'), diurutkan
 * pakai field `urutan`. Judul dan href tidak pernah hardcode di sini,
 * supaya baris tidak bisa melenceng dari konten layanan yang sebenarnya
 * ada (pernah terjadi: kartu "Pengujian & Sertifikasi Kabel" tanpa file
 * layanan, dan link ke slug yang tidak pernah dibuat).
 *
 * Hanya menampilkan layanan infrastruktur fisik — difilter lewat field
 * schema `tampilDiGrid`, BUKAN dicocokkan ke slug 'software' secara
 * hardcode (itu masalah yang sama yang baru diperbaiki di tempat lain).
 * Software punya SoftwareBanner sendiri di bawah daftar ini.
 *
 * icon murni presentasi, dipetakan per slug di sini. Layanan baru
 * tanpa entri di `tampilan` otomatis dapat ikon 'default' — tidak akan
 * gagal build, tapi sebaiknya ditambahkan ikon teknis yang sesuai.
 *
 * Daftar bergaris rambut, bukan grid kartu — arah "enterprise terang"
 * (lihat CLAUDE.md). Baris duduk langsung di atas canvas, dipisah
 * `border-hairline`, hover mengubah latar jadi surface.
 *
 * `urutan` cuma dipakai untuk sorting, tidak pernah dirender — layanan
 * bukan sekuens (lihat CLAUDE.md).
 */
import { getCollection } from 'astro:content';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import ServiceIcon from './ServiceIcon.astro';

type IconType = 'konektor' | 'kamera' | 'patch-panel' | 'wrench' | 'terminal' | 'default';

const tampilan: Record<string, { icon: IconType }> = {
  'fiber-optic': { icon: 'konektor' },
  cctv: { icon: 'kamera' },
  network: { icon: 'patch-panel' },
  maintenance: { icon: 'wrench' },
};

const layanan = (await getCollection('layanan', ({ data }) => data.tampilDiGrid)).sort(
  (a, b) => a.data.urutan - b.data.urutan
);
---

<Section bg="canvas" size="md" id="services" aria-label="Services">
  <p class="label-tech text-muted">Services</p>
  <h2 class="mt-3 text-h2">End-to-End Services</h2>

  <div class="mt-10 border-t border-hairline">
    {
      layanan.map((entry) => {
        const { icon } = tampilan[entry.id] ?? { icon: 'default' as IconType };
        return (
          <a
            href={`/services/${entry.id}`}
            class="animate-service-row opacity-0 translate-y-6 group -mx-4 flex flex-col gap-4 border-b border-hairline px-4 py-6 transition-colors hover:bg-surface sm:flex-row sm:items-center sm:gap-8"
          >
            <ServiceIcon type={icon} class="size-5 shrink-0 text-ink sm:size-6" />

            <div class="flex-1">
              <h3 class="text-h3">{entry.data.judul}</h3>
              <p class="mt-1 max-w-md text-sm text-muted">{entry.data.ringkas}</p>
            </div>

            {
              entry.data.spesifikasi && (
                <dl class="flex shrink-0 flex-col gap-1 sm:w-56">
                  {entry.data.spesifikasi.map((s) => (
                    <div class="flex justify-between gap-4 font-mono text-xs">
                      <dt class="text-subtle">{s.label}</dt>
                      <dd class="text-right text-ink">{s.nilai}</dd>
                    </div>
                  ))}
                </dl>
              )
            }

            <svg
              class="size-4 shrink-0 text-muted transition-colors group-hover:text-ink"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path d="M7 17 17 7M9 7h8v8" />
            </svg>
          </a>
        );
      })
    }
  </div>

  <div class="mt-10 flex justify-center">
    <Button href="/services" variant="outline-dark">View All Services</Button>
  </div>
</Section>

<script>
  import { animate, inView, stagger } from "motion";

  const setupServiceAnimations = () => {
    const section = document.querySelector('#services');
    const rows = document.querySelectorAll('.animate-service-row');

    if (section && rows.length > 0) {
      inView(section, () => {
        animate(
          rows,
          { opacity: 1, transform: "none" },
          { duration: 0.5, delay: stagger(0.1) }
        );
      }, { margin: "-50px" });
    }
  };

  document.addEventListener('astro:page-load', setupServiceAnimations);
</script>
