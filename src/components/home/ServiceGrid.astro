---
/**
 * ServiceGrid — dibaca langsung dari getCollection('layanan'), diurutkan
 * pakai field `urutan`. Judul dan href tidak pernah hardcode di sini,
 * supaya kartu tidak bisa melenceng dari konten layanan yang sebenarnya
 * ada (pernah terjadi: kartu "Pengujian & Sertifikasi Kabel" tanpa file
 * layanan, dan link ke slug yang tidak pernah dibuat).
 *
 * Hanya menampilkan layanan infrastruktur fisik — difilter lewat field
 * schema `tampilDiGrid`, BUKAN dicocokkan ke slug 'software' secara
 * hardcode (itu masalah yang sama yang baru diperbaiki di tempat lain).
 * Software punya SoftwareBanner sendiri di bawah grid ini.
 *
 * icon murni presentasi, dipetakan per slug di sini. Layanan baru
 * tanpa entri di `tampilan` otomatis dapat ikon 'default' — tidak akan
 * gagal build, tapi sebaiknya ditambahkan ikon teknis yang sesuai.
 *
 * Semua kartu memakai gaya yang sama (latar ink, border 2px transparan),
 * tidak ada varian putih — konsistensi grid lebih penting daripada
 * variasi. Hover/focus mengubah border jadi kuning tebal.
 *
 * `urutan` cuma dipakai untuk sorting, tidak pernah dirender — layanan
 * bukan sekuens (lihat CLAUDE.md).
 */
import { getCollection } from 'astro:content';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import ServiceIcon from './ServiceIcon.astro';

type IconType = 'konektor' | 'kamera' | 'patch-panel' | 'wrench' | 'terminal' | 'default';

const tampilan: Record<string, { icon: IconType }> = {
  'fiber-optic': { icon: 'konektor' },
  cctv: { icon: 'kamera' },
  network: { icon: 'patch-panel' },
  maintenance: { icon: 'wrench' },
};

const layanan = (await getCollection('layanan', ({ data }) => data.tampilDiGrid)).sort(
  (a, b) => a.data.urutan - b.data.urutan
);
---

<Section bg="white" size="md" id="layanan" aria-label="Layanan">
  <p class="label-tech text-amber-text">Layanan</p>
  <h2 class="mt-3 text-h2">Layanan End-to-End</h2>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      layanan.map((entry) => {
        const { icon } = tampilan[entry.id] ?? { icon: 'default' as IconType };
        return (
          <article class="on-dark group relative flex flex-col rounded-md border-2 border-transparent bg-ink p-6 pb-20 transition-colors hover:border-yellow focus-within:border-yellow">
            <ServiceIcon type={icon} class="size-8 text-yellow" />

            <div
              class="relative mt-4 flex items-center justify-center overflow-hidden rounded-md border border-dashed border-steel bg-graphite"
              style="aspect-ratio: 3/4;"
            >
              <span class="label-tech px-4 text-center text-slate-muted">Foto layanan</span>
            </div>

            <h3 class="mt-5 text-h3 text-white">{entry.data.judul}</h3>
            <p class="mt-2 text-sm text-slate-muted">{entry.data.ringkas}</p>

            <a
              href={`/layanan/${entry.id}`}
              aria-label={`Lihat detail layanan ${entry.data.judul}`}
              class="absolute bottom-5 right-5 flex size-11 items-center justify-center rounded-md bg-white text-ink transition-colors hover:bg-yellow"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" />
              </svg>
            </a>
          </article>
        );
      })
    }
  </div>

  <div class="mt-10 flex justify-center">
    <Button href="/layanan" variant="outline-dark">Lihat Semua Layanan</Button>
  </div>
</Section>
