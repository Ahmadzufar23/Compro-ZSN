---
/**
 * ServiceGrid — Konsep B (Enterprise Cards + Premium Visual)
 * Menampilkan 3 layanan unggulan dengan foto asli ZSN
 * untuk meningkatkan kredibilitas dan kontras B2B.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import ServiceIcon from './ServiceIcon.astro';

// Import foto nyata untuk visual di sebelah kiri
import showcaseImage from '@/assets/layanan/network-hero.jpg';

type IconType = 'konektor' | 'kamera' | 'patch-panel' | 'wrench' | 'terminal' | 'default';

const tampilan: Record<string, { icon: IconType }> = {
  'fiber-optic': { icon: 'konektor' },
  cctv: { icon: 'kamera' },
  software: { icon: 'terminal' },
  maintenance: { icon: 'wrench' },
};

// Filter: Tampil di grid, sesuai bahasa, dan KECUALIKAN 'maintenance'
const layanan = (await getCollection('layanan', ({ id, data }) => 
  data.tampilDiGrid && 
  id.startsWith('en/') &&
  !id.includes('maintenance')
)).sort((a, b) => a.data.urutan - b.data.urutan);

const servicesHref = `/services`;
---

<Section bg="surface" size="md" id="services" aria-label="Services" class="relative overflow-hidden">
  
  <div class="relative z-10 lg:grid lg:grid-cols-12 lg:gap-10 lg:items-start">
    
    <!-- Bagian Kiri (Teks & Visual Foto) -->
    <div class="lg:col-span-4 xl:col-span-4 mb-10 lg:mb-0 flex flex-col items-start">
      <p class="label-tech text-muted mb-2 uppercase tracking-widest text-xs w-full">Services</p>
      <h2 class="text-h3 md:text-3xl font-semibold leading-tight mb-4 text-ink w-full">
        Core infrastructure solutions
      </h2>
      <p class="text-sm text-muted leading-relaxed mb-8 w-full">
        Building enterprise-grade network backbones and surveillance systems for uncompromising business operations.
      </p>
      
      <!-- Premium Tech Visual (Foto Nyata ZSN) -->
      <div class="hidden lg:block w-full mb-8 relative group overflow-hidden border border-hairline shadow-sm bg-canvas">
        <div class="aspect-video relative overflow-hidden">
          <Image 
            src={showcaseImage} 
            alt="ZSN Enterprise Infrastructure" 
            class="object-cover w-full h-full transition-transform duration-700 group-hover:scale-105"
            width={600}
          />
          <!-- Overlay halus -->
          <div class="absolute inset-0 bg-ink/5 transition-colors group-hover:bg-transparent"></div>
        </div>
        <!-- Garis aksen bawah foto -->
        <div class="h-1 w-full bg-yellow origin-left transform scale-x-0 transition-transform duration-500 group-hover:scale-x-100"></div>
      </div>
      
      <Button href={servicesHref} variant="outline-dark" class="w-full text-sm py-2 group">
        View All Solutions
      </Button>
    </div>

    <!-- Bagian Kanan (3 Kartu Enterprise) -->
    <div class="lg:col-span-8 xl:col-span-8">
      <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 items-stretch">
        {layanan.map((entry, i) => {
          const baseId = entry.id.replace('en/', '');
          const { icon } = tampilan[baseId] ?? { icon: 'default' as IconType };
          const itemHref = `/services/${baseId}`;
          
          return (
            <a
              href={itemHref}
              class="animate-service-card group flex flex-col bg-canvas border border-hairline p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_30px_rgba(0,0,0,0.06)] hover:border-zinc-300 opacity-0 translate-y-6 h-full"
              style={`animation-delay: ${i * 100}ms;`}
            >
              <!-- Icon Box (Kontras Tinggi) -->
              <div class="mb-6 flex size-12 items-center justify-center bg-ink text-canvas transition-transform duration-300 group-hover:scale-110">
                <ServiceIcon type={icon} class="size-6" />
              </div>
              
              <!-- Content dengan Aksen Kotak Kuning 8x8px -->
              <div class="flex items-center gap-3 mb-3">
                <div class="size-2 bg-yellow shrink-0" aria-hidden="true"></div>
                <h3 class="text-lg font-semibold leading-tight text-ink">{entry.data.judul}</h3>
              </div>
              
              <p class="text-sm text-muted leading-relaxed flex-grow pb-6">
                {entry.data.ringkas}
              </p>
              
              <!-- Action Arrow -->
              <div class="mt-auto flex justify-end pt-4 border-t border-hairline">
                <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-muted transition-colors group-hover:text-ink">
                  <span>Explore</span>
                  <svg
                    class="size-4 transition-transform duration-300 group-hover:translate-x-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="square" stroke-linejoin="miter" d="M4 12h16M13 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
    
  </div>
</Section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  const setupServiceAnimations = () => {
    const section = document.querySelector('#services');
    const cards = document.querySelectorAll('.animate-service-card');

    if (section && cards.length > 0) {
      inView(section, () => {
        animate(
          cards,
          { opacity: 1, transform: "none" },
          { duration: 0.6, delay: stagger(0.15) }
        );
      }, { margin: "-50px" });
    }
  };

  document.addEventListener('astro:page-load', setupServiceAnimations);
</script>
