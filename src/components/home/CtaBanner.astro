---
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
---

<Section bg="deep" size="lg" id="contact" aria-label="Call to action">
  <div class="flex flex-col items-center gap-8 text-center">
    <div class="max-w-2xl">
      <h2 class="text-h2 text-white">Ready to build your infrastructure?</h2>
      <p class="mt-4 text-subtle">
        Tell us what you need, and our team will survey your site and prepare
        a work plan at no cost.
      </p>
    </div>
    <div class="flex flex-col gap-4 sm:flex-row">
      <Button href="/contact" size="lg">Free Consultation</Button>
      <Button href="/contact" variant="outline-light" size="lg">Contact Page</Button>
    </div>
  </div>
</Section>
