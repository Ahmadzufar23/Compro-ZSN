---
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
---

<Section bg="white" size="lg" id="kontak" aria-label="Ajakan bertindak">
  <div class="flex flex-col items-center gap-8 text-center">
    <div class="max-w-2xl">
      <h2 class="text-h2">Siap Membangun Infrastruktur Anda?</h2>
      <p class="mt-4">
        Ceritakan kebutuhan Anda, tim kami akan survei lokasi dan menyiapkan
        rencana kerja tanpa biaya.
      </p>
    </div>
    <div class="flex flex-col gap-4 sm:flex-row">
      <Button href="/kontak" size="lg">Konsultasi Gratis</Button>
      <Button href="/kontak" variant="outline-dark" size="lg">Halaman Kontak</Button>
    </div>
  </div>
</Section>
