---
import Section from '@/components/ui/Section.astro';

/* Klaim terlarang (99% Uptime, headcount) sudah dihindari — lihat CLAUDE.md */
const stats = [
  { angka: '1000+', label: 'Completed Projects' },
  { angka: 'Since 2023', label: 'Years in Operation' },
  { angka: '30+', label: 'Cities Covered' },
];
---

<Section bg="canvas" size="sm" aria-label="Statistics">
  <dl class="mx-auto grid max-w-2xl grid-cols-1 gap-y-8 text-center sm:grid-cols-3 sm:divide-x sm:divide-hairline">
    {
      stats.map(({ angka, label }) => (
        <div class="min-w-0 px-6">
          <dt class="stat-angka font-display text-3xl font-bold text-ink break-words" data-val={angka}>{angka}</dt>
          <dd class="label-tech mt-1 text-subtle">{label}</dd>
        </div>
      ))
    }
  </dl>
</Section>

<script>
  import { inView, animate } from "motion";

  const setupStats = () => {
    const section = document.querySelector('[aria-label="Statistics"]');
    const statElements = document.querySelectorAll('.stat-angka');

    if (section && statElements.length > 0) {
      inView(section, () => {
        statElements.forEach(el => {
          const val = el.getAttribute('data-val') || '';
          const numMatch = val.match(/(\d+)/);

          if (numMatch) {
            const targetNum = parseInt(numMatch[1], 10);
            const prefix = val.substring(0, numMatch.index);
            const suffix = val.substring(numMatch.index + numMatch[1].length);

            // Animate from 0, but for years (like 2023) start closer
            let startNum = targetNum > 2000 ? 2000 : 0;

            animate(startNum, targetNum, {
              duration: 2,
              ease: "easeOut",
              onUpdate: (latest) => {
                el.textContent = `${prefix}${Math.round(latest)}${suffix}`;
              }
            });
          }
        });
      }, { margin: "-50px" });
    }
  };

  document.addEventListener('astro:page-load', setupStats);
</script>
