---
/**
 * CoverageSection — rumah baru untuk TopologyDiagram, dipindah dari Hero
 * karena headline yang sekarang rata tengah penuh lebar tidak lagi
 * menyisakan kolom untuk diagram. Diagram tetap dipertahankan sesuai
 * arahan CLAUDE.md — satu-satunya elemen visual khas ZSN dan
 * satu-satunya animasi di situs.
 *
 * Di bawah 640px, diagram disembunyikan (label node tidak terbaca di
 * lebar itu) dan diganti daftar 4 tahap bergaris rambut.
 */
import Section from '@/components/ui/Section.astro';
import TopologyDiagram from './TopologyDiagram.astro';

const tahap = ['ODP', 'Building', 'Server Rack', 'Dashboard'];
---

<Section bg="canvas" size="md" aria-label="Coverage">
  <p class="flex items-center gap-2">
    <span class="size-2 shrink-0 bg-yellow" aria-hidden="true" />
    <span class="label-tech text-muted">Scope of Work</span>
  </p>
  <h2 class="mt-3 text-h2">From distribution point to dashboard</h2>

  <div class="mt-10 hidden sm:block">
    <TopologyDiagram class="mx-auto max-w-3xl" />
  </div>

  <ol class="mt-2 divide-y divide-hairline border-t border-hairline sm:hidden">
    {
      tahap.map((label, i) => (
        <li class="flex items-center gap-3 py-4">
          <span class="label-tech text-subtle">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-base font-semibold text-ink">{label}</span>
        </li>
      ))
    }
  </ol>

  <p class="mt-6 max-w-2xl text-sm text-muted">
    Every distribution point connects to the building, monitored through server racks,
    all the way to the dashboard displaying real-time data.
  </p>
</Section>
