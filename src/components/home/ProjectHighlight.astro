---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';

// Mengambil koleksi project, diurutkan berdasarkan tanggal (terbaru), batasi 6
const projects = (await getCollection('project'))
  .sort((a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf())
  .slice(0, 6);
---

<Section bg="canvas" id="project" aria-label="Project">
  <p class="label-tech text-muted">Project</p>
  <h2 class="mt-3 text-h2">Yang sudah kami kerjakan</h2>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((proj) => (
      <article class="animate-project-card opacity-0 translate-y-8 group flex flex-col">
        <div class="relative overflow-hidden bg-surface pb-[75%]">
          <Image 
            src={proj.data.cover} 
            alt={proj.data.coverAlt} 
            class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
          />
        </div>
        <div class="mt-4 flex flex-1 flex-col border-t border-hairline pt-4">
          <p class="label-tech text-subtle">{proj.data.kodeProject} · {proj.data.lokasi}</p>
          <h3 class="mt-2 text-h3">{proj.data.judul}</h3>
          <p class="mt-2 flex-1 text-muted">
            {proj.data.ringkas}
          </p>
        </div>
      </article>
    ))}
  </div>

  {site.halamanAktif.project && (
    <div class="mt-12 flex justify-center">
      <Button href="/project" variant="outline-dark">Lihat Semua Project</Button>
    </div>
  )}
</Section>

<script>
  import { animate, inView, stagger } from "motion";

  const setupProjectAnimations = () => {
    const section = document.querySelector('#project');
    const cards = document.querySelectorAll('.animate-project-card');

    if (section && cards.length > 0) {
      inView(section, () => {
        animate(
          cards,
          { opacity: 1, transform: "none" },
          { duration: 0.6, delay: stagger(0.15) }
        );
      }, { margin: "-100px" });
    }
  };

  document.addEventListener('astro:page-load', setupProjectAnimations);
</script>
