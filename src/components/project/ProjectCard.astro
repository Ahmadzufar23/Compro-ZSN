---
/**
 * ProjectCard — dipakai baik di grid gabungan maupun grid per kategori
 * di src/pages/project/index.astro, supaya markup kartu tidak duplikat.
 */
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';

interface Props {
  project: CollectionEntry<'project'>;
  kategoriLabel: string;
}
const { project, kategoriLabel } = Astro.props;
const { data } = project;
---

<a
  href={`/project/${project.id}`}
  class:list={[
    'group relative overflow-hidden rounded-md border border-ink/10 transition-colors hover:border-ink/30',
    data.unggulan && 'sm:col-span-2',
  ]}
>
  <div
    class="relative overflow-hidden"
    style={data.unggulan ? 'aspect-ratio: 21/9;' : 'aspect-ratio: 4/3;'}
  >
    <Picture
      src={data.cover}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      alt={data.coverAlt}
      width={data.unggulan ? 1200 : 700}
      height={data.unggulan ? 514 : 525}
      loading="lazy"
      pictureAttributes={{ class: 'block size-full' }}
      class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <span class="label-tech absolute left-3 top-3 rounded-sm bg-yellow px-2 py-1 text-ink">
      {kategoriLabel}
    </span>
  </div>
  <div class="p-5">
    <p class="label-tech text-amber-text">{data.kodeProject}</p>
    <h3 class="mt-1 text-h3">{data.judul}</h3>
    <p class="label-tech mt-2 text-slate-muted">{data.lokasi}</p>
  </div>
</a>
