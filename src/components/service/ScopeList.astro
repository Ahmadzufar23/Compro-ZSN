---
/**
 * ScopeList — panel ink di atas latar putih, daftar bernomor 1..n.
 * Sekuens nyata (Scope Pekerjaan / tahapan proses) -> penomoran dibenarkan.
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  judul?: string;
  items: { judul: string; detail: string }[];
}
const { judul = 'Scope Pekerjaan', items } = Astro.props;
---

<Section bg="white" size="md" aria-label={judul}>
  <p class="label-tech text-amber-text">Scope Pekerjaan</p>
  <h2 class="mt-3 text-h2">{judul}</h2>

  <div class="mt-10 overflow-hidden rounded-md bg-ink">
    <ol class="divide-y divide-steel">
      {
        items.map((item, i) => (
          <li class="flex gap-5 px-6 py-6 md:px-10">
            <span class="font-display shrink-0 text-2xl font-bold text-yellow">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="text-base font-semibold uppercase tracking-tight text-white">
                {item.judul}
              </h3>
              <p class="mt-1.5 text-sm text-white/70">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Section>
