---
/**
 * ScopeList — daftar bernomor 1..n dipisah garis rambut, tanpa panel
 * berwarna. Sekuens nyata (Scope Pekerjaan / tahapan proses) -> penomoran
 * dibenarkan.
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  judul?: string;
  items: { judul: string; detail: string }[];
}
const { judul = 'Scope Pekerjaan', items } = Astro.props;
---

<Section bg="canvas" size="md" aria-label={judul}>
  <p class="label-tech text-muted">Scope Pekerjaan</p>
  <h2 class="mt-3 text-h2">{judul}</h2>

  <ol class="mt-10 divide-y divide-hairline border-t border-hairline">
    {
      items.map((item, i) => (
        <li class="flex gap-5 py-6">
          <span class="font-display shrink-0 text-2xl font-bold text-ink">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="text-base font-semibold text-ink">{item.judul}</h3>
            <p class="mt-1.5 text-sm text-muted">{item.detail}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
