---
/**
 * ScopeList — daftar bernomor 1..n dipisah garis rambut, tanpa panel
 * berwarna. Sekuens nyata (Scope Pekerjaan / tahapan proses) -> penomoran
 * dibenarkan.
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  judul?: string;
  items: { judul: string; detail: string }[];
}
const { judul = 'Scope Pekerjaan', items } = Astro.props;
---

<Section bg="canvas" size="md" aria-label={judul}>
  <p class="label-tech text-muted">Scope Pekerjaan</p>
  <h2 class="mt-3 text-h2">{judul}</h2>

  <div class="mt-12 relative border-l-2 border-zinc-200 ml-4 md:ml-6 space-y-12 pb-8">
    {
      items.map((item, i) => (
        <div class="relative pl-10 md:pl-12 group">
          {/* Timeline Dot with Number */}
          <span class="absolute -left-[21px] top-0 w-10 h-10 rounded-full bg-white border-2 border-zinc-200 flex items-center justify-center font-display text-sm font-bold text-zinc-500 group-hover:border-zinc-900 group-hover:text-zinc-900 group-hover:shadow-md transition-all duration-300">
            {String(i + 1).padStart(2, '0')}
          </span>
          
          <div class="bg-white border border-hairline p-6 md:p-8 shadow-sm rounded-xl hover:shadow-md transition-shadow duration-300">
            <h3 class="text-lg font-bold text-ink">{item.judul}</h3>
            <p class="mt-2 text-muted leading-relaxed">{item.detail}</p>
          </div>
        </div>
      ))
    }
  </div>
</Section>
