---
/**
 * ServicePage: satu template untuk semua halaman layanan & produk.
 * Setiap blok dirender hanya bila datanya ada di frontmatter.
 */
import type { CollectionEntry } from 'astro:content';
import { render, getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import CtaFinal from '@/components/home/CtaFinal.astro';
import SoftwarePanel from './SoftwarePanel.astro';
import { services } from '@/config/services';
import { waLink } from '@/config/site';
import { projectSlug, kategoriLabel } from '@/config/project';

interface Props {
  entry: CollectionEntry<'layanan'> | CollectionEntry<'produk'>;
  slug: string;
}
const { entry, slug } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const svc = services.find((s) => s.slug === slug);
const kode = svc?.kode ?? 'ZSN';
const pesan = `Halo ZSN, saya ingin berkonsultasi mengenai layanan ${d.judul}.`;
const lain = services.filter((s) => s.slug !== slug);
const isSoftware = slug === 'software';
const judulPanjang = d.judul.length > 28;

/* Galeri memakai foto proyek asli dengan kategori yang sama. Foto galeri
   di frontmatter layanan masih placeholder, jadi tidak dipakai. */
const kategoriSlug: Record<string, string> = { 'fiber-optic': 'fiber', cctv: 'cctv', network: 'network', maintenance: 'maintenance', software: 'software' };
const fotoProyek = (await getCollection('project'))
  .filter((p) => p.data.kategori === kategoriSlug[slug])
  .sort((a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf())
  .slice(0, 4);

/* Penomoran indeks section berurutan sesuai blok yang benar-benar tampil */
let n = 0;
const idx = () => String(++n).padStart(2, '0');

const softwareBuild = [
  { icon: 'lucide:layout-dashboard', judul: 'Sistem operasional internal', detail: 'Panel admin, alur kerja, dan persetujuan yang mengikuti cara tim Anda benar-benar bekerja.' },
  { icon: 'lucide:file-bar-chart', judul: 'Pencatatan & pelaporan', detail: 'Data tersentral dengan dashboard dan laporan otomatis, tanpa rekap manual di spreadsheet.' },
  { icon: 'lucide:calendar-clock', judul: 'Booking & penjadwalan', detail: 'Reservasi, jadwal, dan pengelolaan sumber daya dalam satu sistem.' },
  { icon: 'lucide:plug-zap', judul: 'Integrasi & otomasi', detail: 'API dan konektor yang menghubungkan sistem yang sudah ada, termasuk perangkat lapangan.' },
];
const stack = ['TypeScript', 'Node.js', 'PostgreSQL', 'Docker', 'Astro', 'React'];
---

<Base title={d.judul} description={d.ringkas}>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-ink pt-32 lg:pt-40">
    {
      d.heroImage && (
        <div class="absolute inset-0 -z-10">
          <Image
            src={d.heroImage}
            alt=""
            width={1920}
            widths={[768, 1280, 1920]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            class="size-full object-cover opacity-45"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/30" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-ink/60" />
        </div>
      )
    }
    {!d.heroImage && <div class="bg-grid mask-fade pointer-events-none absolute inset-0 -z-10" aria-hidden="true" />}

    <div class="container-content grid gap-12 pb-16 lg:grid-cols-12 lg:pb-24">
      <div class:list={[isSoftware ? 'lg:col-span-7' : 'lg:col-span-9']}>
        <nav aria-label="Breadcrumb" class="label-tech mb-8 flex flex-wrap items-center gap-2 text-fog">
          <a href="/" class="hover:text-volt">Beranda</a>
          <span class="text-line-strong">/</span>
          <a href="/services" class="hover:text-volt">Layanan</a>
          <span class="text-line-strong">/</span>
          <span class="text-snow">{d.judul}</span>
        </nav>
        <p class="font-display text-7xl font-extrabold leading-none text-transparent sm:text-8xl" style="font-stretch:125%;-webkit-text-stroke:1.5px var(--color-volt)" aria-hidden="true">
          {kode}
        </p>
        <h1 class:list={['mt-4', judulPanjang ? 'text-h1' : 'text-hero']}>{d.judul}</h1>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-mist">{d.subjudul}</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={waLink(pesan)} external size="lg" icon="lucide:zap">{d.ctaLabel}</Button>
          <Button href="#lingkup" variant="ghost" size="lg" icon="lucide:arrow-down">Lingkup pekerjaan</Button>
        </div>
      </div>
      {isSoftware && (
        <div class="lg:col-span-5">
          <SoftwarePanel />
        </div>
      )}
    </div>

    {
      d.spesifikasi && (
        <div class="border-t border-line bg-ink/70 backdrop-blur">
          <dl class="container-content grid grid-cols-2 lg:grid-cols-4">
            {d.spesifikasi.map((s, i) => (
              <div class:list={['border-line py-6 pr-4', i % 2 === 1 && 'border-l pl-5', i >= 2 && 'border-t lg:border-t-0', i > 0 && 'lg:border-l lg:pl-6']}>
                <dt class="label-tech text-fog">{s.label}</dt>
                <dd class="mt-2 font-semibold text-snow">{s.nilai}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }
  </section>

  <!-- RINGKASAN + COCOK UNTUK -->
  <section class="bg-carbon py-20 lg:py-28">
    <div class="container-content grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal>
        <Eyebrow index={idx()}>Ringkasnya</Eyebrow>
        <div class="prose-zsn mt-6 text-xl leading-relaxed text-snow sm:text-2xl">
          <Content />
        </div>
        {d.stats && (
          <dl class="mt-12 grid grid-cols-2 gap-px bg-line sm:grid-cols-4">
            {d.stats.map((s) => (
              <div class="bg-carbon p-5">
                <dt class="font-display text-lg font-extrabold text-volt" style="font-stretch:110%">{s.angka}</dt>
                <dd class="label-tech mt-2 text-[0.6rem] text-fog">{s.label}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
      {d.cocokUntuk && (
        <aside class="lg:col-span-4 lg:col-start-9" data-reveal style="--d:120ms">
          <p class="label-tech text-fog">Cocok untuk</p>
          <ul class="mt-5 border-t border-line">
            {d.cocokUntuk.map((c) => (
              <li class="flex items-center gap-3 border-b border-line py-4 text-snow">
                <Icon name="lucide:check" class="size-4 shrink-0 text-volt" />
                {c}
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>
  </section>

  {
    isSoftware && (
      <section class="bg-ink py-20 lg:py-28">
        <div class="container-content">
          <Eyebrow index={idx()} data-reveal>Yang kami bangun</Eyebrow>
          <h2 class="mt-6 max-w-3xl text-h1" data-reveal>Software yang mengikuti proses bisnis Anda, bukan sebaliknya.</h2>
          <div class="mt-14 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-4">
            {softwareBuild.map((b, i) => (
              <article class="bg-ink p-8 transition-colors hover:bg-carbon" data-reveal style={`--d:${i * 80}ms`}>
                <Icon name={b.icon} class="size-8 text-volt" />
                <h3 class="mt-8 text-xl">{b.judul}</h3>
                <p class="mt-3 text-sm leading-relaxed text-fog">{b.detail}</p>
              </article>
            ))}
          </div>
          <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal>
            <span class="label-tech mr-2 text-fog">Teknologi</span>
            {stack.map((s) => (
              <span class="label-tech border border-line px-3 py-2 text-mist">{s}</span>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- LINGKUP (sekuens) -->
  <section id="lingkup" class="relative bg-ink py-20 lg:py-28">
    <div class="container-content grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <Eyebrow index={idx()} data-reveal>{isSoftware ? 'Tahap pengerjaan' : 'Lingkup pekerjaan'}</Eyebrow>
          <h2 class="mt-6 text-h2" data-reveal>
            {isSoftware ? 'Dari analisis sampai sistem dipakai tim Anda.' : 'Apa saja yang kami kerjakan, berurutan.'}
          </h2>
        </div>
      </div>
      <ol class="relative lg:col-span-8">
        <span class="absolute bottom-6 left-[1.4rem] top-6 w-px bg-line" aria-hidden="true" />
        {d.scope.map((s, i) => (
          <li class="group relative flex gap-6 pb-10 last:pb-0" data-reveal style={`--d:${i * 60}ms`}>
            <span class="relative z-10 flex size-11 shrink-0 items-center justify-center border border-line-strong bg-ink font-mono text-sm text-snow transition-colors group-hover:border-volt group-hover:bg-volt group-hover:text-ink">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="pt-2">
              <h3 class="text-xl">{s.judul}</h3>
              <p class="mt-2 max-w-xl text-fog">{s.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {
    fotoProyek.length > 0 && (
      <section class="bg-carbon py-20 lg:py-28">
        <div class="container-content">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <Eyebrow index={idx()} data-reveal>Dokumentasi lapangan</Eyebrow>
              <h2 class="mt-6 text-h2" data-reveal>Seperti ini pekerjaannya di lapangan.</h2>
            </div>
            <a href="/portfolio" class="label-tech inline-flex min-h-11 items-center gap-2 text-volt hover:underline" data-reveal>
              Semua proyek <Icon name="lucide:arrow-right" class="size-4" />
            </a>
          </div>
          <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {fotoProyek.map((p, i) => (
              <a
                href={`/portfolio/${projectSlug(p.id)}`}
                class:list={['crop-marks group relative block aspect-[3/4] overflow-hidden', fotoProyek.length === 1 && 'sm:col-span-2 sm:aspect-[16/9]']}
                data-reveal
                style={`--d:${i * 80}ms`}
              >
                <Image src={p.data.cover} alt={p.data.coverAlt} width={800} widths={[400, 800]} sizes="(min-width:1024px) 25vw, 50vw" class="size-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink via-ink/70 to-transparent p-5 pt-20">
                  <span class="label-tech block text-volt">{p.data.kodeProject}</span>
                  <span class="mt-1 block font-semibold text-snow">{p.data.judul}</span>
                  <span class="label-tech mt-1 block text-[0.6rem] text-fog">{kategoriLabel[p.data.kategori]} · {p.data.lokasi}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    d.alurKerja && (
      <section class="on-paper bg-paper py-20 text-graphite lg:py-28">
        <div class="container-content">
          <Eyebrow index={idx()} tone="paper" data-reveal>Alur kerja</Eyebrow>
          <h2 class="mt-6 text-h2 !text-ink" data-reveal>Empat langkah sampai serah terima.</h2>
          <ol class="mt-12 grid gap-px bg-ink/10 md:grid-cols-4">
            {d.alurKerja.map((a, i) => (
              <li class="bg-paper p-7" data-reveal style={`--d:${i * 80}ms`}>
                <span class="font-display text-5xl font-extrabold text-transparent" style="font-stretch:125%;-webkit-text-stroke:1.5px #0A0C0F">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-6 text-xl !text-ink">{a.judul}</h3>
                <p class="mt-2 text-sm">{a.detail}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    d.masalah && (
      <section class="bg-ink py-20 lg:py-28">
        <div class="container-content">
          <Eyebrow index={idx()} data-reveal>Gejala yang sering kami temui</Eyebrow>
          <h2 class="mt-6 max-w-3xl text-h2" data-reveal>Kalau salah satu ini terdengar familiar, jaringan Anda butuh perawatan.</h2>
          <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {d.masalah.map((m, i) => (
              <article class="panel cut-corner p-7" data-reveal style={`--d:${i * 80}ms`}>
                <Icon name="lucide:triangle-alert" class="size-6 text-volt" />
                <h3 class="mt-6 text-lg">{m.judul}</h3>
                <p class="mt-2 text-sm text-fog">{m.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    d.tierPerangkat && (
      <section class="bg-carbon py-20 lg:py-28">
        <div class="container-content">
          <Eyebrow index={idx()} data-reveal>Tingkat perangkat</Eyebrow>
          <h2 class="mt-6 text-h2" data-reveal>Pilih spesifikasi sesuai risiko area Anda.</h2>
          <div class="mt-12 grid gap-4 lg:grid-cols-3">
            {d.tierPerangkat.map((t, i) => (
              <article class:list={['relative p-8', i === 1 ? 'bg-volt text-ink' : 'panel']} data-reveal style={`--d:${i * 80}ms`}>
                <p class:list={['label-tech', i === 1 ? 'text-ink/70' : 'text-volt']}>{t.tier}</p>
                <h3 class:list={['mt-3 text-h3', i === 1 && '!text-ink']}>{t.nama}</h3>
                <p class:list={['mt-2 text-sm', i === 1 ? 'text-ink/80' : 'text-fog']}>{t.ringkas}</p>
                <dl class:list={['mt-8 border-t', i === 1 ? 'border-ink/20' : 'border-line']}>
                  {t.spek.map((s) => (
                    <div class:list={['flex justify-between gap-4 border-b py-3 text-sm', i === 1 ? 'border-ink/20' : 'border-line']}>
                      <dt class={i === 1 ? 'text-ink/70' : 'text-fog'}>{s.label}</dt>
                      <dd class:list={['text-right font-semibold', i === 1 ? 'text-ink' : 'text-snow']}>{s.nilai}</dd>
                    </div>
                  ))}
                </dl>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    d.paket && (
      <section class="bg-carbon py-20 lg:py-28">
        <div class="container-content">
          <Eyebrow index={idx()} data-reveal>{isSoftware ? 'Contoh sistem' : 'Pilihan paket'}</Eyebrow>
          <h2 class="mt-6 max-w-3xl text-h2" data-reveal>
            {isSoftware ? 'Beberapa sistem yang bisa kami bangun.' : 'Paket menyesuaikan skala jaringan Anda.'}
          </h2>
          <div class="mt-12 grid gap-4 lg:grid-cols-3">
            {d.paket.map((p, i) => (
              <article class="panel flex flex-col p-8" data-reveal style={`--d:${i * 80}ms`}>
                <h3 class="text-h3">{p.nama}</h3>
                <p class="mt-2 text-sm text-fog">{p.ringkas}</p>
                <ul class="mt-8 flex-1 space-y-3 border-t border-line pt-6">
                  {p.isi.map((x) => (
                    <li class="flex gap-3 text-sm text-mist">
                      <Icon name="lucide:zap" class="mt-0.5 size-4 shrink-0 text-volt" />
                      {typeof x === 'string' ? x : `${x.label}: ${x.nilai}`}
                    </li>
                  ))}
                </ul>
                <p class="label-tech mt-8 text-fog">
                  {p.hargaMulai ? `Mulai Rp ${p.hargaMulai} juta${p.satuan ?? ''}` : 'Harga sesuai survei'}
                </p>
                <a
                  href={waLink(`Halo ZSN, saya tertarik dengan ${p.nama} (${d.judul}).`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-flex min-h-11 items-center gap-2 font-semibold text-volt hover:underline"
                >
                  Minta penawaran <Icon name="lucide:arrow-up-right" class="size-4" />
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    (d.faktorHarga || d.tidakTermasuk) && (
      <section class="bg-ink py-20 lg:py-28">
        <div class="container-content grid gap-14 lg:grid-cols-2">
          {d.faktorHarga && (
            <div>
              <Eyebrow index={idx()} data-reveal>Yang menentukan biaya</Eyebrow>
              <h2 class="mt-6 text-h2" data-reveal>Harga transparan, dihitung dari survei.</h2>
              <dl class="mt-10 border-t border-line">
                {d.faktorHarga.map((f) => (
                  <div class="border-b border-line py-5" data-reveal>
                    <dt class="font-semibold text-snow">{f.judul}</dt>
                    <dd class="mt-1 text-sm text-fog">{f.penjelasan}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
          {d.tidakTermasuk && (
            <div>
              <Eyebrow index={idx()} data-reveal>Batas lingkup</Eyebrow>
              <h2 class="mt-6 text-h2" data-reveal>Tidak termasuk dalam kontrak.</h2>
              <p class="mt-4 text-fog" data-reveal>Ditulis jelas di awal, supaya tidak ada asumsi yang berujung sengketa.</p>
              <ul class="mt-8 border-t border-line">
                {d.tidakTermasuk.map((t) => (
                  <li class="flex gap-3 border-b border-line py-4 text-mist" data-reveal>
                    <Icon name="lucide:x" class="mt-1 size-4 shrink-0 text-fog" />
                    {t}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    d.merek && (
      <section class="border-y border-line bg-void py-10">
        <div class="container-content flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <p class="label-tech text-fog">Perangkat yang kami tangani</p>
            <p class="mt-1 text-xs text-fog/70">Instalatur independen, bukan mitra resmi produsen.</p>
          </div>
          <ul class="flex flex-wrap gap-x-8 gap-y-2">
            {d.merek.map((m) => (
              <li class="font-display text-2xl font-extrabold text-mist" style="font-stretch:115%">{m}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="bg-carbon py-20 lg:py-28">
    <div class="container-content grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Eyebrow index={idx()} data-reveal>Pertanyaan umum</Eyebrow>
        <h2 class="mt-6 text-h2" data-reveal>Yang biasanya ditanyakan sebelum survei.</h2>
      </div>
      <div class="border-t border-line lg:col-span-8">
        {
          d.faq.map((f) => (
            <details class="group border-b border-line" data-reveal>
              <summary class="flex min-h-16 items-center justify-between gap-6 py-5 text-lg font-semibold text-snow transition-colors hover:text-volt">
                {f.tanya}
                <span class="faq-icon flex size-9 shrink-0 items-center justify-center border border-line-strong text-volt transition-transform duration-300">
                  <Icon name="lucide:plus" class="size-4" />
                </span>
              </summary>
              <p class="max-w-2xl pb-6 text-fog">{f.jawab}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- LAYANAN LAIN -->
  <section class="border-t border-line bg-ink py-16">
    <div class="container-content">
      <p class="label-tech text-fog">Layanan lain</p>
      <ul class="mt-6 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-4">
        {
          lain.map((s) => (
            <li>
              <a href={s.href} class="group flex h-full items-center justify-between gap-4 bg-ink p-6 transition-colors hover:bg-carbon">
                <span>
                  <span class="label-tech block text-volt">ZSN/{s.kode}</span>
                  <span class="mt-2 block font-semibold text-snow">{s.label}</span>
                </span>
                <Icon name="lucide:arrow-up-right" class="size-5 text-fog transition-colors group-hover:text-volt" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaFinal
    judul={isSoftware ? 'Punya proses yang masih manual?' : `Siap mulai proyek ${d.judul}?`}
    sub={isSoftware
      ? 'Ceritakan alur kerja yang ingin Anda rapikan. Kami bantu petakan sebelum satu baris kode pun ditulis.'
      : 'Kirim lokasi dan gambaran kebutuhan Anda. Kami atur jadwal survei dan kirim penawaran tertulis setelahnya.'}
    pesan={pesan}
    label={d.ctaLabel}
  />
</Base>

<style>
  .prose-zsn :global(p + p) {
    margin-top: 1em;
  }
</style>
