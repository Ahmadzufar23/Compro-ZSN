---
/**
 * PriceFactors — 4 kartu bordered + strip full-width di bawahnya.
 * Sengaja TANPA ikon centang: ini faktor variabel yang memengaruhi
 * biaya, bukan daftar yang didapat pelanggan.
 *
 * Catatan: brief asli meminta strip "biru muda", tetapi CLAUDE.md
 * mengunci "tidak ada biru di mana pun di situs ini" tanpa
 * pengecualian -> strip memakai --color-mist, bukan biru.
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  items: { judul: string; penjelasan: string }[];
}
const { items } = Astro.props;
---

<Section bg="white" size="md" aria-label="Faktor harga">
  <p class="label-tech text-amber-text">Estimasi Biaya</p>
  <h2 class="mt-3 text-h2">Faktor yang Memengaruhi Harga</h2>

  <div class="mt-10 grid gap-5 md:grid-cols-4">
    {
      items.map((item) => (
        <div class="rounded-md border border-ink/15 p-6">
          <h3 class="text-base font-semibold uppercase tracking-tight text-ink">{item.judul}</h3>
          <p class="mt-2 text-sm text-slate">{item.penjelasan}</p>
        </div>
      ))
    }
  </div>

  <p class="label-tech mt-6 rounded-md bg-mist px-6 py-4 text-slate">
    Harga akhir ditentukan setelah survei lokasi — bukan estimasi dari brosur.
  </p>
</Section>
