---
/**
 * PriceFactors — empat kolom dipisah garis rambut vertikal.
 * Sengaja TANPA ikon centang: ini faktor variabel yang memengaruhi
 * biaya, bukan daftar yang didapat pelanggan.
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  items: { judul: string; penjelasan: string }[];
}
const { items } = Astro.props;
---

<Section bg="canvas" size="md" aria-label="Price factors">
  <p class="label-tech text-muted">Cost Estimation</p>
  <h2 class="mt-3 text-h2">Factors affecting the price</h2>

  <div class="mt-10 grid gap-5 md:grid-cols-4">
    {
      items.map((item) => (
        <div class="border-l border-hairline pl-5">
          <h3 class="text-base font-semibold text-ink">{item.judul}</h3>
          <p class="mt-2 text-sm text-muted">{item.penjelasan}</p>
        </div>
      ))
    }
  </div>

  <p class="label-tech mt-8 border-t border-hairline pt-4 text-muted">
    Final pricing is determined after a site survey, not estimated from a brochure.
  </p>
</Section>
