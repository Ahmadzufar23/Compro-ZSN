---
/**
 * Gallery — masonry foto lapangan, dengan dukungan stempel pojok
 * (ala gambar teknik) dan anotasi As-Built (garis callout kuning +
 * label mono) di atas foto.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Section from '@/components/ui/Section.astro';

interface GaleriItem {
  src: ImageMetadata;
  alt: string;
  stempel?: string;
  anotasi?: { label: string; x: number; y: number }[];
}

interface Props {
  items: GaleriItem[];
}
const { items } = Astro.props;
---

<Section bg="surface" size="md" aria-label="Field Gallery">
  <p class="label-tech text-muted">Documentation</p>
  <h2 class="mt-3 text-h2">Field gallery</h2>

  <div class="mt-10 columns-1 gap-1 sm:columns-2 lg:columns-3">
    {
      items.map((item) => (
        <figure class="relative mb-1 break-inside-avoid overflow-hidden bg-deep">
          <Picture
            src={item.src}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            alt={item.alt}
            width={800}
            height={600}
            loading="lazy"
            pictureAttributes={{ class: 'block w-full' }}
            class="block w-full object-cover"
          />

          {item.anotasi?.map((a) => (
            <span
              class="absolute flex items-center gap-1.5"
              style={`left:${a.x}%; top:${a.y}%;`}
            >
              <span class="size-1.5 bg-yellow" />
              <span class="h-px w-6 bg-yellow" />
              <span class="label-tech whitespace-nowrap bg-deep/80 px-1.5 py-0.5 text-yellow">
                {a.label}
              </span>
            </span>
          ))}

          {item.stempel && (
            <figcaption class="label-tech absolute bottom-2 right-2 border border-yellow/40 bg-deep/80 px-2 py-1 text-yellow">
              {item.stempel}
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>
</Section>
