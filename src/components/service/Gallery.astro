---
/**
 * Gallery — masonry foto lapangan, dengan dukungan stempel pojok
 * (ala gambar teknik) dan anotasi As-Built (garis callout kuning +
 * label mono) di atas foto.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Section from '@/components/ui/Section.astro';

interface GaleriItem {
  src: ImageMetadata;
  alt: string;
  stempel?: string;
  anotasi?: { label: string; x: number; y: number }[];
}

interface Props {
  items: GaleriItem[];
}
const { items } = Astro.props;
---

<Section bg="surface" size="md" aria-label="Field Gallery">
  <p class="label-tech text-muted">Documentation</p>
  <h2 class="mt-3 text-h2">Field gallery</h2>

  <div class="mt-12 columns-1 gap-4 sm:columns-2 lg:columns-3">
    {
      items.map((item) => (
        <figure class="relative mb-4 break-inside-avoid overflow-hidden bg-deep rounded-2xl group shadow-md hover:shadow-xl transition-all duration-500">
          <Picture
            src={item.src}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            alt={item.alt}
            width={800}
            height={600}
            loading="lazy"
            pictureAttributes={{ class: 'block w-full transition-transform duration-700 group-hover:scale-105' }}
            class="block w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

          {item.anotasi?.map((a) => (
            <span
              class="absolute flex items-center gap-1.5 z-10 transition-transform duration-500 hover:scale-110 cursor-default"
              style={`left:${a.x}%; top:${a.y}%;`}
            >
              <span class="size-2 bg-yellow-400 rounded-full animate-pulse shadow-[0_0_8px_rgba(250,204,21,0.8)]" />
              <span class="h-px w-8 bg-yellow-400/80" />
              <span class="label-tech whitespace-nowrap bg-zinc-950/80 backdrop-blur-md px-2.5 py-1 text-yellow-400 border border-yellow-400/30 rounded shadow-lg">
                {a.label}
              </span>
            </span>
          ))}

          {item.stempel && (
            <figcaption class="label-tech absolute bottom-4 right-4 z-10 border border-yellow-400/30 bg-zinc-950/80 backdrop-blur-md px-3 py-1.5 text-yellow-400 rounded shadow-lg opacity-90 group-hover:opacity-100 transition-opacity">
              {item.stempel}
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>
</Section>
