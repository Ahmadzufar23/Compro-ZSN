---
/**
 * KomitmenTable — tabel perbandingan komitmen layanan (mis. SLA,
 * waktu respons per tingkat layanan). Kolom terakhir dianggap
 * kolom unggulan/direkomendasikan -> urutkan `kolom` dan `nilai` di
 * konten dari yang paling dasar ke paling direkomendasikan.
 *
 * Kolom unggulan ditandai garis atas kuning 2px di header, BUKAN
 * latar blok kuning penuh kolom — kuning maksimal 3% permukaan,
 * lihat CLAUDE.md.
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  kolom: string[];
  baris: { label: string; nilai: string[] }[];
}
const { kolom, baris } = Astro.props;
const unggulanIdx = kolom.length - 1;
---

<Section bg="canvas" size="md" aria-label="Service Commitment">
  <p class="label-tech text-muted">Commitment</p>
  <h2 class="mt-3 text-h2">Service commitment</h2>

  <div class="mt-10 overflow-hidden rounded-2xl border border-hairline shadow-md ring-1 ring-black/5 bg-white">
    <table class="w-full min-w-[560px] border-collapse text-sm">
      <thead class="bg-zinc-50">
        <tr>
          <th class="w-1/3 border-b border-hairline py-4 px-6 text-left font-normal text-muted" />
          {
            kolom.map((k, i) => (
              <th
                class:list={[
                  'border-b py-4 px-6 text-left font-semibold text-ink relative',
                  i === unggulanIdx ? 'bg-yellow-50/50' : '',
                ]}
              >
                {i === unggulanIdx && (
                  <div class="absolute top-0 left-0 w-full h-1 bg-yellow-400"></div>
                )}
                {k}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody class="divide-y divide-hairline">
        {
          baris.map((b) => (
            <tr class="hover:bg-zinc-50/50 transition-colors">
              <td class="py-4 px-6 font-medium text-muted">{b.label}</td>
              {b.nilai.map((v, i) => (
                <td
                  class:list={[
                    'py-4 px-6 text-ink',
                    i === unggulanIdx ? 'bg-yellow-50/30 font-semibold' : '',
                  ]}
                >
                  {v}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Section>
