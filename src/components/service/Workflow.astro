---
/**
 * Workflow — timeline horizontal 4 langkah. Alur Kerja adalah sekuens
 * nyata -> penomoran dibenarkan.
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  items: { judul: string; detail: string }[];
}
const { items } = Astro.props;
---

<Section bg="canvas" size="md" aria-label="Alur kerja">
  <p class="label-tech text-muted">Alur Kerja</p>
  <h2 class="mt-3 text-h2">Bagaimana kami bekerja</h2>

  <ol class="mt-10 grid gap-8 border-t border-hairline pt-6 md:grid-cols-4 md:gap-6">
    {
      items.map((item, i) => (
        <li class="relative">
          <span class="label-tech text-subtle">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 text-base font-semibold text-ink">{item.judul}</h3>
          <p class="mt-1.5 text-sm text-muted">{item.detail}</p>
        </li>
      ))
    }
  </ol>
</Section>
