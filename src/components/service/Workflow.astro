---
/**
 * Workflow — timeline horizontal 4 langkah. Alur Kerja adalah sekuens
 * nyata -> penomoran dibenarkan.
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  items: { judul: string; detail: string }[];
}
const { items } = Astro.props;
---

<Section bg="white" size="md" aria-label="Alur kerja">
  <p class="label-tech text-amber-text">Alur Kerja</p>
  <h2 class="mt-3 text-h2">Bagaimana Kami Bekerja</h2>

  <ol class="mt-10 grid gap-8 md:grid-cols-4 md:gap-6">
    {
      items.map((item, i) => (
        <li class="relative border-t-2 border-ink pt-5">
          <span class="font-display block text-3xl font-bold text-ink">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-3 text-base font-semibold uppercase tracking-tight text-ink">
            {item.judul}
          </h3>
          <p class="mt-1.5 text-sm text-slate">{item.detail}</p>
        </li>
      ))
    }
  </ol>
</Section>
