---
/**
 * Workflow — timeline horizontal 4 langkah. Alur Kerja adalah sekuens
 * nyata -> penomoran dibenarkan.
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  items: { judul: string; detail: string }[];
}
const { items } = Astro.props;
---

<Section bg="canvas" size="md" aria-label="Workflow">
  <p class="label-tech text-muted">Workflow</p>
  <h2 class="mt-3 text-h2">How we work</h2>

  <ol class="mt-12 grid gap-10 md:grid-cols-4 md:gap-6 relative">
    {/* Connecting Line (Desktop) */}
    <div class="hidden md:block absolute top-[20px] left-0 right-0 h-[2px] bg-gradient-to-r from-yellow-400 via-zinc-200 to-zinc-100 z-0"></div>

    {
      items.map((item, i) => (
        <li class="relative z-10 group">
          <div class="flex items-center gap-4 mb-4 md:flex-col md:items-start md:mb-6">
            <span class="flex items-center justify-center w-10 h-10 rounded-full bg-white border-2 border-zinc-200 font-mono text-sm font-bold text-zinc-400 group-hover:border-yellow-400 group-hover:text-yellow-600 group-hover:shadow-[0_0_15px_rgba(250,204,21,0.3)] transition-all duration-300">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="text-lg font-bold text-ink group-hover:text-yellow-600 transition-colors">{item.judul}</h3>
          </div>
          <p class="text-sm text-muted leading-relaxed">{item.detail}</p>
        </li>
      ))
    }
  </ol>
</Section>
