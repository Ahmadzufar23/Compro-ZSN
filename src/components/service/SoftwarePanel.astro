---
/** Mockup dashboard dekoratif untuk hero halaman software. Tanpa data nyata. */
const bars = [38, 62, 45, 80, 56, 92, 70, 84, 60, 96, 74, 88];
---

<div class="relative" aria-hidden="true">
  <div class="panel cut-corner overflow-hidden bg-carbon shadow-2xl shadow-black/60">
    <div class="flex items-center gap-2 border-b border-line px-4 py-3">
      <span class="size-2.5 bg-volt"></span>
      <span class="size-2.5 bg-line-strong"></span>
      <span class="size-2.5 bg-line-strong"></span>
      <span class="label-tech ml-3 text-[0.6rem] text-fog">zsn://dashboard/operasional</span>
    </div>
    <div class="grid grid-cols-3 gap-px bg-line">
      {['Perangkat', 'Tiket', 'Laporan'].map((l, i) => (
        <div class="bg-carbon p-4">
          <p class="label-tech text-[0.55rem] text-fog">{l}</p>
          <div class:list={['mt-3 h-2.5', i === 0 ? 'w-3/4 bg-volt' : 'w-1/2 bg-line-strong']}></div>
          <div class="mt-2 h-1.5 w-1/3 bg-line"></div>
        </div>
      ))}
    </div>
    <div class="p-5">
      <div class="flex h-36 items-end gap-1.5">
        {bars.map((h, i) => (
          <div class:list={['bar flex-1', i === bars.length - 3 ? 'bg-volt' : 'bg-line-strong']} style={`height:${h}%;--i:${i}`}></div>
        ))}
      </div>
      <div class="mt-5 space-y-2 font-mono text-[0.7rem] leading-relaxed">
        <p class="text-fog"><span class="text-volt">$</span> sync --source lapangan</p>
        <p class="text-mist">✓ data perangkat tersinkron</p>
        <p class="text-mist">✓ laporan harian dibuat<span class="blink ml-1 inline-block h-3 w-1.5 translate-y-0.5 bg-volt"></span></p>
      </div>
    </div>
  </div>
</div>

<style>
  .bar {
    transform-origin: bottom;
    animation: grow 1.2s var(--ease-snap) both;
    animation-delay: calc(var(--i) * 60ms);
  }
  @keyframes grow {
    from { transform: scaleY(0.05); }
  }
</style>
