---
/**
 * Skema alur sistem untuk hero halaman software: perangkat lapangan →
 * jaringan → server → dashboard. Konseptual, tanpa data atau angka.
 */
const nodes = [
  { x: 40, label: 'Perangkat', sub: 'CCTV · sensor · POS' },
  { x: 190, label: 'Jaringan', sub: 'LAN · fiber · VPN' },
  { x: 340, label: 'Server', sub: 'API · database' },
  { x: 490, label: 'Dashboard', sub: 'web · mobile' },
];
---

<svg viewBox="0 0 600 300" class="w-full" role="img" aria-label="Skema alur data: perangkat lapangan, jaringan, server, lalu dashboard">
  <g stroke="rgba(255,255,255,.06)">
    {Array.from({ length: 13 }, (_, i) => <line x1={i * 50} x2={i * 50} y1="0" y2="300" />)}
    {Array.from({ length: 7 }, (_, i) => <line y1={i * 50} y2={i * 50} x1="0" x2="600" />)}
  </g>
  <path d="M110 150 H520" stroke="rgba(255,255,255,.2)" stroke-width="2" />
  <path d="M110 150 H520" stroke="#FFCE00" stroke-width="3" class="flow-line" style="--flow-speed:4s" />
  {
    nodes.map((n, i) => (
      <g>
        <rect x={n.x} y="110" width="70" height="80" fill={i === 3 ? '#FFCE00' : '#101318'} stroke={i === 3 ? '#FFCE00' : 'rgba(255,255,255,.35)'} stroke-width="1.5" />
        {i === 0 && <g fill="none" stroke="#C4C9D1" stroke-width="2"><rect x="58" y="134" width="24" height="16" /><path d="M82 142 l10 -6 v12 z" /></g>}
        {i === 1 && <g fill="none" stroke="#C4C9D1" stroke-width="2"><rect x="203" y="132" width="44" height="12" /><rect x="203" y="150" width="44" height="12" /><circle cx="241" cy="138" r="1.5" fill="#FFCE00" /></g>}
        {i === 2 && <g fill="none" stroke="#C4C9D1" stroke-width="2"><ellipse cx="375" cy="132" rx="18" ry="6" /><path d="M357 132 v24 c0 3.3 8 6 18 6 s18 -2.7 18 -6 v-24" /></g>}
        {i === 3 && <g fill="none" stroke="#0A0C0F" stroke-width="2"><rect x="503" y="128" width="44" height="30" /><polyline points="508,152 518,142 528,147 542,134" /></g>}
        <text x={n.x + 35} y="222" text-anchor="middle" class="nl">{n.label}</text>
        <text x={n.x + 35} y="240" text-anchor="middle" class="ns">{n.sub}</text>
      </g>
    ))
  }
  <text x="40" y="70" class="nt">ALUR DATA</text>
  <text x="40" y="88" class="ns" text-anchor="start">dari lapangan sampai layar</text>
</svg>

<style>
  .nl { font: 700 14px var(--font-display); fill: #f4f4f2; }
  .ns { font: 500 9.5px var(--font-mono); fill: #8f97a3; letter-spacing: 0.08em; }
  .nt { font: 500 11px var(--font-mono); fill: #ffce00; letter-spacing: 0.16em; }
</style>
