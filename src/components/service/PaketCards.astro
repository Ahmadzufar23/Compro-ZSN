---
/**
 * PaketCards — kolom perbandingan dipisah garis rambut, bukan kartu.
 * hargaMulai kosong -> "Minta Penawaran" + tombol "Konsultasi" (bukan
 * "Pilih Paket", bahasa e-commerce yang tidak cocok untuk situs tanpa
 * checkout).
 *
 * Bukan <table> literal: `isi` per paket adalah daftar bebas dengan
 * panjang berbeda-beda antar paket (lihat maintenance.mdx: paket
 * "Dasar" 3 baris, "Enterprise" 4 baris) — memaksakannya jadi baris
 * tabel akan salah sejajar. Kolom tetap dipisah garis rambut vertikal
 * seperti tabel, isi per kolom tetap daftar masing-masing.
 */
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';

interface PaketItem {
  nama: string;
  ringkas: string;
  hargaMulai?: string;
  satuan?: string;
  durasi?: string;
  isi: (string | { label: string; nilai: string })[];
}

interface Props {
  items: PaketItem[];
}
const { items } = Astro.props;
---

<Section bg="surface" size="md" aria-label="Paket">
  <p class="label-tech text-muted">Paket</p>
  <h2 class="mt-3 text-h2">Pilihan paket</h2>

  <div class="mt-10 grid gap-8 border-t border-hairline pt-8 md:grid-cols-3 md:gap-0 md:divide-x md:divide-hairline">
    {
      items.map((p) => (
        <div class="flex flex-col md:px-8 md:first:pl-0 md:last:pr-0">
          <h3 class="text-h3">{p.nama}</h3>
          <p class="mt-2 text-sm text-muted">{p.ringkas}</p>

          <p class="mt-5 font-display text-2xl font-bold text-ink">
            {p.hargaMulai ? (
              <>
                Mulai dari Rp {p.hargaMulai} juta
                {p.satuan && <span class="text-sm font-normal text-muted">{p.satuan}</span>}
              </>
            ) : (
              'Minta Penawaran'
            )}
          </p>
          {p.durasi && <p class="label-tech mt-1 text-muted">Estimasi durasi: {p.durasi}</p>}

          <ul class="mt-6 flex-1 space-y-2.5 border-t border-hairline pt-5 text-sm">
            {p.isi.map((row) =>
              typeof row === 'string' ? (
                <li class="text-muted">{row}</li>
              ) : (
                <li class="flex justify-between gap-4">
                  <span class="text-muted">{row.label}</span>
                  <span class="font-medium text-ink">{row.nilai}</span>
                </li>
              )
            )}
          </ul>

          <Button href="/kontak" variant="outline-dark" class="mt-6">
            Konsultasi
          </Button>
        </div>
      ))
    }
  </div>
</Section>
