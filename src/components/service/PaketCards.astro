---
/**
 * PaketCards — kolom perbandingan dipisah garis rambut, bukan kartu.
 * hargaMulai kosong -> "Minta Penawaran" + tombol "Konsultasi" (bukan
 * "Pilih Paket", bahasa e-commerce yang tidak cocok untuk situs tanpa
 * checkout).
 *
 * Bukan <table> literal: `isi` per paket adalah daftar bebas dengan
 * panjang berbeda-beda antar paket (lihat maintenance.mdx: paket
 * "Dasar" 3 baris, "Enterprise" 4 baris) — memaksakannya jadi baris
 * tabel akan salah sejajar. Kolom tetap dipisah garis rambut vertikal
 * seperti tabel, isi per kolom tetap daftar masing-masing.
 */
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';

interface PaketItem {
  nama: string;
  ringkas: string;
  hargaMulai?: string;
  satuan?: string;
  durasi?: string;
  isi: (string | { label: string; nilai: string })[];
}

interface Props {
  items: PaketItem[];
}
const { items } = Astro.props;
---

<Section bg="surface" size="md" aria-label="Service Tiers">
  <p class="label-tech text-muted">Service Tiers</p>
  <h2 class="mt-3 text-h2">Solutions & Specifications</h2>

  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {
      items.map((p, i) => (
        <div class={`flex flex-col bg-white border ${i === 1 ? 'border-zinc-300 shadow-md scale-105 z-10' : 'border-hairline shadow-sm'} rounded-2xl overflow-hidden`}>
          {i === 1 && <div class="bg-zinc-900 text-white text-xs font-bold text-center py-2 tracking-widest uppercase">Most Popular</div>}
          
          <div class="p-8 flex-1 flex flex-col">
            <h3 class="text-h3">{p.nama}</h3>
            <p class="mt-2 text-sm text-muted h-10">{p.ringkas}</p>

            {p.durasi && <p class="label-tech mt-8 text-muted">Estimated duration: {p.durasi}</p>}

            <ul class="mt-8 flex-1 space-y-3 border-t border-hairline pt-6 text-sm">
              {p.isi.map((row) =>
                typeof row === 'string' ? (
                  <li class="flex gap-3 text-muted">
                    <svg class="shrink-0 size-5 text-zinc-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                    <span>{row}</span>
                  </li>
                ) : (
                  <li class="flex justify-between gap-4">
                    <span class="text-muted">{row.label}</span>
                    <span class="font-medium text-ink">{row.nilai}</span>
                  </li>
                )
              )}
            </ul>

            <Button href="/contact" variant={i === 1 ? "primary" : "outline-dark"} class="mt-8 w-full justify-center">
              Consultation
            </Button>
          </div>
        </div>
      ))
    }
  </div>
</Section>
