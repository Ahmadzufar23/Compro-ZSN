---
/**
 * BrandTiers — merek perangkat yang DITANGANI (bukan mitra resmi) +
 * 3 kartu tier spesifikasi. Heading wajib "Perangkat yang Kami Tangani".
 */
import Section from '@/components/ui/Section.astro';

interface Tier {
  tier: string;
  nama: string;
  ringkas: string;
  unggulan: boolean;
  spek: { label: string; nilai: string }[];
}

interface Props {
  merek?: string[];
  tierPerangkat?: Tier[];
}
const { merek, tierPerangkat } = Astro.props;
---

<Section bg="mist" size="md" aria-label="Perangkat yang kami tangani">
  <p class="label-tech text-amber-text">Perangkat</p>
  <h2 class="mt-3 text-h2">Perangkat yang Kami Tangani</h2>

  {
    merek && (
      <div class="mt-6 flex flex-wrap gap-3">
        {merek.map((m) => (
          <span class="label-tech rounded-md border border-ink/15 bg-white px-3 py-1.5 text-ink">
            {m}
          </span>
        ))}
      </div>
    )
  }

  {
    tierPerangkat && (
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {tierPerangkat.map((t) => (
          <div
            class:list={[
              'flex flex-col rounded-md border p-6',
              t.unggulan ? 'border-yellow bg-white ring-1 ring-yellow' : 'border-ink/10 bg-white',
            ]}
          >
            <p class="label-tech text-amber-text">{t.tier}</p>
            <h3 class="mt-2 text-h3">{t.nama}</h3>
            <p class="mt-2 text-sm text-slate">{t.ringkas}</p>
            <dl class="mt-5 flex-1 divide-y divide-mist border-t border-mist">
              {t.spek.map((s) => (
                <div class="flex justify-between gap-4 py-2.5 text-sm">
                  <dt class="text-slate">{s.label}</dt>
                  <dd class="text-right font-medium text-ink">{s.nilai}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    )
  }
</Section>
