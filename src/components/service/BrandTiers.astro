---
/**
 * BrandTiers — merek perangkat yang DITANGANI (bukan mitra resmi) +
 * tabel perbandingan tier spesifikasi (garis rambut, bukan kartu).
 * Heading wajib "Perangkat yang Kami Tangani".
 */
import Section from '@/components/ui/Section.astro';

interface Tier {
  tier: string;
  nama: string;
  ringkas: string;
  spek: { label: string; nilai: string }[];
}

interface Props {
  merek?: string[];
  tierPerangkat?: Tier[];
}
const { merek, tierPerangkat } = Astro.props;
---

<Section bg="surface" size="md" aria-label="Supported devices">
  <p class="label-tech text-muted">Devices</p>
  <h2 class="mt-3 text-h2">Hardware we handle</h2>

  {
    merek && (
      <div class="mt-6 flex flex-wrap gap-3">
        {merek.map((m) => (
          <span class="label-tech border border-hairline bg-canvas px-3 py-1.5 text-ink">
            {m}
          </span>
        ))}
      </div>
    )
  }

  {
    tierPerangkat && (
      <div class="mt-10 overflow-x-auto">
        <table class="w-full min-w-[560px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-hairline">
              <th class="py-3 pr-4 align-bottom font-normal">
                <span class="label-tech text-muted">Specification</span>
              </th>
              {tierPerangkat.map((t) => (
                <th class="px-4 py-3 align-bottom font-normal">
                  <span class="label-tech text-muted">{t.tier}</span>
                  <span class="mt-1 block text-base font-semibold text-ink">{t.nama}</span>
                  <span class="mt-1 block text-xs font-normal text-muted">{t.ringkas}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {tierPerangkat[0].spek.map((s, i) => (
              <tr class="border-b border-hairline">
                <td class="py-3 pr-4 text-muted">{s.label}</td>
                {tierPerangkat.map((t) => (
                  <td class="px-4 py-3 text-ink">{t.spek[i]?.nilai}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</Section>
