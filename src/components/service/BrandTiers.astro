---
/**
 * BrandTiers — merek perangkat yang DITANGANI (bukan mitra resmi) +
 * tabel perbandingan tier spesifikasi (garis rambut, bukan kartu).
 * Heading wajib "Perangkat yang Kami Tangani".
 */
import Section from '@/components/ui/Section.astro';

interface Tier {
  tier: string;
  nama: string;
  ringkas: string;
  spek: { label: string; nilai: string }[];
}

interface Props {
  merek?: string[];
  tierPerangkat?: Tier[];
}
const { merek, tierPerangkat } = Astro.props;
---

<Section bg="surface" size="md" aria-label="Supported devices">
  <p class="label-tech text-muted">Devices</p>
  <h2 class="mt-3 text-h2">Hardware we handle</h2>

  {
    merek && (
      <div class="mt-6 flex flex-wrap gap-3">
        {merek.map((m) => (
          <span class="label-tech border border-hairline bg-canvas px-3 py-1.5 text-ink">
            {m}
          </span>
        ))}
      </div>
    )
  }

  {
    tierPerangkat && (
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {tierPerangkat.map((t) => (
          <div class="bg-white border border-hairline p-6 lg:p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 relative overflow-hidden group">
            {/* Subtle gradient accent on hover */}
            <div class="absolute top-0 left-0 w-full h-1 bg-zinc-200 group-hover:bg-yellow-400 transition-colors duration-300"></div>
            
            <span class="label-tech text-yellow-600 bg-yellow-100/50 px-2.5 py-1 rounded-md inline-block mb-4">{t.tier}</span>
            <h3 class="text-2xl font-display font-bold text-ink">{t.nama}</h3>
            <p class="text-sm text-muted mt-3 leading-relaxed">{t.ringkas}</p>
            
            <dl class="mt-8 space-y-4 border-t border-hairline pt-6">
              {t.spek.map((s) => (
                <div class="flex flex-col">
                  <dt class="text-[10px] text-zinc-500 uppercase tracking-widest font-mono">{s.label}</dt>
                  <dd class="text-base font-semibold text-ink mt-1">{s.nilai}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    )
  }
</Section>
