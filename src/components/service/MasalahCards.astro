---
/**
 * MasalahCards — daftar bergaris rambut (mis. gejala kerusakan yang
 * ditangani layanan maintenance).
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  items: { judul: string; detail: string }[];
}
const { items } = Astro.props;
---

<Section bg="surface" size="md" aria-label="Masalah yang kami tangani">
  <p class="label-tech text-muted">Sering Terjadi</p>
  <h2 class="mt-3 text-h2">Masalah yang kami tangani</h2>

  <div class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      items.map((item) => (
        <div class="border-t border-hairline pt-5">
          <h3 class="text-base font-semibold text-ink">{item.judul}</h3>
          <p class="mt-2 text-sm text-muted">{item.detail}</p>
        </div>
      ))
    }
  </div>
</Section>
