---
/**
 * MasalahCards — 4 kartu ringkas (mis. gejala kerusakan yang ditangani
 * layanan maintenance).
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  items: { judul: string; detail: string }[];
}
const { items } = Astro.props;
---

<Section bg="mist" size="md" aria-label="Masalah yang kami tangani">
  <p class="label-tech text-amber-text">Sering Terjadi</p>
  <h2 class="mt-3 text-h2">Masalah yang Kami Tangani</h2>

  <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      items.map((item) => (
        <div class="rounded-md border border-ink/10 bg-white p-6">
          <h3 class="text-base font-semibold uppercase tracking-tight text-ink">{item.judul}</h3>
          <p class="mt-2 text-sm text-slate">{item.detail}</p>
        </div>
      ))
    }
  </div>
</Section>
