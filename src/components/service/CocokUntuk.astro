---
/**
 * CocokUntuk — label kiri + baris chip outline. Rata kiri, bukan rata tengah.
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<Section bg="white" size="sm" aria-label="Cocok untuk">
  <div class="flex flex-col gap-6 md:flex-row md:items-start">
    <p class="label-tech shrink-0 text-amber-text md:w-48">Cocok Untuk</p>
    <div class="flex flex-wrap gap-3">
      {
        items.map((item) => (
          <span class="label-tech rounded-md border border-ink/15 px-3 py-1.5 text-ink">
            {item}
          </span>
        ))
      }
    </div>
  </div>
</Section>
