---
/**
 * ServiceHero — dua mode, satu latar (canvas).
 * 'foto': teks di atas, foto 21:9 blok penuh di bawahnya tanpa overlay
 *         gelap (layanan fisik).
 * 'panel': teks saja, tanpa foto (software, tidak ada foto lapangan).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';

interface Props {
  mode: 'foto' | 'panel';
  judul: string;
  subjudul: string;
  ctaLabel: string;
  image?: ImageMetadata;
  alt?: string;
  flushBottom?: boolean;
}

const { mode, judul, subjudul, ctaLabel, image, alt, flushBottom = false } = Astro.props;
---

<Section bg="canvas" size="lg" flushBottom={flushBottom} aria-label="Hero layanan">
  <p class="label-tech text-muted">
    <a href="/layanan" class="hover:text-ink">Layanan</a>
    <span class="mx-2 text-subtle">/</span>
    <span class="text-ink">{judul}</span>
  </p>

  <div class="mt-6 max-w-2xl">
    <h1 class="text-h1">{judul}</h1>
    <p class="mt-5 text-muted">{subjudul}</p>
    <Button href="/kontak" size="lg" class="mt-8">{ctaLabel}</Button>
  </div>

  {
    mode === 'foto' && image && (
      <div class="relative mt-10 overflow-hidden" style="aspect-ratio: 21/9;">
        <Picture
          src={image}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          alt={alt ?? ''}
          width={1600}
          height={686}
          loading="eager"
          fetchpriority="high"
          pictureAttributes={{ class: 'block size-full' }}
          class="size-full object-cover"
        />
      </div>
    )
  }
</Section>
