---
/**
 * ServiceCta — banner ink + tombol WhatsApp. Situs static tanpa
 * backend -> deeplink WhatsApp yang menyusun pesan, bukan form submit.
 */
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { waLink } from '@/config/site';

interface Props {
  judul: string;
  ctaLabel: string;
}
const { judul, ctaLabel } = Astro.props;

const waHref = waLink(`Hello ZSN, I want to consult about ${judul}.`);
---

<Section bg="deep" size="lg" aria-label="Call to action">
  <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-h2 text-white">Ready to start {judul}?</h2>
      <p class="mt-4 text-subtle">
        Tell us your location requirements via WhatsApp, and our team will
        respond with a survey plan.
      </p>
    </div>
    <Button href={waHref} size="lg" external class="shrink-0">{ctaLabel}</Button>
  </div>
</Section>
