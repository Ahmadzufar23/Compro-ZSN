---
/**
 * TidakTermasuk — strip surface, daftar eksklusi eksplisit. Sumber
 * sengketa nomor satu di kontrak adalah asumsi yang tidak pernah
 * ditulis -> ditulis eksplisit di sini.
 */
import Section from '@/components/ui/Section.astro';

interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<Section bg="surface" size="sm" aria-label="Tidak termasuk">
  <p class="label-tech text-muted">Tidak Termasuk</p>
  <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
    {
      items.map((item) => (
        <li class="flex gap-3 text-sm text-muted">
          <span class="mt-2 size-1 shrink-0 bg-subtle" />
          {item}
        </li>
      ))
    }
  </ul>
</Section>
