---
/**
 * StatBand (service) — disamakan dengan pola home/StatBand.astro,
 * tetapi data datang dari frontmatter tiap layanan, bukan hardcoded.
 */
interface Props {
  stats: { angka: string; label: string }[];
}
const { stats } = Astro.props;
---

<section class="bg-canvas py-10" aria-label="Service Statistics">
  <div class="container-content">
    <dl class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4">
      {
        stats.map(({ angka, label }) => (
          <div class="min-w-0 border-l border-hairline pl-4">
            <dt class="font-display text-3xl font-bold text-ink break-words">{angka}</dt>
            <dd class="label-tech mt-1 text-subtle">{label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
