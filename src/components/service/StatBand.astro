---
/**
 * StatBand (service) — dipakai ulang dari pola home/StatBand.astro,
 * tetapi data datang dari frontmatter tiap layanan, bukan hardcoded.
 */
interface Props {
  stats: { angka: string; label: string }[];
}
const { stats } = Astro.props;
---

<section class="on-dark bg-graphite py-10 text-slate-muted" aria-label="Statistik layanan">
  <div class="container-content">
    <dl class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4">
      {
        stats.map(({ angka, label }) => (
          <div class="min-w-0 border-l-2 border-steel pl-4">
            <dt class="font-display text-3xl font-bold text-yellow break-words">{angka}</dt>
            <dd class="label-tech mt-1 text-slate-muted">{label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
