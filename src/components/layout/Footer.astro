---
/**
 * Footer — SATU sumber kebenaran untuk seluruh situs.
 *
 * Link di sini nyata semua. Jangan tambahkan tautan dekoratif
 * bergaya sci-fi (Terminal Access, API Docs, Security Protocols)
 * seperti yang sempat muncul di draf desain.
 */
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/config/site';
import { getLangFromUrl, useTranslations, defaultLang } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === defaultLang ? '' : `/${lang}`;

const kolom = [
  {
    judul: t('nav.services'),
    tautan: [
      { label: 'All Services', href: `${prefix}/services` },
      { label: 'Fiber Optic & FTTH', href: `${prefix}/services/fiber-optic` },
      { label: 'CCTV & Security', href: `${prefix}/services/cctv` },
      { label: 'Network Infrastructure', href: `${prefix}/services/network` },
      { label: 'Maintenance & IT Support', href: `${prefix}/services/maintenance` },
      { label: 'System Development', href: `${prefix}/products/software` },
    ],
  },
  {
    judul: 'Company',
    tautan: [
      { label: t('nav.about'), href: `${prefix}/about` },
      ...(site.halamanAktif.project ? [{ label: t('nav.portfolio'), href: `${prefix}/portfolio` }] : []),
      ...(site.halamanAktif.tim ? [{ label: 'Team', href: `${prefix}/team` }] : []),
    ],
  },
  {
    judul: t('footer.contact'),
    tautan: [
      { label: 'Contact Us', href: `${prefix}/contact` },
      { label: 'Request Survey', href: `${prefix}/contact#survey` },
    ],
  },
];

const tahun = new Date().getFullYear();
---

<footer class="on-dark border-t border-hairline bg-deep">
  <div class="container-content grid gap-12 py-16 md:grid-cols-[1.4fr_repeat(3,1fr)] md:py-20">
    <div>
      <a href={prefix || '/'} aria-label="ZSN, Beranda" class="flex min-h-11 w-fit items-center">
        <Logo variant="light" height={40} />
      </a>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-subtle">
        {lang === 'id' ? 'PT Zufar Solusi Nawasena, infrastruktur jaringan, keamanan, dan pengembangan sistem untuk bisnis di seluruh Indonesia.' : 'PT Zufar Solusi Nawasena, network infrastructure, security, and system development for businesses across Indonesia.'}
      </p>
      <address class="mt-4 max-w-xs text-sm not-italic leading-relaxed text-subtle">
        {site.alamat.jalan}, {site.alamat.kota}<br />
        <a
          href={site.maps.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center text-sm text-subtle underline decoration-subtle/40 underline-offset-2 transition-colors hover:text-white"
        >
          Open in Google Maps
        </a>
      </address>
    </div>

    {kolom.map(({ judul, tautan }) => (
      <nav aria-label={judul}>
        <p class="label-tech text-yellow">{judul}</p>
        <ul class="mt-4 flex flex-col">
          {tautan.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="flex min-h-11 items-center text-sm text-subtle transition-colors hover:text-white"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="border-t border-hairline/20">
    <div class="container-content py-6">
      <p class="label-tech text-subtle">
        © {tahun} PT Zufar Solusi Nawasena
      </p>
    </div>
  </div>
</footer>
