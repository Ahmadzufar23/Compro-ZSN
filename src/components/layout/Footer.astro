---
/**
 * Footer — SATU sumber kebenaran untuk seluruh situs.
 *
 * Link di sini nyata semua. Jangan tambahkan tautan dekoratif
 * bergaya sci-fi (Terminal Access, API Docs, Security Protocols)
 * seperti yang sempat muncul di draf desain.
 */
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/config/site';

const kolom = [
  {
    judul: 'Services',
    tautan: [
      { label: 'All Services', href: '/services' },
      { label: 'Fiber Optic & FTTH', href: '/services/fiber-optic' },
      { label: 'CCTV & Security', href: '/services/cctv' },
      { label: 'Network Infrastructure', href: '/services/network' },
      { label: 'Maintenance & IT Support', href: '/services/maintenance' },
      { label: 'System Development', href: '/products/software' },
    ],
  },
  {
    judul: 'Company',
    tautan: [
      { label: 'About', href: '/about' },
      ...(site.halamanAktif.project ? [{ label: 'Portfolio', href: '/portfolio' }] : []),
      ...(site.halamanAktif.tim ? [{ label: 'Team', href: '/team' }] : []),
    ],
  },
  {
    judul: 'Contact',
    tautan: [
      { label: 'Contact Us', href: '/contact' },
      { label: 'Request Survey', href: '/contact#survey' },
    ],
  },
];

const tahun = new Date().getFullYear();
---

<footer class="on-dark border-t border-hairline bg-deep">
  <div class="container-content grid gap-12 py-16 md:grid-cols-[1.4fr_repeat(3,1fr)] md:py-20">
    <div>
      <a href="/" aria-label="ZSN, Beranda" class="flex min-h-11 w-fit items-center">
        <Logo variant="light" height={40} />
      </a>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-subtle">
        PT Zufar Solusi Nawasena, network infrastructure, security, and
        system development for businesses across Indonesia.
      </p>
      <address class="mt-4 max-w-xs text-sm not-italic leading-relaxed text-subtle">
        {site.alamat.jalan}, {site.alamat.kota}<br />
        <a
          href={site.maps.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center text-sm text-subtle underline decoration-subtle/40 underline-offset-2 transition-colors hover:text-white"
        >
          Open in Google Maps
        </a>
      </address>
    </div>

    {kolom.map(({ judul, tautan }) => (
      <nav aria-label={judul}>
        <p class="label-tech text-yellow">{judul}</p>
        <ul class="mt-4 flex flex-col">
          {tautan.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="flex min-h-11 items-center text-sm text-subtle transition-colors hover:text-white"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="border-t border-hairline/20">
    <div class="container-content py-6">
      <p class="label-tech text-subtle">
        © {tahun} PT Zufar Solusi Nawasena
      </p>
    </div>
  </div>
</footer>
