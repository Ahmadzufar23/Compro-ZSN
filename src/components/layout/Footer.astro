---
/**
 * Footer — SATU sumber kebenaran untuk seluruh situs.
 *
 * Link di sini nyata semua. Jangan tambahkan tautan dekoratif
 * bergaya sci-fi (Terminal Access, API Docs, Security Protocols)
 * seperti yang sempat muncul di draf desain.
 */
import Logo from '@/components/ui/Logo.astro';

const kolom = [
  {
    judul: 'Layanan',
    tautan: [
      { label: 'Semua Layanan', href: '/layanan' },
      { label: 'Fiber Optic & FTTH', href: '/layanan/fiber-optic' },
      { label: 'CCTV & Security', href: '/layanan/cctv' },
      { label: 'Network Infrastructure', href: '/layanan/network' },
      { label: 'Maintenance & IT Support', href: '/layanan/maintenance' },
      { label: 'Pengembangan Sistem', href: '/layanan/software' },
    ],
  },
  {
    judul: 'Perusahaan',
    tautan: [
      { label: 'Tentang', href: '/tentang' },
      { label: 'Project', href: '/project' },
      { label: 'Tim', href: '/tim' },
    ],
  },
  {
    judul: 'Kontak',
    tautan: [
      { label: 'Hubungi Kami', href: '/kontak' },
      { label: 'Minta Survei', href: '/kontak#survei' },
    ],
  },
];

const tahun = new Date().getFullYear();
---

<footer class="on-dark blueprint bg-ink">
  <div class="container-content grid gap-12 py-16 md:grid-cols-[1.4fr_repeat(3,1fr)] md:py-20">
    <div>
      <a href="/" aria-label="ZSN, Beranda" class="flex min-h-11 w-fit items-center">
        <Logo variant="light" height={40} />
      </a>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-slate-muted">
        PT Zufar Solusi Nawasena, infrastruktur jaringan, keamanan, dan
        pengembangan sistem untuk bisnis di Jabodetabek.
      </p>
    </div>

    {kolom.map(({ judul, tautan }) => (
      <nav aria-label={judul}>
        <p class="label-tech text-yellow">{judul}</p>
        <ul class="mt-4 flex flex-col">
          {tautan.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="flex min-h-11 items-center text-sm text-slate-muted transition-colors hover:text-white"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="border-t border-steel">
    <div class="container-content flex flex-col gap-2 py-6 md:flex-row md:items-center md:justify-between">
      <p class="label-tech text-slate-muted">
        © {tahun} PT Zufar Solusi Nawasena
      </p>
      {/* TODO fase 5: isi setelah data legalitas tersedia. NPWP sengaja
          tidak ditampilkan di sini — lihat CLAUDE.md bagian "Klaim yang
          DILARANG muncul di konten". */}
      <p class="label-tech text-slate-muted">
        NIB (menunggu data)
      </p>
    </div>
  </div>
</footer>
