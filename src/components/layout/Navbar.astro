---
import { Icon } from 'astro-icon/components';
import ZMark from '@/components/ui/ZMark.astro';
import Button from '@/components/ui/Button.astro';
import { navLinks } from '@/config/nav';
import { waLink } from '@/config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const survei = waLink('Halo ZSN, saya ingin meminta survei lokasi.');
---

<header
  class="nav-shell fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-300"
  data-nav
>
  <div class="container-content flex h-18 items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-3" aria-label="ZSN, kembali ke beranda">
      <span class="transition-transform duration-700 group-hover:rotate-[360deg]">
        <ZMark size={36} ring />
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-display text-[1.35rem] font-extrabold tracking-tight text-snow" style="font-stretch:125%">ZSN</span>
        <span class="label-tech mt-1 hidden text-[0.55rem] text-fog sm:block">Technology Solution</span>
      </span>
    </a>

    <nav aria-label="Navigasi utama" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          navLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={[
                  'relative inline-flex min-h-11 items-center px-4 text-sm font-medium transition-colors',
                  isActive(l.href) ? 'text-snow' : 'text-mist hover:text-snow',
                ]}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
                {isActive(l.href) && (
                  <span class="absolute inset-x-4 bottom-1.5 h-0.5 bg-volt" aria-hidden="true" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <span class="hidden min-[380px]:block"><Button href={survei} external icon="lucide:zap">Minta Survei</Button></span>

      <details class="nav-mobile lg:hidden">
        <summary
          class="flex size-12 items-center justify-center text-snow ring-1 ring-inset ring-line-strong"
          aria-label="Buka menu"
        >
          <Icon name="lucide:menu" class="icon-open size-5" />
          <Icon name="lucide:x" class="icon-close size-5" />
        </summary>
        <div class="fixed inset-x-0 top-18 bottom-0 overflow-y-auto border-t border-line bg-ink/98 backdrop-blur-xl">
          <nav aria-label="Navigasi mobile" class="container-content py-8">
            <ul class="divide-y divide-line border-y border-line">
              {
                navLinks.map((l, i) => (
                  <li>
                    <a
                      href={l.href}
                      class="flex min-h-16 items-center justify-between gap-4 py-4 font-display text-2xl font-extrabold text-snow"
                      style="font-stretch:115%"
                    >
                      <span class="flex items-baseline gap-4">
                        <span class="label-tech text-volt">0{i + 1}</span>
                        {l.label}
                      </span>
                      <Icon name="lucide:arrow-up-right" class="size-5 text-fog" />
                    </a>
                  </li>
                ))
              }
            </ul>
            <Button href={survei} external size="lg" class="mt-8 w-full" icon="lucide:zap">
              Minta Survei Gratis
            </Button>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-shell {
    border-bottom: 1px solid transparent;
  }
  :global(.nav-scrolled) .nav-shell,
  .nav-shell:has(details[open]) {
    background: rgb(10 12 15 / 0.82);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--color-line);
  }
  .nav-mobile .icon-close { display: none; }
  .nav-mobile[open] .icon-close { display: block; }
  .nav-mobile[open] .icon-open { display: none; }
</style>

<script>
  const onScroll = () =>
    document.documentElement.classList.toggle('nav-scrolled', window.scrollY > 24);
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', () => {
    onScroll();
    document.querySelectorAll<HTMLDetailsElement>('.nav-mobile').forEach((d) => (d.open = false));
  });
</script>
