---
/**
 * Navbar — SATU sumber kebenaran untuk seluruh situs.
 *
 * Setiap halaman memakai komponen ini. Tidak ada navbar lain di mana pun.
 * Ini yang membuat inkonsistensi nama merek dan menu menjadi mustahil
 * secara struktural.
 *
 * Menu mobile memakai <details>/<summary> — 0 KB JavaScript.
 *
 * Navigasi hibrida: di beranda, menu bergulir ke anchor seksi
 * (#layanan dst). Di halaman lain, menu kembali ke beranda lalu
 * bergulir (/#layanan dst) — halaman penuh tetap ada dan tetap
 * terindeks, menu hanya jadi jalan pintas dari beranda.
 *
 * State aktif TIDAK memakai scroll-spy JavaScript. Di beranda,
 * underline aktif sengaja tidak pernah muncul (tidak ada cara statis
 * mengetahui seksi mana yang sedang dilihat). Underline hanya muncul
 * di halaman terpisah, dicocokkan lewat prefix path.
 */
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/config/site';

const menu = [
  { label: 'About', id: 'about', page: '/about' },
  { label: 'Services', id: 'services', page: '/services' },
  { label: 'Products', id: 'products', page: '/products' },
  { label: 'Portfolio', id: 'portfolio', page: '/portfolio' },
];

const path = Astro.url.pathname;
const isHome = path === '/';
const hrefFor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
const isActive = (page: string) => !isHome && path.startsWith(page);
---

<header class="sticky top-0 z-50 border-b border-hairline bg-white/80 backdrop-blur-md">
  <nav
    class="container-content flex h-16 items-center justify-between gap-6"
    aria-label="Navigasi utama"
  >
    <a href="/" aria-label="ZSN, Beranda" class="flex min-h-11 items-center">
      <Logo variant="dark" />
    </a>

    {/* Desktop */}
    <ul class="hidden items-center gap-5 lg:flex">
      {menu.map(({ label, id, page }) => (
        <li>
          <a
            href={hrefFor(id)}
            aria-current={isActive(page) ? 'page' : undefined}
            class:list={[
              'relative flex min-h-11 items-center px-2.5 text-sm font-medium text-muted transition-colors hover:text-ink',
              isActive(page) &&
                'text-ink after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:bg-yellow',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="/contact"
      class="hidden shrink-0 rounded-xl bg-yellow px-6 py-2.5 text-sm font-bold text-ink shadow-md transition-all hover:-translate-y-0.5 hover:shadow-lg lg:inline-block"
    >
      Free Consultation
    </a>

    {/* Mobile — tanpa JavaScript */}
    <details class="group lg:hidden [&_summary::-webkit-details-marker]:hidden">
      <summary
        class="flex size-11 cursor-pointer list-none items-center justify-center text-ink"
        aria-label="Buka menu"
      >
        <svg
          class="size-6 group-open:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
        <svg
          class="hidden size-6 group-open:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </summary>

      <div
        class="absolute inset-x-0 top-16 border-b border-hairline bg-canvas px-5 pb-6 pt-2 shadow-lg"
      >
        <ul class="flex flex-col">
          {menu.map(({ label, id, page }) => (
            <li>
              <a
                href={hrefFor(id)}
                aria-current={isActive(page) ? 'page' : undefined}
                class:list={[
                  'block border-b border-hairline py-4 text-sm font-medium text-muted',
                  isActive(page) && 'border-l-2 border-l-yellow pl-3 text-ink',
                ]}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/contact"
          class="mt-5 block rounded-xl bg-yellow py-3.5 text-center text-sm font-bold text-ink shadow-md"
        >
          Free Consultation
        </a>
      </div>
    </details>
  </nav>
</header>
