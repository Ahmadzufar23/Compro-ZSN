---
/**
 * Navbar — SATU sumber kebenaran untuk seluruh situs.
 *
 * Setiap halaman memakai komponen ini. Tidak ada navbar lain di mana pun.
 * Ini yang membuat inkonsistensi nama merek dan menu menjadi mustahil
 * secara struktural.
 *
 * Menu mobile memakai <details>/<summary> — 0 KB JavaScript.
 */
const menu = [
  { label: 'Layanan', href: '/layanan' },
  { label: 'Software', href: '/layanan/software' },
  { label: 'Project', href: '/project' },
  { label: 'Tim', href: '/tim' },
  { label: 'Tentang', href: '/tentang' },
  { label: 'Kontak', href: '/kontak' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="on-dark sticky top-0 z-50 border-b border-steel bg-ink">
  <nav
    class="container-content flex h-18 items-center justify-between gap-6"
    aria-label="Navigasi utama"
  >
    <a
      href="/"
      class="font-display text-2xl font-bold tracking-tight text-white"
      aria-label="ZSN — Beranda"
    >
      ZSN
    </a>

    {/* Desktop */}
    <ul class="hidden items-center gap-7 lg:flex">
      {menu.map(({ label, href }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'label-tech relative py-2 text-white/80 transition-colors hover:text-white',
              isActive(href) &&
                'text-white after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:bg-yellow',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="/kontak"
      class="label-tech hidden shrink-0 rounded-md bg-yellow px-5 py-3 text-ink transition-colors hover:bg-yellow-hover lg:inline-block"
    >
      Hubungi Kami
    </a>

    {/* Mobile — tanpa JavaScript */}
    <details class="group lg:hidden [&_summary::-webkit-details-marker]:hidden">
      <summary
        class="flex size-11 cursor-pointer list-none items-center justify-center text-white"
        aria-label="Buka menu"
      >
        <svg
          class="size-6 group-open:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
        <svg
          class="hidden size-6 group-open:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </summary>

      <div
        class="absolute inset-x-0 top-18 border-b border-steel bg-ink px-5 pb-6 pt-2"
      >
        <ul class="flex flex-col">
          {menu.map(({ label, href }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'label-tech block border-b border-steel/60 py-4 text-white/80',
                  isActive(href) && 'text-yellow',
                ]}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/kontak"
          class="label-tech mt-5 block rounded-md bg-yellow py-4 text-center text-ink"
        >
          Hubungi Kami
        </a>
      </div>
    </details>
  </nav>
</header>
