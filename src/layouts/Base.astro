---
import '@/styles/global.css';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import { site } from '@/config/site';
import { ClientRouter } from 'astro:transitions';
/* Preload font judul (Archivo, subset latin) supaya LCP hero tidak menunggu font */
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage = '/og-default.jpg', noindex = false } = Astro.props;

/* Selama domain asli belum aktif, semua halaman noindex. */
const shouldNoindex = !site.isProduction || noindex;

const judulPenuh = `${title} · ZSN`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.namaLegal,
  alternateName: 'ZSN Technology Solution',
  description:
    'Kontraktor infrastruktur jaringan dan pengembang sistem digital: fiber optik FTTH, CCTV, jaringan perusahaan, pemeliharaan, dan perangkat lunak.',
  url: Astro.site?.toString(),
  areaServed: 'Indonesia',
  telephone: `+${site.whatsapp}`,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.alamat.jalan,
    addressLocality: site.alamat.kota,
    addressRegion: site.alamat.provinsi,
    postalCode: site.alamat.kodePos,
    addressCountry: 'ID',
  },
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{judulPenuh}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {shouldNoindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZSN" />
    <meta property="og:title" content={judulPenuh} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0A0C0F" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#konten"
      class="label-tech sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-volt focus:px-4 focus:py-3 focus:text-ink"
    >
      Lompat ke konten
    </a>

    <Navbar />

    <main id="konten" class="flex-1">
      <slot />
    </main>

    <Footer />

    <script>
      let io: IntersectionObserver | undefined;
      function reveal() {
        document.documentElement.classList.add('js');
        io?.disconnect();
        io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io!.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        document.querySelectorAll('[data-reveal]:not(.is-in)').forEach((el) => io!.observe(el));
      }
      document.addEventListener('astro:page-load', reveal);
    </script>
  </body>
</html>
